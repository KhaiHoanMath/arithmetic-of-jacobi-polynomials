module

public import ArithmeticOfJacobiPolynomials.Algebra.ComplexRealization
import all ArithmeticOfJacobiPolynomials.Algebra.ComplexRealization

/-!
# The complex-points functor and the Betti functor

`ArithmeticOfJacobiPolynomials.ComplexRealization.space X` is the set of complex points of a scheme
`X` over `ℂ`
with the analytic topology generated by the sets where a regular function on an open subscheme
takes values in a complex open set. This file proves that **every morphism of `ℂ`-schemes induces a
continuous map** of these spaces (no continuity hypothesis): the inverse image of a subbasic set
`{p | s(p) ∈ W}`, `s ∈ Γ(U, ⊤)`, under `p ↦ p ≫ f` is the subbasic set of the open subscheme
`f⁻¹ U` and the regular function `(f ∣_ U)^* s`, using `morphismRestrict`
(`isPullback_morphismRestrict`). Consequently

* `ArithmeticOfJacobiPolynomials.ComplexRealization.realization : Over (Spec ℂ) ⥤ TopCat` is a
functor
  (identity and composition hold by `Category.comp_id`/`Category.assoc` since points are
  morphisms and the action is post-composition);
* `bettiFunctor n : Over (Spec ℂ) ⥤ ModuleCat ℚ` is the composite with Mathlib's singular
  homology functor `Hₙ(−, ℚ)`, `bettiFunctor_obj` identifies its value with
  `homology X n`;
* isomorphisms of `ℂ`-schemes (`Over.isoMk`) act by linear isomorphisms of the Betti spaces
  (`bettiLinearEquiv`), compatibly with composition and identities.

Nothing is assumed about any complex structure, polarization or Hodge structure.
-/

public noncomputable section

open CategoryTheory AlgebraicGeometry CategoryTheory.MonoidalCategory

namespace ArithmeticOfJacobiPolynomials.ComplexRealization

variable {X Y Z : Over (Spec (CommRingCat.of ℂ))}

/-- The map on complex points induced by a morphism of `ℂ`-schemes: post-composition. -/
def pointMap (f : X ⟶ Y) (p : Points X) : Points Y := p ≫ f

@[simp] theorem pointMap_id (p : Points X) : pointMap (𝟙 X) p = p := Category.comp_id p

theorem pointMap_comp (f : X ⟶ Y) (g : Y ⟶ Z) (p : Points X) :
    pointMap (f ≫ g) p = pointMap g (pointMap f p) := (Category.assoc _ _ _).symm

/-- Evaluation commutes with composition: `s(q ≫ g) = (g^* s)(q)`. -/
theorem evaluate_comp {U V : Scheme} (q : Spec (CommRingCat.of ℂ) ⟶ U) (g : U ⟶ V)
    (s : Γ(V, ⊤)) : evaluate (q ≫ g) s = evaluate q (g.appTop.hom s) := by
  unfold evaluate
  rfl

/-- The inverse image of a subbasic analytic set under a morphism is the subbasic analytic set of
the pulled-back open subscheme and regular function. -/
theorem pointMap_preimage_basicSet (f : X ⟶ Y) (U : Y.left.Opens) (s : Γ(U.toScheme, ⊤))
    (W : Set ℂ) :
    pointMap f ⁻¹' basicSet Y U s W =
      basicSet X (f.left ⁻¹ᵁ U) ((f.left ∣_ U).appTop.hom s) W := by
  ext p
  constructor
  · rintro ⟨q', hq', hW⟩
    obtain ⟨q, hq1, hq2⟩ :=
      (isPullback_morphismRestrict f.left U).exists_lift q' p.left (by simpa [pointMap] using hq')
    refine ⟨q, hq2, ?_⟩
    rw [← evaluate_comp, hq1]
    exact hW
  · rintro ⟨q, hq, hW⟩
    refine ⟨q ≫ (f.left ∣_ U), ?_, ?_⟩
    · rw [Category.assoc, morphismRestrict_ι, ← Category.assoc, hq]
      simp [pointMap]
    · rw [evaluate_comp]
      exact hW

/-- **Morphisms of `ℂ`-schemes are continuous for the analytic topology** on complex points. -/
theorem continuous_pointMap (f : X ⟶ Y) :
    @Continuous (Points X) (Points Y) (analyticTopology X) (analyticTopology Y) (pointMap f) := by
  rw [continuous_generateFrom_iff]
  rintro _ ⟨U, s, W, hW, rfl⟩
  rw [pointMap_preimage_basicSet]
  exact basicSet_isOpen X _ _ W hW

/-- The underlying set of the analytic space `space X` is the set of complex points. -/
def spaceEquiv (X : Over (Spec (CommRingCat.of ℂ))) : (space X) ≃ Points X := Equiv.refl _

/-- The continuous map of analytic spaces of complex points induced by a morphism. -/
def spaceMap (f : X ⟶ Y) : space X ⟶ space Y :=
  @TopCat.ofHom (Points X) (Points Y) (analyticTopology X) (analyticTopology Y)
    (@ContinuousMap.mk (Points X) (Points Y) (analyticTopology X) (analyticTopology Y)
      (pointMap f) (continuous_pointMap f))

theorem spaceMap_apply (f : X ⟶ Y) (p : space X) :
    spaceEquiv Y (spaceMap f p) = pointMap f (spaceEquiv X p) := by
  unfold spaceMap spaceEquiv
  rfl

/-- The **complex-points functor** `Over (Spec ℂ) ⥤ TopCat`, `X ↦ X(ℂ)` with the analytic
topology. -/
def realization : Over (Spec (CommRingCat.of ℂ)) ⥤ TopCat where
  obj X := space X
  map f := spaceMap f
  map_id X := by
    ext p
    apply (spaceEquiv X).injective
    rw [spaceMap_apply]
    simp
  map_comp f g := by
    ext p
    apply (spaceEquiv _).injective
    rw [spaceMap_apply]
    simp only [pointMap_comp]
    unfold spaceMap spaceEquiv
    rfl

@[simp] theorem realization_obj (X : Over (Spec (CommRingCat.of ℂ))) :
    realization.obj X = space X := by
  unfold realization
  rfl

/-- The **Betti functor** `Hₙ(X(ℂ), ℚ)`: singular homology of the analytic space of complex
points. -/
def bettiFunctor (n : ℕ) : Over (Spec (CommRingCat.of ℂ)) ⥤ ModuleCat ℚ :=
  realization ⋙ (AlgebraicTopology.singularHomologyFunctor (ModuleCat ℚ) n).obj
    (ModuleCat.of ℚ ℚ)

/-- On objects the Betti functor is `homology`. -/
@[simp] theorem bettiFunctor_obj (n : ℕ) (X : Over (Spec (CommRingCat.of ℂ))) :
    (bettiFunctor n).obj X = homology X n := by
  unfold bettiFunctor homology realization
  rfl

/-- The linear map `Hₙ(X(ℂ), ℚ) → Hₙ(Y(ℂ), ℚ)` induced by a morphism. -/
def bettiMap (n : ℕ) (f : X ⟶ Y) : homology X n ⟶ homology Y n := (bettiFunctor n).map f

theorem bettiMap_id (n : ℕ) : bettiMap n (𝟙 X) = 𝟙 _ := (bettiFunctor n).map_id X

theorem bettiMap_comp (n : ℕ) (f : X ⟶ Y) (g : Y ⟶ Z) :
    bettiMap n (f ≫ g) = bettiMap n f ≫ bettiMap n g := (bettiFunctor n).map_comp f g

/-- An isomorphism of `ℂ`-schemes induces a linear isomorphism of Betti spaces. -/
def bettiLinearEquiv (n : ℕ) (e : X ≅ Y) : homology X n ≃ₗ[ℚ] homology Y n :=
  ((bettiFunctor n).mapIso e).toLinearEquiv

theorem bettiLinearEquiv_apply (n : ℕ) (e : X ≅ Y) (x : homology X n) :
    bettiLinearEquiv n e x = (bettiMap n e.hom).hom x := by
  unfold bettiLinearEquiv bettiMap
  rfl

@[simp] theorem bettiLinearEquiv_refl (n : ℕ) (x : homology X n) :
    bettiLinearEquiv n (Iso.refl X) x = x := by
  simp [bettiLinearEquiv_apply, bettiMap_id]

theorem bettiLinearEquiv_trans (n : ℕ) (e : X ≅ Y) (e' : Y ≅ Z) (x : homology X n) :
    bettiLinearEquiv n (e ≪≫ e') x = bettiLinearEquiv n e' (bettiLinearEquiv n e x) := by
  simp [bettiLinearEquiv_apply, bettiMap_comp]

/-- The first Betti space map induced by a morphism. -/
abbrev bettiOneMap (f : X ⟶ Y) : bettiOne X →ₗ[ℚ] bettiOne Y := (bettiMap 1 f).hom

theorem bettiOneMap_id (x : bettiOne X) : bettiOneMap (𝟙 X) x = x := by
  simp [bettiOneMap, bettiMap_id]

theorem bettiOneMap_comp (f : X ⟶ Y) (g : Y ⟶ Z) (x : bettiOne X) :
    bettiOneMap (f ≫ g) x = bettiOneMap g (bettiOneMap f x) := by
  simp [bettiOneMap, bettiMap_comp]

end ArithmeticOfJacobiPolynomials.ComplexRealization
