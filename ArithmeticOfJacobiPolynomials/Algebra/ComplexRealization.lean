/-!
# Complex points and their singular homology

The topology on complex points is generated by the inverse images of complex open sets
under regular functions on open subschemes. Thus the Betti vector space below is the
singular homology of the complex points.
This file does not assert the existence of a Hodge structure or a polarization.
-/

public noncomputable section

open CategoryTheory AlgebraicGeometry CategoryTheory.MonoidalCategory

namespace ArithmeticOfJacobiPolynomials.ComplexRealization

/-- The complex points of a scheme over the complex numbers. -/
abbrev Points (X : Over (Spec (CommRingCat.of ℂ))) : Type :=
  Over.mk (𝟙 (Spec (CommRingCat.of ℂ))) ⟶ X

/-- Evaluation of a regular function at a complex point of an open subscheme. -/
def evaluate {U : Scheme} (q : Spec (CommRingCat.of ℂ) ⟶ U) (s : Γ(U, ⊤)) : ℂ :=
  (Scheme.ΓSpecIso (CommRingCat.of ℂ)).hom.hom (q.appTop.hom s)

/-- A subbasic analytic set: points in `U` where a regular function takes values in `W`. -/
def basicSet (X : Over (Spec (CommRingCat.of ℂ))) (U : X.left.Opens)
    (s : Γ(U.toScheme, ⊤)) (W : Set ℂ) : Set (Points X) :=
  {p | ∃ q : Spec (CommRingCat.of ℂ) ⟶ U.toScheme,
    q ≫ U.ι = p.left ∧ evaluate q s ∈ W}

/-- The analytic topology, described intrinsically using all open subschemes. -/
abbrev analyticTopology (X : Over (Spec (CommRingCat.of ℂ))) : TopologicalSpace (Points X) :=
  TopologicalSpace.generateFrom {S | ∃ U s W, IsOpen W ∧ S = basicSet X U s W}

/-- Regular-function subbasic sets are open in the analytic topology. -/
theorem basicSet_isOpen (X : Over (Spec (CommRingCat.of ℂ))) (U : X.left.Opens)
    (s : Γ(U.toScheme, ⊤)) (W : Set ℂ) (hW : IsOpen W) :
    @IsOpen (Points X) (analyticTopology X) (basicSet X U s W) :=
  TopologicalSpace.isOpen_generateFrom_of_mem ⟨U, s, W, hW, rfl⟩

/-- The space of complex points with its analytic topology. -/
def space (X : Over (Spec (CommRingCat.of ℂ))) : TopCat :=
  @TopCat.of (Points X) (analyticTopology X)

/-- Rational singular homology of the analytic space of complex points. -/
def homology (X : Over (Spec (CommRingCat.of ℂ))) (n : ℕ) : ModuleCat ℚ :=
  ((AlgebraicTopology.singularHomologyFunctor (ModuleCat ℚ) n).obj (ModuleCat.of ℚ ℚ)).obj
    (space X)

/-- The Betti space used for an abelian variety: `H₁(X(ℂ), ℚ)`. -/
abbrev bettiOne (X : Over (Spec (CommRingCat.of ℂ))) : Type :=
  homology X 1

end ArithmeticOfJacobiPolynomials.ComplexRealization
