/- Assembled by AxiomProver. -/
module

public import Mathlib.FieldTheory.KrullTopology
public import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
public import Mathlib.RingTheory.FiniteType
public import Mathlib.Topology.Algebra.OpenSubgroup

/-!
# Open stabilizers for the Galois action on algebra homomorphisms

Let `K` be a field, `L` an algebraic extension of `K` and `R` a finitely generated
(finite type) `K`-algebra. The group `L ≃ₐ[K] L` acts on the `L`-points `R →ₐ[K] L` of `R` by
postcomposition (`ArithmeticOfJacobiPolynomials.GaloisAlgHom.instMulAction`, `σ • φ = σ ∘ φ`).

* `ArithmeticOfJacobiPolynomials.GaloisAlgHom.fixingSubgroup_le_stabilizer`: if `s` generates `R`,
the stabilizer
  of `φ` contains the fixing subgroup of the intermediate field `K(φ(s))`.
* `ArithmeticOfJacobiPolynomials.GaloisAlgHom.isOpen_stabilizer`: every stabilizer is open for the
Krull
  topology, because `K(φ(s))` is a finite extension when `s` is finite.
* `ArithmeticOfJacobiPolynomials.GaloisAlgHom.isOpen_setOf_forall_apply_eq_of_ringHom`: the same
statement for a
  ring homomorphism `f : R →+* L` and a finite type ring homomorphism `k : K →+* R` with
  `f ∘ k = algebraMap K L` (no `K`-algebra instance on `R` is needed).
-/

public section

namespace ArithmeticOfJacobiPolynomials

namespace GaloisAlgHom

variable {K L R : Type*} [Field K] [Field L] [Algebra K L] [CommRing R] [Algebra K R]

/-- The action of `L ≃ₐ[K] L` on `R →ₐ[K] L` by postcomposition: `σ • φ = σ ∘ φ`. -/
instance instMulAction : MulAction (L ≃ₐ[K] L) (R →ₐ[K] L) where
  smul σ φ := (σ : L →ₐ[K] L).comp φ
  one_smul _ := AlgHom.ext fun _ => rfl
  mul_smul _ _ _ := AlgHom.ext fun _ => rfl

/-- `σ • φ` is the postcomposition `σ ∘ φ`. -/
theorem smul_def (σ : L ≃ₐ[K] L) (φ : R →ₐ[K] L) : σ • φ = (σ : L →ₐ[K] L).comp φ :=
  rfl

/-- `(σ • φ) x = σ (φ x)`. -/
@[simp]
theorem smul_apply (σ : L ≃ₐ[K] L) (φ : R →ₐ[K] L) (x : R) : (σ • φ) x = σ (φ x) :=
  rfl

/-- `σ` stabilizes `φ` iff it fixes every value of `φ`. -/
theorem mem_stabilizer_iff (σ : L ≃ₐ[K] L) (φ : R →ₐ[K] L) :
    σ ∈ MulAction.stabilizer (L ≃ₐ[K] L) φ ↔ ∀ x, σ (φ x) = φ x := by
  rw [MulAction.mem_stabilizer_iff]
  constructor
  · intro h x
    have hx : (σ • φ) x = φ x := by rw [h]
    exact hx
  · intro h
    exact AlgHom.ext h

/-- If `s` generates `R` as a `K`-algebra, the stabilizer of `φ` contains the fixing subgroup of
the intermediate field generated by `φ(s)`. -/
theorem fixingSubgroup_le_stabilizer {s : Set R} (hs : Algebra.adjoin K s = ⊤)
    (φ : R →ₐ[K] L) :
    (IntermediateField.adjoin K (φ '' s)).fixingSubgroup ≤
      MulAction.stabilizer (L ≃ₐ[K] L) φ := by
  intro σ hσ
  rw [MulAction.mem_stabilizer_iff]
  apply AlgHom.ext_of_adjoin_eq_top hs
  intro x hx
  have hmem : φ x ∈ IntermediateField.adjoin K (φ '' s) :=
    IntermediateField.subset_adjoin K _ ⟨x, hx, rfl⟩
  exact (IntermediateField.mem_fixingSubgroup_iff _ σ).1 hσ (φ x) hmem

/-- For an algebraic extension `L/K` and a finite type `K`-algebra `R`, the stabilizer of every
`L`-point `φ : R →ₐ[K] L` is open in the Krull topology of `L ≃ₐ[K] L`. -/
theorem isOpen_stabilizer [Algebra.IsAlgebraic K L] [Algebra.FiniteType K R]
    (φ : R →ₐ[K] L) :
    IsOpen (MulAction.stabilizer (L ≃ₐ[K] L) φ : Set (L ≃ₐ[K] L)) := by
  obtain ⟨s, hs⟩ := (Algebra.FiniteType.out : (⊤ : Subalgebra K R).FG)
  have : Finite (φ '' (s : Set R)) := (s.finite_toSet.image φ).to_subtype
  have : FiniteDimensional K (IntermediateField.adjoin K (φ '' (s : Set R))) :=
    IntermediateField.finiteDimensional_adjoin fun x _ => Algebra.IsIntegral.isIntegral x
  exact Subgroup.isOpen_mono (fixingSubgroup_le_stabilizer hs φ)
    (IntermediateField.fixingSubgroup_isOpen _)

/-- Ring-homomorphism form of `isOpen_stabilizer`: if `k : K →+* R` is of finite type and
`f : R →+* L` satisfies `f ∘ k = algebraMap K L`, the automorphisms fixing all values of `f`
form an open subset of `L ≃ₐ[K] L`. -/
theorem isOpen_setOf_forall_apply_eq_of_ringHom [Algebra.IsAlgebraic K L] {S : Type*}
    [CommRing S] (k : K →+* S) (hk : k.FiniteType) (f : S →+* L)
    (hf : f.comp k = algebraMap K L) :
    IsOpen {σ : L ≃ₐ[K] L | ∀ x, σ (f x) = f x} := by
  let : Algebra K S := k.toAlgebra
  have : Algebra.FiniteType K S := hk
  let φ : S →ₐ[K] L := { toRingHom := f, commutes' := fun r => RingHom.congr_fun hf r }
  have e : {σ : L ≃ₐ[K] L | ∀ x, σ (f x) = f x} =
      (MulAction.stabilizer (L ≃ₐ[K] L) φ : Set (L ≃ₐ[K] L)) :=
    Set.ext fun σ => (mem_stabilizer_iff σ φ).symm
  rw [e]
  exact isOpen_stabilizer φ

end GaloisAlgHom

end ArithmeticOfJacobiPolynomials
