module

public import ArithmeticOfJacobiPolynomials.Geometry.HyperellipticBranchPoints

/-!
# Charts, roots and the point at infinity of the hyperelliptic model: the algebraic inputs of the
branch-point classes

Let `k` be a field and `f ∈ k[x]` separable, `X = projectiveModel f`. This is the elementary
half of `ArithmeticOfJacobiPolynomials.Geometry.HyperellipticBranchTorsion`,
where all
divisor theory is done with Stacks' effective Cartier divisors. It contains:

* the coordinates `x`, `y` on the finite chart and `x' = 1/x`, `w = y/x^{g+1}` on the chart at
  infinity, and the identities between them on the overlap (`overlap_coord_identity`,
  `overlap_w_identity`);
* the roots `BranchRoot f` of `f` in `k`, and the divisor `∑_c P_c` (`branchSumIdeal`) whose ideal
  on the finite chart is `(y)` for `f` split (`branchSumIdeal_ideal_chartOpen`);
* in odd degree the branch point `P_∞ = (x', w) = (0, 0)` of the chart at infinity
  (`infinityPoint`, `infinityIdeal`), with `2 P_∞` generated by `x'` on the chart at infinity
  (`infinityIdeal_mul_self_ideal_chartOpenAtInfinity`) and `P_∞` by `w` near `P_∞`
  (`infinityIdeal_ideal_basicOpen`).
-/

public section

namespace ArithmeticOfJacobiPolynomials

open CategoryTheory AlgebraicGeometry TopologicalSpace Opposite

universe u

namespace Hyperelliptic

open _root_.Polynomial renaming X → polyX

open _root_.Polynomial Divisors
open scoped LaurentPolynomial

variable {k : Type u} [Field k] {f : k[X]}

/-! ### Coordinates on the charts -/

variable (f) in
/-- The polynomial function `p(x)` on the finite chart `D₊(Z)`. -/
@[expose] noncomputable def finiteCoord (p : k[X]) : Γ(projectiveModel f, chartOpen f) :=
  (sectionsEquivFinite f).symm (AdjoinRoot.of (polyX ^ 2 - C f) p)

variable (f) in
/-- The coordinate `y` on the finite chart `D₊(Z)`. -/
@[expose] noncomputable def finiteYCoord : Γ(projectiveModel f, chartOpen f) :=
  (sectionsEquivFinite f).symm (AdjoinRoot.root (polyX ^ 2 - C f))

variable (f) in
/-- The polynomial function `p(x')`, `x' = 1/x`, on the chart at infinity `D₊(X)`. -/
@[expose] noncomputable def infiniteCoord (p : k[X]) :
    Γ(projectiveModel f, chartOpenAtInfinity f) :=
  (sectionsEquivInfinite f).symm (AdjoinRoot.of (polyX ^ 2 - C (reflect (2 * genus f + 2) f)) p)

variable (f) in
/-- The coordinate `w = y/x^{g+1}` on the chart at infinity `D₊(X)`. -/
@[expose] noncomputable def infiniteWCoord : Γ(projectiveModel f, chartOpenAtInfinity f) :=
  (sectionsEquivInfinite f).symm (AdjoinRoot.root (polyX ^ 2 - C (reflect (2 * genus f + 2) f)))

theorem sectionsEquivFinite_finiteCoord (p : k[X]) :
    sectionsEquivFinite f (finiteCoord f p) = AdjoinRoot.of (polyX ^ 2 - C f) p := by
  rw [finiteCoord, RingEquiv.apply_symm_apply]

theorem sectionsEquivFinite_finiteYCoord :
    sectionsEquivFinite f (finiteYCoord f) = AdjoinRoot.root (polyX ^ 2 - C f) := by
  rw [finiteYCoord, RingEquiv.apply_symm_apply]

theorem sectionsEquivInfinite_infiniteCoord (p : k[X]) :
    sectionsEquivInfinite f (infiniteCoord f p) =
      AdjoinRoot.of (polyX ^ 2 - C (reflect (2 * genus f + 2) f)) p := by
  rw [infiniteCoord, RingEquiv.apply_symm_apply]

theorem sectionsEquivInfinite_infiniteWCoord :
    sectionsEquivInfinite f (infiniteWCoord f) =
      AdjoinRoot.root (polyX ^ 2 - C (reflect (2 * genus f + 2) f)) := by
  rw [infiniteWCoord, RingEquiv.apply_symm_apply]

theorem infiniteCoord_mul (p q : k[X]) :
    infiniteCoord f (p * q) = infiniteCoord f p * infiniteCoord f q := by
  apply (sectionsEquivInfinite f).injective
  rw [map_mul, sectionsEquivInfinite_infiniteCoord, sectionsEquivInfinite_infiniteCoord,
    sectionsEquivInfinite_infiniteCoord, map_mul]

/-- The chart at infinity as an affine open. -/
noncomputable abbrev chartAffineOpenAtInfinity (f : k[X]) : (projectiveModel f).affineOpens :=
  ⟨chartOpenAtInfinity f, isAffineOpen_opensRange (affineChartAtInfinity f)⟩

theorem mem_chartOpenAtInfinity_of_not_mem {x : projectiveModel f} (hx : x ∉ chartOpen f) :
    x ∈ chartOpenAtInfinity f := by
  have h : x ∈ chartOpen f ⊔ chartOpenAtInfinity f := by
    rw [chartOpen_sup_chartOpenAtInfinity' f]
    trivial
  exact (Opens.mem_sup.mp h).resolve_left hx

/-! ### Identities on the overlap `x ≠ 0, ∞` -/

/-- On the overlap, `(x - c) · x' = 1 - c x'`. -/
theorem overlap_coord_identity (c : k) :
    (projectiveModel f).presheaf.map
        (homOfLE (inf_le_left : chartOpen f ⊓ chartOpenAtInfinity f ≤ chartOpen f)).op
          (finiteCoord f (polyX - C c)) *
      (projectiveModel f).presheaf.map
        (homOfLE (inf_le_right : chartOpen f ⊓ chartOpenAtInfinity f ≤
          chartOpenAtInfinity f)).op (infiniteCoord f polyX) =
    (projectiveModel f).presheaf.map
        (homOfLE (inf_le_right : chartOpen f ⊓ chartOpenAtInfinity f ≤
          chartOpenAtInfinity f)).op (infiniteCoord f (1 - C c * polyX)) := by
  apply (sectionsEquivOverlap f).injective
  rw [map_mul, overlap_restrict_finite, overlap_restrict_infinite, overlap_restrict_infinite,
    sectionsEquivFinite_finiteCoord, sectionsEquivInfinite_infiniteCoord,
    sectionsEquivInfinite_infiniteCoord, cechRestrictFinite_of, cechRestrictInfinite_of,
    cechRestrictInfinite_of, ← map_mul]
  congr 1
  simp only [map_sub, map_mul, map_one, Polynomial.toLaurent_X, Polynomial.toLaurent_C,
    LaurentPolynomial.invert_T, LaurentPolynomial.invert_C]
  linear_combination (T_one_mul_T_neg_one (k := k))

/-- On the overlap, `x · x' = 1`. -/
theorem overlap_coord_inv :
    (projectiveModel f).presheaf.map
        (homOfLE (inf_le_left : chartOpen f ⊓ chartOpenAtInfinity f ≤ chartOpen f)).op
          (finiteCoord f polyX) *
      (projectiveModel f).presheaf.map
        (homOfLE (inf_le_right : chartOpen f ⊓ chartOpenAtInfinity f ≤
          chartOpenAtInfinity f)).op (infiniteCoord f polyX) = 1 := by
  apply (sectionsEquivOverlap f).injective
  rw [map_mul, map_one, overlap_restrict_finite, overlap_restrict_infinite,
    sectionsEquivFinite_finiteCoord, sectionsEquivInfinite_infiniteCoord,
    cechRestrictFinite_of, cechRestrictInfinite_of, ← map_mul, Polynomial.toLaurent_X,
    LaurentPolynomial.invert_T, T_one_mul_T_neg_one, map_one]

/-- On the overlap, `w = y · x'^{g+1}`. -/
theorem overlap_w_identity :
    (projectiveModel f).presheaf.map
        (homOfLE (inf_le_right : chartOpen f ⊓ chartOpenAtInfinity f ≤
          chartOpenAtInfinity f)).op (infiniteWCoord f) =
    (projectiveModel f).presheaf.map
        (homOfLE (inf_le_left : chartOpen f ⊓ chartOpenAtInfinity f ≤ chartOpen f)).op
          (finiteYCoord f) *
      (projectiveModel f).presheaf.map
        (homOfLE (inf_le_right : chartOpen f ⊓ chartOpenAtInfinity f ≤
          chartOpenAtInfinity f)).op (infiniteCoord f polyX) ^ (genus f + 1) := by
  apply (sectionsEquivOverlap f).injective
  have h := cechRestrictInfinite_of_mul_root f 1
  simp only [map_one, one_mul] at h
  rw [map_mul, map_pow, overlap_restrict_infinite, overlap_restrict_finite,
    overlap_restrict_infinite, sectionsEquivInfinite_infiniteWCoord,
    sectionsEquivFinite_finiteYCoord, sectionsEquivInfinite_infiniteCoord, h,
    cechRestrictFinite_root, cechRestrictInfinite_of, map_pow Polynomial.toLaurent,
    map_pow LaurentPolynomial.invert, map_pow (AdjoinRoot.of _), mul_comm]

/-- If `s = t · u` on the overlap and `t` vanishes at a point `x` of the finite chart, then `s`
vanishes at `x`. -/
theorem not_mem_basicOpen_of_overlap {s u : Γ(projectiveModel f, chartOpenAtInfinity f)}
    {t : Γ(projectiveModel f, chartOpen f)} {x : projectiveModel f} (hx : x ∈ chartOpen f)
    (h : (projectiveModel f).presheaf.map
        (homOfLE (inf_le_right : chartOpen f ⊓ chartOpenAtInfinity f ≤
          chartOpenAtInfinity f)).op s =
      (projectiveModel f).presheaf.map
        (homOfLE (inf_le_left : chartOpen f ⊓ chartOpenAtInfinity f ≤ chartOpen f)).op t *
      (projectiveModel f).presheaf.map
        (homOfLE (inf_le_right : chartOpen f ⊓ chartOpenAtInfinity f ≤
          chartOpenAtInfinity f)).op u)
    (ht : x ∉ (projectiveModel f).basicOpen t) : x ∉ (projectiveModel f).basicOpen s := by
  intro hs
  have hxinf : x ∈ chartOpenAtInfinity f := (projectiveModel f).basicOpen_le _ hs
  have hxO : x ∈ chartOpen f ⊓ chartOpenAtInfinity f := ⟨hx, hxinf⟩
  have hu := ((projectiveModel f).mem_basicOpen _ _ hxinf).mp hs
  have e := congrArg ((projectiveModel f).presheaf.germ _ _ hxO) h
  simp only [map_mul, TopCat.Presheaf.germ_res_apply] at e
  rw [e] at hu
  exact ht (((projectiveModel f).mem_basicOpen _ _ hx).mpr (isUnit_of_mul_isUnit_left hu))

/-! ### Points at infinity: `x' = 0` -/

/-- A point of the chart at infinity outside the finite chart has `x' = 0`. -/
theorem of_X_mem_of_not_mem_chartOpen
    {q : Spec (CommRingCat.of (HyperellipticCoordRing (reflect (2 * genus f + 2) f)))}
    (hq : affineChartAtInfinity f q ∉ chartOpen f) :
    AdjoinRoot.of (polyX ^ 2 - C (reflect (2 * genus f + 2) f) : k[X][X]) polyX ∈ q.asIdeal := by
  have h1 : affineChartAtInfinity f q ∉ Proj.basicOpen (grading f) (var f 1) := by
    rw [← opensRange_affineChart]
    exact hq
  rw [affineChartAtInfinity, chart, Scheme.Hom.comp_apply] at h1
  have h2 : Spec.map (chartEquiv (chartData_infinite f)).toCommRingCatIso.hom q ∉
      PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.isLocalizationElem
        (var_mem_one f (weights_zero _)) (var_mem_one f (weights_one _))) := by
    rw [← Proj.awayι_preimage_basicOpen (grading f) (var_mem_one f (weights_zero _))
      Nat.one_pos (var_mem_one f (weights_one _)) Nat.one_pos]
    exact h1
  have h3 : HomogeneousLocalization.Away.isLocalizationElem (var_mem_one f (weights_zero _))
      (var_mem_one f (weights_one _)) ∈
        (Spec.map (chartEquiv (chartData_infinite f)).toCommRingCatIso.hom q).asIdeal := by
    by_contra hcon
    exact h2 ((PrimeSpectrum.mem_basicOpen _ _).mpr hcon)
  have h4 : chartEquiv (chartData_infinite f)
      (HomogeneousLocalization.Away.isLocalizationElem (var_mem_one f (weights_zero _))
        (var_mem_one f (weights_one _))) ∈ q.asIdeal := h3
  rw [isLocalizationElem_eq_chartX_infinite, chartEquiv_chartX_infinite] at h4
  exact h4

/-- If `x' ∈ q`, then a polynomial `p(x')` with `p(0) ≠ 0` is not in `q`. -/
theorem of_not_mem_of_X_mem {R : Type*} [CommRing R] [Algebra k[X] R] {q : Ideal R}
    (hq : q.IsPrime) (hX : algebraMap k[X] R polyX ∈ q) {p : k[X]} (hp : p.eval 0 ≠ 0) :
    algebraMap k[X] R p ∉ q := by
  intro hp'
  obtain ⟨r, hr⟩ : polyX - C 0 ∣ p - C (p.eval 0) := X_sub_C_dvd_sub_C_eval
  rw [C_0, sub_zero] at hr
  have e1 : algebraMap k[X] R (C (p.eval 0)) =
      algebraMap k[X] R p - algebraMap k[X] R polyX * algebraMap k[X] R r := by
    rw [← map_mul, ← hr, map_sub, sub_sub_cancel]
  have hmem : algebraMap k[X] R (C (p.eval 0)) ∈ q := by
    rw [e1]
    exact q.sub_mem hp' (q.mul_mem_right _ hX)
  have hunit : IsUnit (algebraMap k[X] R (C (p.eval 0))) :=
    (isUnit_C.mpr (Ne.isUnit hp)).map _
  exact hq.ne_top (Ideal.eq_top_of_isUnit_mem _ hmem hunit)

/-- **The points at infinity lie in `D(p(x'))` for `p(0) ≠ 0`.** -/
theorem mem_basicOpen_infiniteCoord_of_not_mem {p : k[X]} (hp : p.eval 0 ≠ 0)
    {x : projectiveModel f} (hx₀ : x ∉ chartOpen f) :
    x ∈ (projectiveModel f).basicOpen (infiniteCoord f p) := by
  obtain ⟨q, rfl⟩ := Scheme.Hom.mem_opensRange.mp (mem_chartOpenAtInfinity_of_not_mem hx₀)
  rw [mem_basicOpen_iff_sectionsRingEquiv (affineChartAtInfinity f) rfl]
  change sectionsEquivInfinite f (infiniteCoord f p) ∉ _
  rw [sectionsEquivInfinite_infiniteCoord, ← AdjoinRoot.algebraMap_eq]
  refine of_not_mem_of_X_mem q.isPrime ?_ hp
  rw [AdjoinRoot.algebraMap_eq]
  exact of_X_mem_of_not_mem_chartOpen hx₀

/-- In even degree the points at infinity lie in `D(w)`: there `w^2 = x'^{2g+2} f(1/x')` takes
the value `lead f ≠ 0`. -/
theorem mem_basicOpen_infiniteWCoord_of_not_mem (hf0 : f ≠ 0)
    (heven : f.natDegree = 2 * genus f + 2) {x : projectiveModel f} (hx₀ : x ∉ chartOpen f) :
    x ∈ (projectiveModel f).basicOpen (infiniteWCoord f) := by
  have h0 : (reflect (2 * genus f + 2) f).eval 0 ≠ 0 := by
    rw [← coeff_zero_eq_eval_zero, coeff_reflect, revAt_le (Nat.zero_le _), Nat.sub_zero,
      ← heven]
    exact leadingCoeff_ne_zero.mpr hf0
  obtain ⟨q, rfl⟩ := Scheme.Hom.mem_opensRange.mp (mem_chartOpenAtInfinity_of_not_mem hx₀)
  rw [mem_basicOpen_iff_sectionsRingEquiv (affineChartAtInfinity f) rfl]
  change sectionsEquivInfinite f (infiniteWCoord f) ∉ _
  rw [sectionsEquivInfinite_infiniteWCoord]
  intro hw
  have hX : algebraMap k[X] (HyperellipticCoordRing (reflect (2 * genus f + 2) f)) polyX ∈
      q.asIdeal := by
    rw [AdjoinRoot.algebraMap_eq]
    exact of_X_mem_of_not_mem_chartOpen hx₀
  apply of_not_mem_of_X_mem q.isPrime hX h0
  rw [AdjoinRoot.algebraMap_eq, ← root_sq_eq_of]
  exact q.asIdeal.pow_mem_of_mem hw 2 two_pos

/-! ### The branch points `P_c` near infinity -/

variable {c : k}

theorem branchPoint_not_mem_basicOpen_finiteCoord (hc : f.eval c = 0) :
    branchPoint f c hc ∉ (projectiveModel f).basicOpen (finiteCoord f (polyX - C c)) := by
  rw [branchPoint_mem_basicOpen_iff, sectionsEquivFinite_finiteCoord, evalRootPoint_of]
  simp

theorem branchPoint_not_mem_basicOpen_finiteYCoord (hc : f.eval c = 0) :
    branchPoint f c hc ∉ (projectiveModel f).basicOpen (finiteYCoord f) := by
  rw [branchPoint_mem_basicOpen_iff, sectionsEquivFinite_finiteYCoord, evalRootPoint_root]
  exact fun h => h rfl

/-- `P_c ∉ D(1 - c x')`. -/
theorem branchPoint_not_mem_basicOpen_infiniteCoord (hc : f.eval c = 0) :
    branchPoint f c hc ∉ (projectiveModel f).basicOpen (infiniteCoord f (1 - C c * polyX)) :=
  not_mem_basicOpen_of_overlap (branchPoint_mem_chartOpen hc) (overlap_coord_identity c).symm
    (branchPoint_not_mem_basicOpen_finiteCoord hc)

/-- `P_c ∉ D(w)`. -/
theorem branchPoint_not_mem_basicOpen_infiniteWCoord (hc : f.eval c = 0) :
    branchPoint f c hc ∉ (projectiveModel f).basicOpen (infiniteWCoord f) := by
  refine not_mem_basicOpen_of_overlap (u := infiniteCoord f polyX ^ (genus f + 1))
    (branchPoint_mem_chartOpen hc) ?_
    (branchPoint_not_mem_basicOpen_finiteYCoord hc)
  rw [overlap_w_identity, map_pow]

theorem sectionsEquivFinite_mem_nonZeroDivisors (hf : f.Separable) (hdeg : 0 < f.natDegree)
    {s : Γ(projectiveModel f, chartOpen f)} (hs : sectionsEquivFinite f s ≠ 0) :
    s ∈ nonZeroDivisors Γ(projectiveModel f, chartOpen f) := by
  have := isDomain_hyperellipticCoordRing hf hdeg
  exact mem_nonZeroDivisors_of_ringEquiv (sectionsEquivFinite f) hs

/-- On the finite chart, the ideal of `2 P_c` is `(x - c)`. -/
theorem branchIdeal_mul_self_ideal_chartOpen_coord (hf : f.Separable) (hc : f.eval c = 0) :
    (branchIdeal f hc * branchIdeal f hc).ideal (chartAffineOpen f) =
      Ideal.span {finiteCoord f (polyX - C c)} := by
  rw [Scheme.IdealSheafData.ideal_mul, Pi.mul_apply, branchIdeal_ideal_chartOpen_eq_comap,
    ← Ideal.map_symm, ← Ideal.map_mul, ker_evalRootPoint_mul_self hf hc, Ideal.map_span,
    Set.image_singleton]
  rfl

theorem finiteCoord_mem_nonZeroDivisors (hf : f.Separable) (hc : f.eval c = 0) :
    finiteCoord f (polyX - C c) ∈ nonZeroDivisors Γ(projectiveModel f, chartOpen f) := by
  refine sectionsEquivFinite_mem_nonZeroDivisors hf (natDegree_pos_of_eval_eq_zero hf hc) ?_
  rw [sectionsEquivFinite_finiteCoord, ← AdjoinRoot.algebraMap_eq]
  exact fun h => X_sub_C_ne_zero c
    (injective_algebraMap_hyperellipticCoordRing f (h.trans (map_zero _).symm))

/-- Near infinity, the unit `1 - c x'` generates the ideal of `2 P_c`: on an affine open inside
`D(1 - c x')` the ideal of `2 P_c` is the unit ideal. -/
theorem branchIdeal_mul_self_ideal_eq_span_of_le_coord (hc : f.eval c = 0)
    (W : (projectiveModel f).affineOpens)
    (hW : W.1 ≤ (projectiveModel f).basicOpen (infiniteCoord f (1 - C c * polyX))) :
    (branchIdeal f hc * branchIdeal f hc).ideal W =
      Ideal.span {(projectiveModel f).presheaf.map (homOfLE (hW.trans
        ((projectiveModel f).basicOpen_le _))).op (infiniteCoord f (1 - C c * polyX))} := by
  have hPA : branchPoint f c hc ∉ (W : (projectiveModel f).Opens) := fun hP =>
    branchPoint_not_mem_basicOpen_infiniteCoord hc (hW hP)
  rw [Scheme.IdealSheafData.ideal_mul, Pi.mul_apply, pointIdeal_ideal_eq_top _ W hPA,
    Ideal.top_mul, eq_comm, Ideal.span_singleton_eq_top]
  exact isUnit_res_of_le_basicOpen _ hW

open Classical in
variable (f) in
/-- The roots of `f` in `k`; they index the finite branch points `P_c`. -/
abbrev BranchRoot : Type u := {c : k // c ∈ f.roots.toFinset}

open Classical in
theorem BranchRoot.eval_eq_zero (c : BranchRoot f) : f.eval c.1 = 0 :=
  (mem_roots'.mp (Multiset.mem_toFinset.mp c.2)).2

/-! ### `∏_c (x - c, y) = (y)` on the finite chart -/

theorem prod_X_sub_C_eq (hf : f.Separable) (hsplit : f.roots.card = f.natDegree) :
    C f.leadingCoeff * ∏ c : BranchRoot f, (polyX - C c.1) = f := by
  classical
  rw [Finset.prod_coe_sort _ (fun c : k => polyX - C c), Finset.prod_eq_multiset_prod,
    Multiset.toFinset_val, Multiset.dedup_eq_self.mpr (nodup_roots hf)]
  exact C_leadingCoeff_mul_prod_multiset_X_sub_C hsplit

theorem card_branchRoot (hf : f.Separable) (hsplit : f.roots.card = f.natDegree) :
    Fintype.card (BranchRoot f) = f.natDegree := by
  classical
  rw [Fintype.card_coe, Multiset.toFinset_card_of_nodup (nodup_roots hf), hsplit]

theorem prod_sup_le {R ι : Type*} [CommRing R] (s : Finset ι) (A : ι → Ideal R)
    (Y : Ideal R) : ∏ i ∈ s, (A i ⊔ Y) ≤ (∏ i ∈ s, A i) ⊔ Y := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    rw [Finset.prod_empty, Finset.prod_empty]
    exact le_sup_left
  | insert a s ha ih =>
    rw [Finset.prod_insert ha, Finset.prod_insert ha]
    calc (A a ⊔ Y) * ∏ i ∈ s, (A i ⊔ Y) ≤ (A a ⊔ Y) * ((∏ i ∈ s, A i) ⊔ Y) :=
          Ideal.mul_mono_right ih
      _ ≤ (A a * ∏ i ∈ s, A i) ⊔ Y := by
        rw [Ideal.mul_le]
        intro r hr t ht
        obtain ⟨r1, hr1, r2, hr2, rfl⟩ := Submodule.mem_sup.mp hr
        obtain ⟨t1, ht1, t2, ht2, rfl⟩ := Submodule.mem_sup.mp ht
        have e : (r1 + r2) * (t1 + t2) = r1 * t1 + (r1 * t2 + r2 * (t1 + t2)) := by ring
        rw [e]
        exact Ideal.add_mem _ (Ideal.mem_sup_left (Ideal.mul_mem_mul hr1 ht1))
          (Ideal.mem_sup_right (Ideal.add_mem _ (Ideal.mul_mem_left _ _ ht2)
            (Ideal.mul_mem_right _ _ hr2)))

/-- **The product of the maximal ideals `(x - c, y)` over all roots is `(y)`**, for `f`
separable and split over `k`. -/
theorem prod_ker_evalRootPoint (hf : f.Separable) (hsplit : f.roots.card = f.natDegree) :
    ∏ c : BranchRoot f, RingHom.ker (evalRootPoint f c.1 (BranchRoot.eval_eq_zero c)) =
      Ideal.span {AdjoinRoot.root (polyX ^ 2 - C f)} := by
  apply le_antisymm
  · calc ∏ c : BranchRoot f, RingHom.ker (evalRootPoint f c.1 (BranchRoot.eval_eq_zero c))
        = ∏ c : BranchRoot f, (Ideal.span {AdjoinRoot.of (polyX ^ 2 - C f) (polyX - C c.1)} ⊔
            Ideal.span {AdjoinRoot.root (polyX ^ 2 - C f)}) := by
          refine Finset.prod_congr rfl fun c _ => ?_
          rw [ker_evalRootPoint, Ideal.span_insert]
      _ ≤ (∏ c : BranchRoot f, Ideal.span {AdjoinRoot.of (polyX ^ 2 - C f) (polyX - C c.1)}) ⊔
            Ideal.span {AdjoinRoot.root (polyX ^ 2 - C f)} := prod_sup_le _ _ _
      _ ≤ Ideal.span {AdjoinRoot.root (polyX ^ 2 - C f)} := by
          refine sup_le ?_ le_rfl
          rw [Ideal.prod_span_singleton, Ideal.span_singleton_le_iff_mem,
            ← map_prod (AdjoinRoot.of (polyX ^ 2 - C f))]
          have hlead : f.leadingCoeff ≠ 0 := leadingCoeff_ne_zero.mpr hf.ne_zero
          have h : ∏ c : BranchRoot f, (polyX - C c.1) = C f.leadingCoeff⁻¹ * f := by
            calc ∏ c : BranchRoot f, (polyX - C c.1)
                = C f.leadingCoeff⁻¹ *
                    (C f.leadingCoeff * ∏ c : BranchRoot f, (polyX - C c.1)) := by
                  rw [← mul_assoc, ← C_mul, inv_mul_cancel₀ hlead, C_1, one_mul]
              _ = C f.leadingCoeff⁻¹ * f := by rw [prod_X_sub_C_eq hf hsplit]
          rw [h, map_mul, ← root_sq_eq_of]
          exact Ideal.mul_mem_left _ _
            (Ideal.pow_mem_of_mem _ (Ideal.mem_span_singleton_self _) 2 two_pos)
  · rw [Ideal.prod_eq_iInf_of_pairwise_isCoprime, Ideal.span_singleton_le_iff_mem]
    · refine (Submodule.mem_iInf _).mpr fun c => (Submodule.mem_iInf _).mpr fun _ => ?_
      rw [RingHom.mem_ker, evalRootPoint_root]
    · intro c _ c' _ hne
      change IsCoprime (RingHom.ker _) (RingHom.ker _)
      rw [Ideal.isCoprime_iff_sup_eq, Ideal.eq_top_iff_one]
      have hcc : c'.1 - c.1 ≠ 0 := sub_ne_zero.mpr fun h => hne (Subtype.ext h.symm)
      have h1 : AdjoinRoot.of (polyX ^ 2 - C f) (polyX - C c.1) ∈
          RingHom.ker (evalRootPoint f c.1 (BranchRoot.eval_eq_zero c)) := by
        rw [RingHom.mem_ker, evalRootPoint_of]
        simp
      have h2 : AdjoinRoot.of (polyX ^ 2 - C f) (polyX - C c'.1) ∈
          RingHom.ker (evalRootPoint f c'.1 (BranchRoot.eval_eq_zero c')) := by
        rw [RingHom.mem_ker, evalRootPoint_of]
        simp
      have e : AdjoinRoot.of (polyX ^ 2 - C f) (C (c'.1 - c.1)⁻¹) *
          (AdjoinRoot.of (polyX ^ 2 - C f) (polyX - C c.1) -
            AdjoinRoot.of (polyX ^ 2 - C f) (polyX - C c'.1)) = 1 := by
        rw [← map_sub, ← map_mul, ← map_one (AdjoinRoot.of (polyX ^ 2 - C f))]
        congr 1
        rw [show (polyX - C c.1 - (polyX - C c'.1) : k[X]) = C (c'.1 - c.1) by rw [C_sub]; ring,
          ← C_mul, inv_mul_cancel₀ hcc, C_1]
      have hmem := Ideal.mul_mem_left _ (AdjoinRoot.of (polyX ^ 2 - C f) (C (c'.1 - c.1)⁻¹))
        (Ideal.sub_mem _ (Ideal.mem_sup_left h1) (Ideal.mem_sup_right h2))
      rwa [e] at hmem

/-! ### The divisor `∑_c P_c` -/

variable (f) in
/-- **The divisor `∑_c P_c` of the finite branch points**: the ideal sheaf `∏_c 𝒪(-P_c)`. -/
@[expose] noncomputable def branchSumIdeal : (projectiveModel f).IdealSheafData :=
  ∏ c : BranchRoot f, branchIdeal f (BranchRoot.eval_eq_zero c)

/-- **On the finite chart, the ideal of `∑_c P_c` is `(y)`** (`f` separable and split). -/
theorem branchSumIdeal_ideal_chartOpen (hf : f.Separable) (hsplit : f.roots.card = f.natDegree) :
    (branchSumIdeal f).ideal (chartAffineOpen f) = Ideal.span {finiteYCoord f} := by
  rw [branchSumIdeal, ideal_prod]
  calc ∏ c : BranchRoot f, (branchIdeal f (BranchRoot.eval_eq_zero c)).ideal (chartAffineOpen f)
      = ∏ c : BranchRoot f, Ideal.mapHom (sectionsEquivFinite f).symm
          (RingHom.ker (evalRootPoint f c.1 (BranchRoot.eval_eq_zero c))) := by
        refine Finset.prod_congr rfl fun c _ => ?_
        rw [branchIdeal_ideal_chartOpen_eq_comap, ← Ideal.map_symm, Ideal.mapHom_apply]
    _ = Ideal.mapHom (sectionsEquivFinite f).symm
          (∏ c : BranchRoot f, RingHom.ker (evalRootPoint f c.1 (BranchRoot.eval_eq_zero c))) :=
        (map_prod _ _ _).symm
    _ = Ideal.span {finiteYCoord f} := by
        rw [prod_ker_evalRootPoint hf hsplit, Ideal.mapHom_apply, Ideal.map_span,
          Set.image_singleton]
        rfl

/-- Away from all `P_c`, the ideal of `∑_c P_c` is the unit ideal. -/
theorem branchSumIdeal_ideal_eq_top (A : (projectiveModel f).affineOpens)
    (hA : ∀ c : BranchRoot f,
      branchPoint f c.1 (BranchRoot.eval_eq_zero c) ∉ (A : (projectiveModel f).Opens)) :
    (branchSumIdeal f).ideal A = ⊤ := by
  rw [branchSumIdeal, ideal_prod, ← Ideal.one_eq_top]
  exact Finset.prod_eq_one fun c _ =>
    (pointIdeal_ideal_eq_top _ A (hA c)).trans Ideal.one_eq_top.symm

/-! ### Odd degree: the branch point `P_∞` -/

/-- In odd degree `2g + 1`, `x' = 0` is a root of `x'^{2g+2} f(1/x')`. -/
theorem eval_zero_reflect_of_odd (hodd : Odd f.natDegree) :
    (reflect (2 * genus f + 2) f).eval 0 = 0 := by
  rw [← coeff_zero_eq_eval_zero, coeff_reflect, revAt_le (Nat.zero_le _), Nat.sub_zero]
  refine coeff_eq_zero_of_natDegree_lt ?_
  obtain ⟨m, hm⟩ := hodd
  unfold genus
  omega

variable (h0 : (reflect (2 * genus f + 2) f).eval 0 = 0)

variable (f) in
/-- The prime `(x', w)` of the chart at infinity. -/
@[expose] noncomputable def infinityPrime :
    Spec (CommRingCat.of (HyperellipticCoordRing (reflect (2 * genus f + 2) f))) :=
  (⟨RingHom.ker (evalRootPoint _ 0 h0), RingHom.ker_isPrime _⟩ :
    PrimeSpectrum (HyperellipticCoordRing (reflect (2 * genus f + 2) f)))

variable (f) in
/-- **The point at infinity `P_∞ = (x', w) = (0, 0)`** of the chart at infinity (odd degree). -/
@[expose] noncomputable def infinityPoint : projectiveModel f :=
  affineChartAtInfinity f (infinityPrime f h0)

variable (f) in
/-- The ideal sheaf `𝒪(-P_∞)`. -/
noncomputable abbrev infinityIdeal : (projectiveModel f).IdealSheafData :=
  pointIdeal (infinityPoint f h0)

variable (f) in
/-- The cofactor `x'^{2g+2} f(1/x') / x'`. -/
@[expose] noncomputable def infinityCofactor : k[X] := reflect (2 * genus f + 2) f /ₘ polyX

include h0 in
theorem X_mul_infinityCofactor : polyX * infinityCofactor f = reflect (2 * genus f + 2) f := by
  have h := X_sub_C_mul_divByMonic h0
  rw [C_0, sub_zero] at h
  exact h

include h0 in
theorem eval_infinityCofactor_ne_zero (hf : f.Separable) (hdeg : 0 < f.natDegree) :
    (infinityCofactor f).eval 0 ≠ 0 := by
  have h := eval_divByMonic_ne_zero (separable_reflect_genus hf hdeg) h0
  rw [C_0, sub_zero] at h
  exact h

theorem infinityPoint_mem_basicOpen_iff (s : Γ(projectiveModel f, chartOpenAtInfinity f)) :
    infinityPoint f h0 ∈ (projectiveModel f).basicOpen s ↔
      evalRootPoint _ 0 h0 (sectionsEquivInfinite f s) ≠ 0 := by
  rw [infinityPoint, mem_basicOpen_iff_sectionsRingEquiv (affineChartAtInfinity f) rfl s]
  exact not_congr RingHom.mem_ker

theorem infinityPoint_mem_chartOpenAtInfinity : infinityPoint f h0 ∈ chartOpenAtInfinity f :=
  Scheme.Hom.mem_opensRange.mpr ⟨infinityPrime f h0, rfl⟩

/-- `P_∞` is not on the finite chart (there `x' = 1/x` is a unit). -/
theorem infinityPoint_not_mem_chartOpen : infinityPoint f h0 ∉ chartOpen f := by
  intro h
  have hinf := infinityPoint_mem_chartOpenAtInfinity h0
  have hO : infinityPoint f h0 ∈ chartOpen f ⊓ chartOpenAtInfinity f := ⟨h, hinf⟩
  have e := congrArg ((projectiveModel f).presheaf.germ _ _ hO) (overlap_coord_inv (f := f))
  simp only [map_mul, map_one, TopCat.Presheaf.germ_res_apply] at e
  have hu : IsUnit ((projectiveModel f).presheaf.germ _ _ hinf (infiniteCoord f polyX)) :=
    isUnit_of_mul_isUnit_right (by rw [e]; exact isUnit_one)
  have h3 : infinityPoint f h0 ∈ (projectiveModel f).basicOpen (infiniteCoord f polyX) :=
    ((projectiveModel f).mem_basicOpen _ _ hinf).mpr hu
  rw [infinityPoint_mem_basicOpen_iff, sectionsEquivInfinite_infiniteCoord, evalRootPoint_of,
    eval_X] at h3
  exact h3 rfl

theorem infinityIdeal_ideal_eq_comap :
    (infinityIdeal f h0).ideal (chartAffineOpenAtInfinity f) =
      Ideal.comap (sectionsEquivInfinite f) (RingHom.ker (evalRootPoint _ 0 h0)) := by
  ext s
  rw [Ideal.mem_comap, RingHom.mem_ker]
  exact (mem_pointIdeal_iff _ _ s).trans
    ((not_congr (infinityPoint_mem_basicOpen_iff h0 s)).trans not_not)

/-- **On the chart at infinity, the ideal of `P_∞` is `(x', w)`.** -/
theorem infinityIdeal_ideal_chartOpenAtInfinity :
    (infinityIdeal f h0).ideal (chartAffineOpenAtInfinity f) =
      Ideal.span {infiniteCoord f polyX, infiniteWCoord f} := by
  rw [infinityIdeal_ideal_eq_comap, ← Ideal.map_symm, ker_evalRootPoint, Ideal.map_span,
    Set.image_pair, C_0, sub_zero]
  rfl

/-- **On the chart at infinity, the ideal of `2 P_∞` is `(x')`**: `P_∞` is a branch point. -/
theorem infinityIdeal_mul_self_ideal_chartOpenAtInfinity (hf : f.Separable)
    (hdeg : 0 < f.natDegree) :
    (infinityIdeal f h0 * infinityIdeal f h0).ideal (chartAffineOpenAtInfinity f) =
      Ideal.span {infiniteCoord f polyX} := by
  rw [Scheme.IdealSheafData.ideal_mul, Pi.mul_apply, infinityIdeal_ideal_eq_comap,
    ← Ideal.map_symm, ← Ideal.map_mul,
    ker_evalRootPoint_mul_self (separable_reflect_genus hf hdeg) h0, Ideal.map_span,
    Set.image_singleton, C_0, sub_zero]
  rfl

theorem infiniteCoord_X_mem_nonZeroDivisors (hf : f.Separable) (hdeg : 0 < f.natDegree) :
    infiniteCoord f polyX ∈ nonZeroDivisors Γ(projectiveModel f, chartOpenAtInfinity f) := by
  have := isDomain_hyperellipticCoordRing_reflect hf hdeg
  refine mem_nonZeroDivisors_of_ringEquiv (sectionsEquivInfinite f) ?_
  rw [sectionsEquivInfinite_infiniteCoord, ← AdjoinRoot.algebraMap_eq]
  exact fun h => X_ne_zero
    (injective_algebraMap_hyperellipticCoordRing _ (h.trans (map_zero _).symm))

theorem infinityPoint_mem_basicOpen_cofactor (hf : f.Separable) (hdeg : 0 < f.natDegree) :
    infinityPoint f h0 ∈ (projectiveModel f).basicOpen (infiniteCoord f (infinityCofactor f)) := by
  rw [infinityPoint_mem_basicOpen_iff, sectionsEquivInfinite_infiniteCoord, evalRootPoint_of]
  exact eval_infinityCofactor_ne_zero h0 hf hdeg

theorem infinityPoint_not_mem_basicOpen_infiniteWCoord :
    infinityPoint f h0 ∉ (projectiveModel f).basicOpen (infiniteWCoord f) := by
  rw [infinityPoint_mem_basicOpen_iff, sectionsEquivInfinite_infiniteWCoord, evalRootPoint_root]
  exact fun h => h rfl

include h0 in
theorem infiniteCoord_X_mul_cofactor :
    infiniteCoord f polyX * infiniteCoord f (infinityCofactor f) = infiniteWCoord f ^ 2 := by
  apply (sectionsEquivInfinite f).injective
  rw [map_mul, map_pow, sectionsEquivInfinite_infiniteCoord, sectionsEquivInfinite_infiniteCoord,
    sectionsEquivInfinite_infiniteWCoord, ← map_mul, X_mul_infinityCofactor h0, root_sq_eq_of]

/-- **Near `P_∞`, the ideal of `P_∞` is generated by `w`**: on `D(x'^{2g+2} f(1/x')/x')`. -/
theorem infinityIdeal_ideal_basicOpen (hf : f.Separable) (hdeg : 0 < f.natDegree) :
    (infinityIdeal f h0).ideal
      ⟨(projectiveModel f).basicOpen (infiniteCoord f (infinityCofactor f)),
        (isAffineOpen_opensRange (affineChartAtInfinity f)).basicOpen _⟩ =
      Ideal.span {((projectiveModel f).presheaf.map
        (homOfLE ((projectiveModel f).basicOpen_le (infiniteCoord f (infinityCofactor f)))).op
          (infiniteWCoord f))} :=
  pointIdeal_ideal_basicOpen (chartAffineOpenAtInfinity f)
    (infinityPoint_mem_basicOpen_cofactor h0 hf hdeg)
    (infinityIdeal_ideal_chartOpenAtInfinity h0).le
    (infinityPoint_not_mem_basicOpen_infiniteWCoord h0) (infiniteCoord_X_mul_cofactor h0)

include h0 in
theorem infiniteWCoord_res_mem_nonZeroDivisors (hf : f.Separable) (hdeg : 0 < f.natDegree) :
    (projectiveModel f).presheaf.map
        (homOfLE ((projectiveModel f).basicOpen_le (infiniteCoord f (infinityCofactor f)))).op
          (infiniteWCoord f) ∈
      nonZeroDivisors
        Γ(projectiveModel f,
          (projectiveModel f).basicOpen (infiniteCoord f (infinityCofactor f))) := by
  have : IsIntegral (projectiveModel f) := isIntegral_projectiveModel hf hdeg
  have : Nonempty ((projectiveModel f).basicOpen (infiniteCoord f (infinityCofactor f))) :=
    ⟨⟨_, infinityPoint_mem_basicOpen_cofactor h0 hf hdeg⟩⟩
  have := IsIntegral.component_integral (X := projectiveModel f)
    ((projectiveModel f).basicOpen (infiniteCoord f (infinityCofactor f)))
  refine mem_nonZeroDivisors_of_ne_zero ?_
  intro hz
  have h1 := map_injective_of_isIntegral (X := projectiveModel f)
    (homOfLE ((projectiveModel f).basicOpen_le (infiniteCoord f (infinityCofactor f))))
    (hz.trans (map_zero _).symm)
  apply root_ne_zero (separable_reflect_genus hf hdeg).ne_zero
  have h2 := congrArg (sectionsEquivInfinite f) h1
  rwa [sectionsEquivInfinite_infiniteWCoord, map_zero] at h2

/-- Every point other than `P_∞` has an affine neighbourhood avoiding `P_∞`. -/
theorem exists_affineOpen_not_mem_infinity {x : projectiveModel f} (hx : x ≠ infinityPoint f h0) :
    ∃ V : (projectiveModel f).affineOpens, x ∈ (V : (projectiveModel f).Opens) ∧
      infinityPoint f h0 ∉ (V : (projectiveModel f).Opens) := by
  by_cases hx₀ : x ∈ chartOpen f
  · exact ⟨chartAffineOpen f, hx₀, infinityPoint_not_mem_chartOpen h0⟩
  · obtain ⟨q, rfl⟩ := Scheme.Hom.mem_opensRange.mp (mem_chartOpenAtInfinity_of_not_mem hx₀)
    have hne : ¬ RingHom.ker (evalRootPoint _ 0 h0) ≤ q.asIdeal := by
      intro hle
      apply hx
      have hmax := RingHom.ker_isMaximal_of_surjective (evalRootPoint _ 0 h0)
        (evalRootPoint_surjective h0)
      have heq := hmax.eq_of_le q.isPrime.ne_top hle
      change affineChartAtInfinity f q = affineChartAtInfinity f (infinityPrime f h0)
      congr 1
      exact PrimeSpectrum.ext heq.symm
    obtain ⟨a, ha, haq⟩ := IsConcreteLE.not_le_iff_exists.mp hne
    refine ⟨⟨_, (isAffineOpen_opensRange (affineChartAtInfinity f)).basicOpen
      ((sectionsEquivInfinite f).symm a)⟩, ?_, ?_⟩
    · change affineChartAtInfinity f q ∈
        (projectiveModel f).basicOpen ((sectionsEquivInfinite f).symm a)
      rw [mem_basicOpen_iff_sectionsRingEquiv (affineChartAtInfinity f) rfl]
      change (sectionsEquivInfinite f) ((sectionsEquivInfinite f).symm a) ∉ _
      rw [RingEquiv.apply_symm_apply]
      exact haq
    · change infinityPoint f h0 ∉
        (projectiveModel f).basicOpen ((sectionsEquivInfinite f).symm a)
      rw [infinityPoint_mem_basicOpen_iff, RingEquiv.apply_symm_apply, not_not]
      exact ha

/-- Away from `P_∞`, the ideal of `2 P_∞` is the unit ideal. -/
theorem infinityIdeal_mul_self_ideal_of_not_mem (W : (projectiveModel f).affineOpens)
    (hW : infinityPoint f h0 ∉ (W : (projectiveModel f).Opens)) :
    (infinityIdeal f h0 * infinityIdeal f h0).ideal W = ⊤ := by
  rw [Scheme.IdealSheafData.ideal_mul, Pi.mul_apply, pointIdeal_ideal_eq_top _ W hW, Ideal.top_mul]

/-- On the finite chart, the ideal of `2 P_∞` is the unit ideal. -/
theorem infinityIdeal_mul_self_ideal_chartOpen :
    (infinityIdeal f h0 * infinityIdeal f h0).ideal (chartAffineOpen f) = Ideal.span {1} := by
  rw [Ideal.span_singleton_one]
  exact infinityIdeal_mul_self_ideal_of_not_mem h0 _ (infinityPoint_not_mem_chartOpen h0)

