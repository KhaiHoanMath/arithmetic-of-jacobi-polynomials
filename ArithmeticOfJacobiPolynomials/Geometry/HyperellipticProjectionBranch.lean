/-!
# The finite branch points of the hyperelliptic double cover

Subsection "Hyperelliptic Jacobians" of the manuscript: *for the curve `y^2 = f(x)`, the roots of
`f` are the finite branch points of the double cover of the projective line.*

Over the finite chart `𝔸¹ = Spec k[x] ⊂ ℙ¹` the projection `toProjectiveLine f` is
`Spec B → Spec k[x]` with `B = k[x, y]/(y^2 - f(x))` (`isPullback_affineChart_toProjectiveLine`,
`ArithmeticOfJacobiPolynomials.Geometry.HyperellipticProjection`). Ramification is measured by
Mathlib's
unramified locus `Algebra.unramifiedLocus k[x] B` (the primes `q` with `B_q` formally unramified
over `k[x]`), and a point `x = c` of `𝔸¹` is a *branch point* (`IsFiniteBranchPoint f c`) if
some prime of `B` lying over `(x - c)` is not in the unramified locus.

* `mem_unramifiedLocus_iff`: if `2 ≠ 0` in `k`, a prime `q` of `B` is unramified over `k[x]` iff
  `y ∉ q`. If `y ∉ q`: `2y dy = d(f(x)) = 0` and `Ω_{B/k[x]}` is generated by `dy`, so `y`
  annihilates `Ω_{B/k[x]}` (`root_mem_annihilator`) and `q` is outside its support. If `y ∈ q`:
  the derivation `B → B/q`, `x ↦ 0`, `y ↦ 1` (`rootDerivation`, the `ε`-part of the ring map
  `B → (B/q)[ε]`, `x ↦ x mod q`, `y ↦ ε`) shows `r • dy ≠ 0` for every `r ∉ q`, so `q` lies in
  the support of `Ω_{B/k[x]}`.
* `isFiniteBranchPoint_iff`: **if `2 ≠ 0` in `k`, the point `x = c` is a branch point iff
  `f(c) = 0`.** (No separability or algebraic closedness is needed; over an algebraically closed
  field the points `x = c` are exactly the closed points of `𝔸¹`.) Above a root `c` the point
  `(c, 0)` (`x ↦ c`, `y ↦ 0`) is ramified; conversely a ramified prime over `(x - c)` contains `y`,
  hence `f(x) = y^2`, hence `f(c) = 0`.

The behaviour at infinity (branched iff `deg f` is odd) is not treated here.
-/

public section

open Polynomial renaming X → polyX

namespace ArithmeticOfJacobiPolynomials

namespace Hyperelliptic

open Polynomial

variable {k : Type*} [Field k] {f : k[X]}

theorem smul_comm_of_commRing {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M] (a b : R)
    (m : M) : a • b • m = b • a • m := by
  rw [smul_smul, mul_comm, ← smul_smul]

/-! ### Unramified at primes not containing `y` -/

variable (f) in
/-- `y dy = 0` in `Ω_{B/k[x]}` when `2 ≠ 0` (`2y dy = d(y^2) = d(f(x)) = 0`). -/
theorem root_smul_D_root (h2 : (2 : k) ≠ 0) :
    AdjoinRoot.root (polyX ^ 2 - C f : k[X][X]) •
        KaehlerDifferential.D k[X] (HyperellipticCoordRing f) (AdjoinRoot.root _) = 0 := by
  have h : AdjoinRoot.root (polyX ^ 2 - C f : k[X][X]) •
        KaehlerDifferential.D k[X] (HyperellipticCoordRing f) (AdjoinRoot.root _) +
      AdjoinRoot.root (polyX ^ 2 - C f : k[X][X]) •
        KaehlerDifferential.D k[X] (HyperellipticCoordRing f) (AdjoinRoot.root _) = 0 := by
    rw [← Derivation.leibniz, ← sq, root_sq_eq_algebraMap, Derivation.map_algebraMap]
  have hu : IsUnit (2 : HyperellipticCoordRing f) := by
    have := (isUnit_iff_ne_zero.mpr h2).map (algebraMap k (HyperellipticCoordRing f))
    rwa [map_ofNat] at this
  rw [← two_smul (HyperellipticCoordRing f)] at h
  exact hu.smul_eq_zero.mp h

variable (f) in
/-- `y` annihilates `Ω_{B/k[x]}` when `2 ≠ 0`. -/
theorem root_mem_annihilator (h2 : (2 : k) ≠ 0) :
    AdjoinRoot.root (polyX ^ 2 - C f : k[X][X]) ∈
      Module.annihilator (HyperellipticCoordRing f)
        (KaehlerDifferential k[X] (HyperellipticCoordRing f)) := by
  have hD : ∀ b : HyperellipticCoordRing f, AdjoinRoot.root (polyX ^ 2 - C f : k[X][X]) •
      KaehlerDifferential.D k[X] (HyperellipticCoordRing f) b = 0 := by
    intro b
    have hb : b ∈ Algebra.adjoin k[X] {AdjoinRoot.root (polyX ^ 2 - C f : k[X][X])} := by
      rw [AdjoinRoot.adjoinRoot_eq_top]
      trivial
    induction hb using Algebra.adjoin_induction with
    | mem x hx =>
      obtain rfl := Set.mem_singleton_iff.mp hx
      exact root_smul_D_root f h2
    | algebraMap r => rw [Derivation.map_algebraMap, smul_zero]
    | add x y _ _ hx hy => rw [map_add, smul_add, hx, hy, add_zero]
    | mul x y _ _ hx hy =>
      rw [Derivation.leibniz, smul_add, smul_comm_of_commRing _ x, smul_comm_of_commRing _ y, hx,
        hy, smul_zero, smul_zero, add_zero]
  rw [Module.mem_annihilator]
  intro m
  have hm : m ∈ Submodule.span (HyperellipticCoordRing f)
      (Set.range (KaehlerDifferential.D k[X] (HyperellipticCoordRing f))) := by
    rw [KaehlerDifferential.span_range_derivation]
    trivial
  induction hm using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨b, rfl⟩ := hx
    exact hD b
  | zero => exact smul_zero _
  | add x y _ _ hx hy => rw [smul_add, hx, hy, add_zero]
  | smul a x _ hx => rw [smul_comm_of_commRing, hx, smul_zero]

/-- **A prime not containing `y` is unramified** over `k[x]` (if `2 ≠ 0`). -/
theorem mem_unramifiedLocus_of_root_notMem (h2 : (2 : k) ≠ 0)
    {q : PrimeSpectrum (HyperellipticCoordRing f)}
    (hq : AdjoinRoot.root (polyX ^ 2 - C f : k[X][X]) ∉ q.asIdeal) :
    q ∈ Algebra.unramifiedLocus k[X] (HyperellipticCoordRing f) := by
  rw [Algebra.unramifiedLocus_eq_compl_support, Set.mem_compl_iff]
  exact fun hs => hq (Module.annihilator_le_of_mem_support hs (root_mem_annihilator f h2))

/-! ### Ramified at primes containing `y` -/

section Epsilon

/-- `B → (B/q)[ε]`, `x ↦ x mod q`, `y ↦ ε` (for `y ∈ q`). -/
@[expose]
noncomputable def epsilonMap (q : Ideal (HyperellipticCoordRing f))
    (hq : AdjoinRoot.root (polyX ^ 2 - C f : k[X][X]) ∈ q) :
    HyperellipticCoordRing f →+*
      TrivSqZeroExt (HyperellipticCoordRing f ⧸ q) (HyperellipticCoordRing f ⧸ q) :=
  AdjoinRoot.lift
    ((TrivSqZeroExt.inlHom _ _).comp ((Ideal.Quotient.mk q).comp (AdjoinRoot.of _)))
    (TrivSqZeroExt.inr 1) (by
      have h0 : Ideal.Quotient.mk q (AdjoinRoot.of (polyX ^ 2 - C f : k[X][X]) f) = 0 := by
        rw [← root_sq_eq_of, map_pow, Ideal.Quotient.eq_zero_iff_mem.mpr hq,
          zero_pow two_ne_zero]
      rw [eval₂_sub, eval₂_X_pow, eval₂_C, RingHom.comp_apply, RingHom.comp_apply, h0, map_zero,
        sub_zero]
      exact (sq _).trans (TrivSqZeroExt.inr_mul_inr _ _ _))

theorem epsilonMap_of (q : Ideal (HyperellipticCoordRing f))
    (hq : AdjoinRoot.root (polyX ^ 2 - C f : k[X][X]) ∈ q) (p : k[X]) :
    epsilonMap q hq (AdjoinRoot.of _ p) =
      TrivSqZeroExt.inl (Ideal.Quotient.mk q (AdjoinRoot.of _ p)) := by
  rw [epsilonMap, AdjoinRoot.lift_of]
  rfl

theorem epsilonMap_root (q : Ideal (HyperellipticCoordRing f))
    (hq : AdjoinRoot.root (polyX ^ 2 - C f : k[X][X]) ∈ q) :
    epsilonMap q hq (AdjoinRoot.root _) = TrivSqZeroExt.inr 1 := by
  rw [epsilonMap, AdjoinRoot.lift_root]

theorem fst_epsilonMap (q : Ideal (HyperellipticCoordRing f))
    (hq : AdjoinRoot.root (polyX ^ 2 - C f : k[X][X]) ∈ q)
    (b : HyperellipticCoordRing f) :
    (epsilonMap q hq b).fst = Ideal.Quotient.mk q b := by
  have h : (TrivSqZeroExt.fstHom ℕ (HyperellipticCoordRing f ⧸ q)
      (HyperellipticCoordRing f ⧸ q)).toRingHom.comp (epsilonMap q hq) = Ideal.Quotient.mk q := by
    apply AdjoinRoot.ringHom_ext
    · refine RingHom.ext fun p => ?_
      simp only [RingHom.comp_apply]
      rw [epsilonMap_of]
      rfl
    · rw [RingHom.comp_apply, epsilonMap_root, Ideal.Quotient.eq_zero_iff_mem.mpr hq]
      rfl
  exact RingHom.congr_fun h b

/-- The `k[x]`-derivation `B → B/q`, `x ↦ 0`, `y ↦ 1` (for `y ∈ q`). -/
@[expose]
noncomputable def rootDerivation (q : Ideal (HyperellipticCoordRing f))
    (hq : AdjoinRoot.root (polyX ^ 2 - C f : k[X][X]) ∈ q) :
    Derivation k[X] (HyperellipticCoordRing f) (HyperellipticCoordRing f ⧸ q) :=
  Derivation.mk'
    { toFun := fun b => (epsilonMap q hq b).snd
      map_add' := fun a b => by
        change (epsilonMap q hq (a + b)).snd = (epsilonMap q hq a).snd + (epsilonMap q hq b).snd
        rw [(epsilonMap q hq).map_add, TrivSqZeroExt.snd_add]
      map_smul' := fun r b => by
        simp only [Algebra.smul_def, RingHom.id_apply]
        rw [map_mul, AdjoinRoot.algebraMap_eq, epsilonMap_of, TrivSqZeroExt.snd_mul,
          TrivSqZeroExt.fst_inl, TrivSqZeroExt.snd_inl, smul_zero, add_zero, smul_eq_mul,
          ← AdjoinRoot.algebraMap_eq, Ideal.Quotient.mk_algebraMap] }
    (fun a b => by
      change (epsilonMap q hq (a * b)).snd =
        a • (epsilonMap q hq b).snd + b • (epsilonMap q hq a).snd
      rw [map_mul, TrivSqZeroExt.snd_mul, fst_epsilonMap, fst_epsilonMap, smul_eq_mul,
        op_smul_eq_mul, Algebra.smul_def, Algebra.smul_def, Ideal.Quotient.algebraMap_eq]
      ring)

theorem rootDerivation_root (q : Ideal (HyperellipticCoordRing f))
    (hq : AdjoinRoot.root (polyX ^ 2 - C f : k[X][X]) ∈ q) :
    rootDerivation q hq (AdjoinRoot.root _) = 1 := by
  change (epsilonMap q hq (AdjoinRoot.root _)).snd = 1
  rw [epsilonMap_root]
  rfl

end Epsilon

/-- **A prime containing `y` is ramified** over `k[x]`: it lies in the support of
`Ω_{B/k[x]}`. -/
theorem notMem_unramifiedLocus_of_root_mem {q : PrimeSpectrum (HyperellipticCoordRing f)}
    (hq : AdjoinRoot.root (polyX ^ 2 - C f : k[X][X]) ∈ q.asIdeal) :
    q ∉ Algebra.unramifiedLocus k[X] (HyperellipticCoordRing f) := by
  rw [Algebra.unramifiedLocus_eq_compl_support, Set.notMem_compl_iff, Module.mem_support_iff']
  refine ⟨KaehlerDifferential.D k[X] (HyperellipticCoordRing f) (AdjoinRoot.root _),
    fun r hr h => hr ?_⟩
  have h1 := congrArg (rootDerivation q.asIdeal hq).liftKaehlerDifferential h
  rw [map_smul, Derivation.liftKaehlerDifferential_comp_D, map_zero, rootDerivation_root,
    Algebra.smul_def, mul_one, Ideal.Quotient.algebraMap_eq] at h1
  exact Ideal.Quotient.eq_zero_iff_mem.mp h1

/-- **The ramification points of `x : {y^2 = f(x)} → 𝔸¹` are the points with `y = 0`**: if
`2 ≠ 0` in `k`, a prime `q` of `k[x, y]/(y^2 - f(x))` is unramified over `k[x]` iff `y ∉ q`. -/
theorem mem_unramifiedLocus_iff (h2 : (2 : k) ≠ 0)
    (q : PrimeSpectrum (HyperellipticCoordRing f)) :
    q ∈ Algebra.unramifiedLocus k[X] (HyperellipticCoordRing f) ↔
      AdjoinRoot.root (polyX ^ 2 - C f : k[X][X]) ∉ q.asIdeal :=
  ⟨fun h hq => notMem_unramifiedLocus_of_root_mem hq h, mem_unramifiedLocus_of_root_notMem h2⟩

/-! ### Branch points -/

variable (f) in
/-- The point `x = c` of the finite chart `𝔸¹ = Spec k[x]` of `ℙ¹` is a **branch point** of the
double cover `x : {y^2 = f(x)} → 𝔸¹` (`Spec k[x, y]/(y^2 - f(x)) → Spec k[x]`, the restriction
of `toProjectiveLine f` over `𝔸¹`, `isPullback_affineChart_toProjectiveLine`) if the cover is
ramified at some point above it: some prime of `k[x, y]/(y^2 - f(x))` lying over `(x - c)` is
not in the unramified locus. -/
@[expose]
def IsFiniteBranchPoint (c : k) : Prop :=
  ∃ q : PrimeSpectrum (HyperellipticCoordRing f),
    q.asIdeal.comap (algebraMap k[X] (HyperellipticCoordRing f)) = Ideal.span {polyX - C c} ∧
      q ∉ Algebra.unramifiedLocus k[X] (HyperellipticCoordRing f)

theorem eval_eq_zero_of_root_mem {c : k} {q : Ideal (HyperellipticCoordRing f)}
    (hc : q.comap (algebraMap k[X] (HyperellipticCoordRing f)) = Ideal.span {polyX - C c})
    (hq : AdjoinRoot.root (polyX ^ 2 - C f : k[X][X]) ∈ q) : f.eval c = 0 := by
  have h1 : algebraMap k[X] (HyperellipticCoordRing f) f ∈ q := by
    rw [← root_sq_eq_algebraMap]
    exact Ideal.pow_mem_of_mem q hq 2 two_pos
  have h2 : f ∈ Ideal.span {polyX - C c} := by
    rw [← hc, Ideal.mem_comap]
    exact h1
  rw [Ideal.mem_span_singleton, dvd_iff_isRoot] at h2
  exact h2

variable (f) in
/-- The point `(c, 0)` of `y^2 = f(x)` for a root `c` of `f`: `x ↦ c`, `y ↦ 0`. -/
@[expose]
noncomputable def evalRootPoint (c : k) (hc : f.eval c = 0) : HyperellipticCoordRing f →+* k :=
  AdjoinRoot.lift (evalRingHom c) 0 (by
    rw [eval₂_sub, eval₂_X_pow, eval₂_C, coe_evalRingHom, hc]
    ring)

variable (f) in
/-- **The roots of `f` are the finite branch points of the double cover `y^2 = f(x)` of the
projective line** (when `2 ≠ 0` in `k`): the point `x = c` of the finite chart is a branch point
iff `f(c) = 0`. -/
theorem isFiniteBranchPoint_iff (h2 : (2 : k) ≠ 0) (c : k) :
    IsFiniteBranchPoint f c ↔ f.eval c = 0 := by
  constructor
  · rintro ⟨q, hc, hq⟩
    refine eval_eq_zero_of_root_mem hc ?_
    by_contra h
    exact hq (mem_unramifiedLocus_of_root_notMem h2 h)
  · intro hc
    refine ⟨⟨RingHom.ker (evalRootPoint f c hc), RingHom.ker_isPrime _⟩, ?_,
      notMem_unramifiedLocus_of_root_mem ?_⟩
    · change Ideal.comap _ (RingHom.ker _) = _
      rw [RingHom.comap_ker, AdjoinRoot.algebraMap_eq, evalRootPoint, AdjoinRoot.lift_comp_of,
        ker_evalRingHom]
    · change _ ∈ RingHom.ker _
      rw [RingHom.mem_ker, evalRootPoint, AdjoinRoot.lift_root]

end Hyperelliptic

end ArithmeticOfJacobiPolynomials
