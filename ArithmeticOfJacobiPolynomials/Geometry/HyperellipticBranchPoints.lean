section PointIdeal

variable {X : Scheme.{u}}

/-- **The ideal sheaf of a point** `P`: the vanishing ideal sheaf of its closure. -/
@[expose] noncomputable def pointIdeal (P : X) : X.IdealSheafData :=
  Scheme.IdealSheafData.vanishingIdeal (Closeds.closure {P})

/-- A section over an affine open lies in the ideal sheaf of `P` iff it vanishes at `P`, i.e.
`P` is not in its basic open. -/
theorem mem_pointIdeal_iff (P : X) (U : X.affineOpens) (s : Γ(X, U)) :
    s ∈ (pointIdeal P).ideal U ↔ P ∉ X.basicOpen s := by
  rw [pointIdeal, Scheme.IdealSheafData.vanishingIdeal_ideal, PrimeSpectrum.mem_vanishingIdeal]
  constructor
  · intro h hP
    have hPU : P ∈ (U : Opens X) := X.basicOpen_le s hP
    have hrange : P ∈ Set.range U.2.fromSpec := by
      rw [U.2.range_fromSpec]
      exact hPU
    obtain ⟨q, hq⟩ := hrange
    have hPcl : U.2.fromSpec q ∈ closure ({P} : Set X) := by
      rw [hq]
      exact subset_closure (Set.mem_singleton P)
    have h1 : s ∈ q.asIdeal := h q hPcl
    have h2 : q ∈ U.2.fromSpec ⁻¹ᵁ X.basicOpen s := by
      change U.2.fromSpec q ∈ X.basicOpen s
      rw [hq]
      exact hP
    rw [U.2.fromSpec_preimage_basicOpen] at h2
    exact (PrimeSpectrum.mem_basicOpen _ _).mp h2 h1
  · intro hP q hq
    by_contra hs
    have hq' : q ∈ PrimeSpectrum.basicOpen s := (PrimeSpectrum.mem_basicOpen _ _).mpr hs
    have h2 : U.2.fromSpec q ∈ X.basicOpen s := by
      have h := hq'
      rw [← U.2.fromSpec_preimage_basicOpen] at h
      exact h
    have h3 : U.2.fromSpec q ∈ closure ({P} : Set X) := hq
    obtain ⟨z, hz1, hz2⟩ := mem_closure_iff.mp h3 _ (X.basicOpen s).isOpen h2
    rw [Set.mem_singleton_iff] at hz2
    subst hz2
    exact hP hz1

/-- Away from `P`, the ideal sheaf of `P` is the unit ideal. -/
theorem pointIdeal_ideal_eq_top (P : X) (U : X.affineOpens) (hP : P ∉ (U : Opens X)) :
    (pointIdeal P).ideal U = ⊤ :=
  (Ideal.eq_top_iff_one _).mpr ((mem_pointIdeal_iff P U 1).mpr (by
    rw [Scheme.basicOpen_one]
    exact hP))

/-- **A local equation of a point.** Let `U` be affine and `h, t, y ∈ Γ(X, U)` with `P ∈ D(h)`,
the ideal of `P` on `U` contained in `(t, y)`, `y(P) = 0` and `t h = y^2`. Then on the affine
open `D(h)` the ideal of `P` is generated by `y` (there `t = y^2/h ∈ (y)`). -/
theorem pointIdeal_ideal_basicOpen {P : X} (U : X.affineOpens) {h t y : Γ(X, U)}
    (hP : P ∈ X.basicOpen h) (hspan : (pointIdeal P).ideal U ≤ Ideal.span {t, y})
    (hy : P ∉ X.basicOpen y) (hty : t * h = y ^ 2) :
    (pointIdeal P).ideal ⟨X.basicOpen h, U.2.basicOpen h⟩ =
      Ideal.span {X.presheaf.map (homOfLE (X.basicOpen_le h)).op y} := by
  ext s
  obtain ⟨s', rfl⟩ : ∃ s' : Γ(X, X.basicOpen h), s' = s := ⟨s, rfl⟩
  rw [mem_pointIdeal_iff]
  constructor
  · intro hs
    have := U.2.isLocalization_basicOpen h
    obtain ⟨⟨a, m⟩, he⟩ := IsLocalization.surj (Submonoid.powers h) s'
    obtain ⟨n, hn⟩ := (Submonoid.mem_powers_iff _ _).mp m.2
    have he' : s' * X.presheaf.map (homOfLE (X.basicOpen_le h)).op h ^ n =
        X.presheaf.map (homOfLE (X.basicOpen_le h)).op a := by
      rw [← map_pow, hn]
      exact he
    have haP : P ∉ X.basicOpen a := by
      intro haP
      apply hs
      have h1 : P ∈ X.basicOpen (X.presheaf.map (homOfLE (X.basicOpen_le h)).op a) := by
        rw [Scheme.basicOpen_res]
        exact ⟨hP, haP⟩
      rw [← he', Scheme.basicOpen_mul] at h1
      exact h1.1
    obtain ⟨α, β, hab⟩ := Ideal.mem_span_pair.mp (hspan ((mem_pointIdeal_iff P U a).mpr haP))
    have hunit : IsUnit (X.presheaf.map (homOfLE (X.basicOpen_le h)).op h) :=
      RingedSpace.isUnit_res_basicOpen X.toRingedSpace h
    obtain ⟨w, hw⟩ := hunit.exists_right_inv
    have hlin : X.presheaf.map (homOfLE (X.basicOpen_le h)).op t *
        X.presheaf.map (homOfLE (X.basicOpen_le h)).op h =
          X.presheaf.map (homOfLE (X.basicOpen_le h)).op y ^ 2 := by
      rw [← map_mul, hty, map_pow]
    have ha' : X.presheaf.map (homOfLE (X.basicOpen_le h)).op a =
        X.presheaf.map (homOfLE (X.basicOpen_le h)).op α *
            X.presheaf.map (homOfLE (X.basicOpen_le h)).op t +
          X.presheaf.map (homOfLE (X.basicOpen_le h)).op β *
            X.presheaf.map (homOfLE (X.basicOpen_le h)).op y := by
      rw [← hab, map_add, map_mul, map_mul]
    have hwn : X.presheaf.map (homOfLE (X.basicOpen_le h)).op h ^ n * w ^ n = 1 := by
      rw [← mul_pow, hw, one_pow]
    refine Ideal.mem_span_singleton'.mpr
      ⟨(X.presheaf.map (homOfLE (X.basicOpen_le h)).op α *
          X.presheaf.map (homOfLE (X.basicOpen_le h)).op y * w +
        X.presheaf.map (homOfLE (X.basicOpen_le h)).op β) * w ^ n, ?_⟩
    linear_combination (-(X.presheaf.map (homOfLE (X.basicOpen_le h)).op α) * w ^ (n + 1)) * hlin +
      (X.presheaf.map (homOfLE (X.basicOpen_le h)).op α *
        X.presheaf.map (homOfLE (X.basicOpen_le h)).op t * w ^ n) * hw -
      w ^ n * ha' - w ^ n * he' + s' * hwn
  · intro hs hPs
    obtain ⟨d, rfl⟩ := Ideal.mem_span_singleton'.mp hs
    rw [Scheme.basicOpen_mul, Scheme.basicOpen_res] at hPs
    exact hy hPs.2.2

/-- The restriction of a section to an open inside its basic open is a unit. -/
theorem isUnit_res_of_le_basicOpen {U W : Opens X} (s : Γ(X, U)) (hW : W ≤ X.basicOpen s) :
    IsUnit (X.presheaf.map (homOfLE (hW.trans (X.basicOpen_le s))).op s) := by
  have e : (X.presheaf.map (homOfLE (hW.trans (X.basicOpen_le s))).op).hom s =
      (X.presheaf.map (homOfLE hW).op).hom
        ((X.presheaf.map (homOfLE (X.basicOpen_le s)).op).hom s) := by
    rw [← RingHom.comp_apply, ← CommRingCat.hom_comp, ← Functor.map_comp]
    rfl
  rw [e]
  have hu : IsUnit (X.presheaf.map (homOfLE (X.basicOpen_le s)).op s) :=
    RingedSpace.isUnit_res_basicOpen X.toRingedSpace s
  exact hu.map (X.presheaf.map (homOfLE hW).op).hom

/-- If `I` and `J` are generated on `U` by `a` and `b`, `I J` is generated by `a b`. -/
theorem ideal_mul_eq_span (I J : X.IdealSheafData) (U : X.affineOpens) {a b : Γ(X, U.1)}
    (hI : I.ideal U = Ideal.span {a}) (hJ : J.ideal U = Ideal.span {b}) :
    (I * J).ideal U = Ideal.span {a * b} := by
  rw [Scheme.IdealSheafData.ideal_mul, Pi.mul_apply, hI, hJ,
    Ideal.span_singleton_mul_span_singleton]

/-- The ideal of a finite product of ideal sheaves on an affine open. -/
theorem ideal_prod {ι : Type*} (s : Finset ι) (I : ι → X.IdealSheafData) (U : X.affineOpens) :
    (∏ i ∈ s, I i).ideal U = ∏ i ∈ s, (I i).ideal U := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    rw [Finset.prod_empty, Finset.prod_empty, Scheme.IdealSheafData.one_eq_top,
      Scheme.IdealSheafData.ideal_top, Ideal.one_eq_top]
    rfl
  | insert a s ha ih =>
    rw [Finset.prod_insert ha, Finset.prod_insert ha, Scheme.IdealSheafData.ideal_mul,
      Pi.mul_apply, ih]

/-- If each `I i` is generated on `U` by `τ i`, the product ideal sheaf is generated on `U` by
`∏ τ i`. -/
theorem ideal_prod_eq_span {ι : Type*} (s : Finset ι) (I : ι → X.IdealSheafData)
    (U : X.affineOpens) (τ : ι → Γ(X, U.1)) (h : ∀ i ∈ s, (I i).ideal U = Ideal.span {τ i}) :
    (∏ i ∈ s, I i).ideal U = Ideal.span {∏ i ∈ s, τ i} := by
  rw [ideal_prod, Finset.prod_congr rfl h, Ideal.prod_span_singleton]

end PointIdeal

