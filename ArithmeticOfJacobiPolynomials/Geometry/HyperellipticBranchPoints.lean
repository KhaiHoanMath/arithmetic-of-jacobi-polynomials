namespace Hyperelliptic

open _root_.Polynomial renaming X → polyX

open _root_.Polynomial Divisors
open scoped LaurentPolynomial

/-! ### Sections over open immersions and basic opens -/

/-- For an open immersion `g : Spec A → Y` with image `W`, the point `g(q)` lies in the basic
open of `s ∈ Γ(Y, W)` iff the corresponding element of `A` is not in `q`. -/
theorem mem_basicOpen_iff_sectionsRingEquiv {Y : Scheme.{u}} {A : CommRingCat.{u}}
    (g : Spec A ⟶ Y) [IsOpenImmersion g] {W : Y.Opens} (hW : g.opensRange = W) (s : Γ(Y, W))
    (q : Spec A) : g q ∈ Y.basicOpen s ↔ sectionsRingEquiv g hW s ∉ q.asIdeal := by
  have h := top_le_preimage_of_opensRange_eq g hW
  have h1 : g q ∈ Y.basicOpen s ↔ q ∈ (Spec A).basicOpen (g.app W s) := by
    rw [← Scheme.preimage_basicOpen]
    rfl
  have h2 : (Spec A).basicOpen (g.appLE W ⊤ h s) = (Spec A).basicOpen (g.app W s) := by
    rw [Scheme.Hom.appLE, ConcreteCategory.comp_apply, Scheme.basicOpen_res]
    exact top_inf_eq _
  have h4 : sectionsRingEquiv g hW s = (Scheme.ΓSpecIso A).hom (g.appLE W ⊤ h s) := rfl
  rw [h1, ← h2, basicOpen_eq_of_affine', h4]
  exact PrimeSpectrum.mem_basicOpen _ _

variable {k : Type u} [Field k] {f : k[X]}

/-! ### Coordinates on the charts -/

variable (f) in
/-- The polynomial function `p(x)` on the finite chart `D₊(Z)`. -/
noncomputable def finiteFn (p : k[X]) : Γ(projectiveModel f, chartOpen f) :=
  (sectionsEquivFinite f).symm (AdjoinRoot.of (polyX ^ 2 - C f) p)

variable (f) in
/-- The coordinate `y` on the finite chart `D₊(Z)`. -/
noncomputable def finiteY : Γ(projectiveModel f, chartOpen f) :=
  (sectionsEquivFinite f).symm (AdjoinRoot.root (polyX ^ 2 - C f))

variable (f) in
/-- The polynomial function `p(x')`, `x' = 1/x`, on the chart at infinity `D₊(X)`. -/
noncomputable def infiniteFn (p : k[X]) : Γ(projectiveModel f, chartOpenAtInfinity f) :=
  (sectionsEquivInfinite f).symm (AdjoinRoot.of (polyX ^ 2 - C (reflect (2 * genus f + 2) f)) p)

/-- The finite chart as an affine open. -/
noncomputable abbrev chartAffineOpen (f : k[X]) : (projectiveModel f).affineOpens :=
  ⟨chartOpen f, isAffineOpen_opensRange (affineChart f)⟩

theorem root_ne_zero (hf : f ≠ 0) : AdjoinRoot.root (polyX ^ 2 - C f : k[X][X]) ≠ 0 := by
  intro h
  have h1 := root_sq_eq_algebraMap f
  rw [h, zero_pow two_ne_zero] at h1
  exact hf (injective_algebraMap_hyperellipticCoordRing f (h1.symm.trans (map_zero _).symm))

theorem natDegree_pos_of_eval_eq_zero (hf : f.Separable) {c : k} (hc : f.eval c = 0) :
    0 < f.natDegree :=
  natDegree_pos_iff_degree_pos.mpr (degree_pos_of_root hf.ne_zero hc)

/-- A non-zero-divisor criterion through a ring isomorphism with a domain. -/
theorem mem_nonZeroDivisors_of_ringEquiv {A B : Type*} [CommRing A] [CommRing B] [IsDomain B]
    (e : A ≃+* B) {a : A} (ha : e a ≠ 0) : a ∈ nonZeroDivisors A := by
  have key : ∀ z : A, a * z = 0 → z = 0 := by
    intro z hz
    have h1 : e a * e z = 0 := by rw [← map_mul, hz, map_zero]
    have h2 : e z = 0 := (mul_eq_zero.mp h1).resolve_left ha
    exact e.injective (h2.trans (map_zero e).symm)
  exact mem_nonZeroDivisors_iff.mpr ⟨key, fun z hz => key z (by rw [mul_comm]; exact hz)⟩

theorem finiteFn_mem_nonZeroDivisors (hf : f.Separable) (hdeg : 0 < f.natDegree) {p : k[X]}
    (hp : p ≠ 0) : finiteFn f p ∈ nonZeroDivisors Γ(projectiveModel f, chartOpen f) := by
  have := isDomain_hyperellipticCoordRing hf hdeg
  refine mem_nonZeroDivisors_of_ringEquiv (sectionsEquivFinite f) ?_
  rw [finiteFn, RingEquiv.apply_symm_apply, ← AdjoinRoot.algebraMap_eq]
  exact fun h => hp (injective_algebraMap_hyperellipticCoordRing f (h.trans (map_zero _).symm))

/-! ### The branch point `P_c = (c, 0)` -/

variable (f) in
/-- The prime ideal `(x - c, y)` of `k[x, y]/(y^2 - f(x))`, for a root `c` of `f`. -/
noncomputable def rootPrime (c : k) (hc : f.eval c = 0) :
    Spec (CommRingCat.of (HyperellipticCoordRing f)) :=
  (⟨RingHom.ker (evalRootPoint f c hc), RingHom.ker_isPrime _⟩ :
    PrimeSpectrum (HyperellipticCoordRing f))

variable (f) in
/-- **The branch point** `P_c = (c, 0)` of the projective model, for a root `c` of `f`. -/
noncomputable def branchPoint (c : k) (hc : f.eval c = 0) : projectiveModel f :=
  affineChart f (rootPrime f c hc)

variable {c : k}

theorem evalRootPoint_of (hc : f.eval c = 0) (p : k[X]) :
    evalRootPoint f c hc (AdjoinRoot.of (polyX ^ 2 - C f) p) = p.eval c := by
  rw [evalRootPoint, AdjoinRoot.lift_of, coe_evalRingHom]

theorem evalRootPoint_root (hc : f.eval c = 0) :
    evalRootPoint f c hc (AdjoinRoot.root (polyX ^ 2 - C f)) = 0 := by
  rw [evalRootPoint, AdjoinRoot.lift_root]

theorem evalRootPoint_surjective (hc : f.eval c = 0) :
    Function.Surjective (evalRootPoint f c hc) :=
  fun r => ⟨AdjoinRoot.of _ (C r), by rw [evalRootPoint_of, eval_C]⟩

/-- A section over the finite chart vanishes at `P_c` iff its value at `(c, 0)` is zero. -/
theorem branchPoint_mem_basicOpen_iff (hc : f.eval c = 0)
    (s : Γ(projectiveModel f, chartOpen f)) :
    branchPoint f c hc ∈ (projectiveModel f).basicOpen s ↔
      evalRootPoint f c hc (sectionsEquivFinite f s) ≠ 0 := by
  rw [branchPoint, mem_basicOpen_iff_sectionsRingEquiv (affineChart f) rfl s]
  exact not_congr RingHom.mem_ker

theorem branchPoint_mem_chartOpen (hc : f.eval c = 0) : branchPoint f c hc ∈ chartOpen f :=
  Scheme.Hom.mem_opensRange.mpr ⟨rootPrime f c hc, rfl⟩

/-- `f = (x - c) · f/(x - c)`. -/
theorem X_sub_C_mul_divByMonic (hc : f.eval c = 0) : (polyX - C c) * (f /ₘ (polyX - C c)) = f :=
  mul_divByMonic_eq_iff_isRoot.mpr hc

/-- For `f` separable, the cofactor `f/(x - c)` does not vanish at the root `c`. -/
theorem eval_divByMonic_ne_zero (hf : f.Separable) (hc : f.eval c = 0) :
    (f /ₘ (polyX - C c)).eval c ≠ 0 := by
  intro h
  obtain ⟨g, hg⟩ := dvd_iff_isRoot.mpr h
  have hdvd : (polyX - C c) * (polyX - C c) ∣ f :=
    ⟨g, by rw [← X_sub_C_mul_divByMonic hc, hg, mul_assoc]⟩
  exact not_isUnit_X_sub_C c (hf.squarefree _ hdvd)

/-! ### The maximal ideal `(x - c, y)` and its square -/

/-- The maximal ideal of `(c, 0)` is `(x - c, y)`. -/
theorem ker_evalRootPoint (hc : f.eval c = 0) :
    RingHom.ker (evalRootPoint f c hc) =
      Ideal.span {AdjoinRoot.of (polyX ^ 2 - C f) (polyX - C c),
        AdjoinRoot.root (polyX ^ 2 - C f)} := by
  apply le_antisymm
  · intro z hz
    obtain ⟨g, rfl⟩ := AdjoinRoot.mk_surjective z
    rw [RingHom.mem_ker, evalRootPoint, AdjoinRoot.lift_mk, eval₂_at_zero,
      coe_evalRingHom] at hz
    obtain ⟨r, hr⟩ : polyX ∣ g - C (g.coeff 0) := by
      rw [X_dvd_iff, coeff_sub, coeff_C_zero, sub_self]
    obtain ⟨r', hr'⟩ : polyX - C c ∣ g.coeff 0 := dvd_iff_isRoot.mpr hz
    have hg : g = C (polyX - C c) * C r' + polyX * r := by
      rw [← C_mul, ← hr', ← hr]
      ring
    rw [hg, map_add, map_mul, map_mul, AdjoinRoot.mk_C, AdjoinRoot.mk_C, AdjoinRoot.mk_X]
    exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ (Ideal.subset_span (Set.mem_insert _ _)))
      (Ideal.mul_mem_right _ _
        (Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _))))
  · rw [Ideal.span_le, Set.insert_subset_iff, Set.singleton_subset_iff]
    refine ⟨?_, ?_⟩
    · change _ ∈ RingHom.ker _
      rw [RingHom.mem_ker, evalRootPoint_of]
      simp
    · change _ ∈ RingHom.ker _
      rw [RingHom.mem_ker, evalRootPoint_root]

/-- **The square of `(x - c, y)` is `(x - c)`** for `f` separable: `y^2 = (x - c) h` with
`h = f/(x - c)` coprime to `x - c`. -/
theorem ker_evalRootPoint_mul_self (hf : f.Separable) (hc : f.eval c = 0) :
    RingHom.ker (evalRootPoint f c hc) * RingHom.ker (evalRootPoint f c hc) =
      Ideal.span {AdjoinRoot.of (polyX ^ 2 - C f) (polyX - C c)} := by
  obtain ⟨a, ha⟩ : ∃ a, a = AdjoinRoot.of (polyX ^ 2 - C f) (polyX - C c) := ⟨_, rfl⟩
  obtain ⟨b, hb⟩ : ∃ b, b = AdjoinRoot.root (polyX ^ 2 - C f) := ⟨_, rfl⟩
  obtain ⟨h, hh⟩ : ∃ h, h = AdjoinRoot.of (polyX ^ 2 - C f) (f /ₘ (polyX - C c)) := ⟨_, rfl⟩
  have hbsq : b ^ 2 = a * h := by
    rw [hb, ha, hh, root_sq_eq_algebraMap, AdjoinRoot.algebraMap_eq, ← map_mul,
      X_sub_C_mul_divByMonic hc]
  obtain ⟨e, he⟩ : ∃ e, e = (f /ₘ (polyX - C c)).eval c := ⟨_, rfl⟩
  have he0 : e ≠ 0 := by
    rw [he]
    exact eval_divByMonic_ne_zero hf hc
  have hcop : ∃ u v, u * h + v * a = 1 := by
    obtain ⟨w, hw⟩ : polyX - C c ∣ f /ₘ (polyX - C c) - C e := by
      rw [he]
      exact X_sub_C_dvd_sub_C_eval
    refine ⟨AdjoinRoot.of _ (C e⁻¹), -AdjoinRoot.of _ (C e⁻¹ * w), ?_⟩
    rw [hh, ha, ← map_neg, ← map_mul, ← map_mul, ← map_add, ← map_one (AdjoinRoot.of _)]
    congr 1
    have hCe : C e⁻¹ * C e = 1 := by rw [← C_mul, inv_mul_cancel₀ he0, C_1]
    linear_combination C e⁻¹ * hw + hCe
  have hm : RingHom.ker (evalRootPoint f c hc) = Ideal.span {a, b} := by
    rw [ha, hb]
    exact ker_evalRootPoint hc
  rw [hm, ← ha]
  apply le_antisymm
  · rw [Ideal.mul_le]
    intro r hr s hs
    obtain ⟨r1, r2, rfl⟩ := Ideal.mem_span_pair.mp hr
    obtain ⟨s1, s2, rfl⟩ := Ideal.mem_span_pair.mp hs
    refine Ideal.mem_span_singleton'.mpr
      ⟨r1 * s1 * a + r1 * s2 * b + r2 * s1 * b + r2 * s2 * h, ?_⟩
    linear_combination (-(r2 * s2)) * hbsq
  · rw [Ideal.span_singleton_le_iff_mem]
    obtain ⟨u, v, huv⟩ := hcop
    have haI : a ∈ Ideal.span {a, b} := Ideal.subset_span (Set.mem_insert _ _)
    have hbI : b ∈ Ideal.span {a, b} :=
      Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _))
    have e1 : a = u * (b * b) + v * (a * a) := by linear_combination (-a) * huv - u * hbsq
    have hmem : u * (b * b) + v * (a * a) ∈ Ideal.span {a, b} * Ideal.span {a, b} :=
      Ideal.add_mem _ (Ideal.mul_mem_left _ _ (Ideal.mul_mem_mul hbI hbI))
        (Ideal.mul_mem_left _ _ (Ideal.mul_mem_mul haI haI))
    rwa [← e1] at hmem

/-! ### The ideal sheaf of `P_c` -/

variable (f) in
/-- **The ideal sheaf `𝒪(-P_c)` of the branch point** `P_c = (c, 0)`. -/
noncomputable abbrev branchIdeal (hc : f.eval c = 0) : (projectiveModel f).IdealSheafData :=
  pointIdeal (branchPoint f c hc)

/-- On the finite chart, the ideal of `P_c` is the kernel of evaluation at `(c, 0)`. -/
theorem branchIdeal_ideal_chartOpen_eq_comap (hc : f.eval c = 0) :
    (branchIdeal f hc).ideal (chartAffineOpen f) =
      Ideal.comap (sectionsEquivFinite f) (RingHom.ker (evalRootPoint f c hc)) := by
  ext s
  rw [Ideal.mem_comap, RingHom.mem_ker]
  exact (mem_pointIdeal_iff _ _ s).trans
    ((not_congr (branchPoint_mem_basicOpen_iff hc s)).trans not_not)

/-- **On the finite chart, the ideal of `P_c` is `(x - c, y)`.** -/
theorem branchIdeal_ideal_chartOpen (hc : f.eval c = 0) :
    (branchIdeal f hc).ideal (chartAffineOpen f) =
      Ideal.span {finiteFn f (polyX - C c), finiteY f} := by
  rw [branchIdeal_ideal_chartOpen_eq_comap, ← Ideal.map_symm, ker_evalRootPoint, Ideal.map_span,
    Set.image_pair]
  rfl

/-- **On the finite chart, the ideal of `2 P_c` is `(x - c)`** (`f` separable). -/
theorem branchIdeal_mul_self_ideal_chartOpen (hf : f.Separable) (hc : f.eval c = 0) :
    (branchIdeal f hc * branchIdeal f hc).ideal (chartAffineOpen f) =
      Ideal.span {finiteFn f (polyX - C c)} := by
  rw [Scheme.IdealSheafData.ideal_mul, Pi.mul_apply, branchIdeal_ideal_chartOpen_eq_comap,
    ← Ideal.map_symm, ← Ideal.map_mul, ker_evalRootPoint_mul_self hf hc, Ideal.map_span,
    Set.image_singleton]
  rfl

theorem branchPoint_mem_basicOpen_divByMonic (hf : f.Separable) (hc : f.eval c = 0) :
    branchPoint f c hc ∈ (projectiveModel f).basicOpen (finiteFn f (f /ₘ (polyX - C c))) := by
  rw [branchPoint_mem_basicOpen_iff, finiteFn, RingEquiv.apply_symm_apply, evalRootPoint_of]
  exact eval_divByMonic_ne_zero hf hc

theorem branchPoint_not_mem_basicOpen_finiteY (hc : f.eval c = 0) :
    branchPoint f c hc ∉ (projectiveModel f).basicOpen (finiteY f) := by
  rw [branchPoint_mem_basicOpen_iff, finiteY, RingEquiv.apply_symm_apply, evalRootPoint_root]
  exact fun h => h rfl

theorem finiteFn_mul_divByMonic (hc : f.eval c = 0) :
    finiteFn f (polyX - C c) * finiteFn f (f /ₘ (polyX - C c)) = finiteY f ^ 2 := by
  apply (sectionsEquivFinite f).injective
  simp only [map_mul, map_pow, finiteFn, finiteY, RingEquiv.apply_symm_apply]
  rw [← map_mul, X_sub_C_mul_divByMonic hc, root_sq_eq_algebraMap, AdjoinRoot.algebraMap_eq]

/-- **Near `P_c`, the ideal of `P_c` is generated by `y`**: on `D(f/(x - c))`. -/
theorem branchIdeal_ideal_basicOpen_divByMonic (hf : f.Separable) (hc : f.eval c = 0) :
    (branchIdeal f hc).ideal ⟨(projectiveModel f).basicOpen (finiteFn f (f /ₘ (polyX - C c))),
      (isAffineOpen_opensRange (affineChart f)).basicOpen _⟩ =
      Ideal.span {((projectiveModel f).presheaf.map
        (homOfLE ((projectiveModel f).basicOpen_le (finiteFn f (f /ₘ (polyX - C c))))).op
          (finiteY f))} :=
  pointIdeal_ideal_basicOpen (chartAffineOpen f) (branchPoint_mem_basicOpen_divByMonic hf hc)
    (branchIdeal_ideal_chartOpen hc).le (branchPoint_not_mem_basicOpen_finiteY hc)
    (finiteFn_mul_divByMonic hc)

theorem finiteY_res_mem_nonZeroDivisors (hf : f.Separable) (hc : f.eval c = 0) :
    (projectiveModel f).presheaf.map
        (homOfLE ((projectiveModel f).basicOpen_le (finiteFn f (f /ₘ (polyX - C c))))).op
          (finiteY f) ∈
      nonZeroDivisors
        Γ(projectiveModel f, (projectiveModel f).basicOpen (finiteFn f (f /ₘ (polyX - C c)))) := by
  have : IsIntegral (projectiveModel f) :=
    isIntegral_projectiveModel hf (natDegree_pos_of_eval_eq_zero hf hc)
  have : Nonempty ((projectiveModel f).basicOpen (finiteFn f (f /ₘ (polyX - C c)))) :=
    ⟨⟨_, branchPoint_mem_basicOpen_divByMonic hf hc⟩⟩
  have := IsIntegral.component_integral (X := projectiveModel f)
    ((projectiveModel f).basicOpen (finiteFn f (f /ₘ (polyX - C c))))
  refine mem_nonZeroDivisors_of_ne_zero ?_
  intro h0
  have h1 := map_injective_of_isIntegral (X := projectiveModel f)
    (homOfLE ((projectiveModel f).basicOpen_le (finiteFn f (f /ₘ (polyX - C c)))))
    (h0.trans (map_zero _).symm)
  apply root_ne_zero hf.ne_zero
  have h2 := congrArg (sectionsEquivFinite f) h1
  rwa [finiteY, RingEquiv.apply_symm_apply, map_zero] at h2

/-! ### The chart at infinity -/

theorem isLocalizationElem_eq_chartX_infinite :
    HomogeneousLocalization.Away.isLocalizationElem (var_mem_one f (weights_zero _))
      (var_mem_one f (weights_one _)) = chartX (chartData_infinite f) := by
  apply HomogeneousLocalization.val_injective
  simp only [HomogeneousLocalization.Away.isLocalizationElem, chartX,
    HomogeneousLocalization.Away.val_mk, pow_one]

theorem chartEquiv_chartX_infinite :
    chartEquiv (chartData_infinite f) (chartX (chartData_infinite f)) =
      AdjoinRoot.of (polyX ^ 2 - C (reflect (2 * genus f + 2) f) : k[X][X]) polyX := by
  change chartToAffine _ _ = _
  rw [chartX, chartToAffine_mk, dehomogenize_var,
    chartValues_o _ (chartData_infinite f).ne (chartData_infinite f).ne_two,
    AdjoinRoot.algebraMap_eq]

/-- **The points at infinity lie in `D(1 - c/x)`**: a point of the chart at infinity outside the
finite chart has `x' = 1/x = 0`. -/
theorem mem_basicOpen_infiniteFn_of_not_mem (c : k) {x : projectiveModel f}
    (hx₀ : x ∉ chartOpen f) (hx : x ∈ chartOpenAtInfinity f) :
    x ∈ (projectiveModel f).basicOpen (infiniteFn f (1 - C c * polyX)) := by
  obtain ⟨q, rfl⟩ := Scheme.Hom.mem_opensRange.mp hx
  rw [mem_basicOpen_iff_sectionsRingEquiv (affineChartAtInfinity f) rfl]
  change sectionsEquivInfinite f (infiniteFn f _) ∉ _
  rw [infiniteFn, RingEquiv.apply_symm_apply]
  have hX :
      AdjoinRoot.of (polyX ^ 2 - C (reflect (2 * genus f + 2) f) : k[X][X]) polyX ∈
        q.asIdeal := by
    have h1 : affineChartAtInfinity f q ∉ Proj.basicOpen (grading f) (var f 1) := by
      rw [← opensRange_affineChart]
      exact hx₀
    rw [affineChartAtInfinity, chart, Scheme.Hom.comp_apply] at h1
    have h2 : Spec.map (chartEquiv (chartData_infinite f)).toCommRingCatIso.hom q ∉
        PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.isLocalizationElem
          (var_mem_one f (weights_zero _)) (var_mem_one f (weights_one _))) := by
      rw [← Proj.awayι_preimage_basicOpen (grading f) (var_mem_one f (weights_zero _))
        Nat.one_pos (var_mem_one f (weights_one _)) Nat.one_pos]
      exact h1
    have h3 : HomogeneousLocalization.Away.isLocalizationElem (var_mem_one f (weights_zero _))
        (var_mem_one f (weights_one _)) ∈
          (Spec.map (chartEquiv (chartData_infinite f)).toCommRingCatIso.hom q).asIdeal := by
      by_contra hcon
      exact h2 ((PrimeSpectrum.mem_basicOpen _ _).mpr hcon)
    have h4 : chartEquiv (chartData_infinite f)
        (HomogeneousLocalization.Away.isLocalizationElem (var_mem_one f (weights_zero _))
          (var_mem_one f (weights_one _))) ∈ q.asIdeal := h3
    rw [isLocalizationElem_eq_chartX_infinite, chartEquiv_chartX_infinite] at h4
    exact h4
  intro h
  have h1 : (1 : HyperellipticCoordRing (reflect (2 * genus f + 2) f)) ∈ q.asIdeal := by
    have e : (1 : HyperellipticCoordRing (reflect (2 * genus f + 2) f)) =
        AdjoinRoot.of _ (1 - C c * polyX) + AdjoinRoot.of _ (C c) * AdjoinRoot.of _ polyX := by
      simp only [map_sub, map_one, map_mul]
      ring
    rw [e]
    exact q.asIdeal.add_mem h (q.asIdeal.mul_mem_left _ hX)
  exact q.isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr h1)

theorem overlap_restrict_finite (s : Γ(projectiveModel f, chartOpen f)) :
    sectionsEquivOverlap f ((projectiveModel f).presheaf.map
        (homOfLE (inf_le_left : chartOpen f ⊓ chartOpenAtInfinity f ≤ chartOpen f)).op s) =
      cechRestrictFinite f (sectionsEquivFinite f s) :=
  sectionsEquivOverlap_restrict_left f s

theorem overlap_restrict_infinite (s : Γ(projectiveModel f, chartOpenAtInfinity f)) :
    sectionsEquivOverlap f ((projectiveModel f).presheaf.map
        (homOfLE (inf_le_right : chartOpen f ⊓ chartOpenAtInfinity f ≤
          chartOpenAtInfinity f)).op s) =
      cechRestrictInfinite f (sectionsEquivInfinite f s) :=
  sectionsEquivOverlap_restrict_right f s

theorem T_one_mul_T_neg_one :
    (LaurentPolynomial.T 1 : k[T;T⁻¹]) * LaurentPolynomial.T (-1) = 1 := by
  rw [← LaurentPolynomial.T_add]
  simp

/-- On the overlap, `(x - c) · (1/x) = 1 - c/x`. -/
theorem overlap_identity (c : k) :
    (projectiveModel f).presheaf.map
        (homOfLE (inf_le_left : chartOpen f ⊓ chartOpenAtInfinity f ≤ chartOpen f)).op
          (finiteFn f (polyX - C c)) *
      (projectiveModel f).presheaf.map
        (homOfLE (inf_le_right : chartOpen f ⊓ chartOpenAtInfinity f ≤
          chartOpenAtInfinity f)).op (infiniteFn f polyX) =
    (projectiveModel f).presheaf.map
        (homOfLE (inf_le_right : chartOpen f ⊓ chartOpenAtInfinity f ≤
          chartOpenAtInfinity f)).op (infiniteFn f (1 - C c * polyX)) := by
  apply (sectionsEquivOverlap f).injective
  rw [map_mul, overlap_restrict_finite, overlap_restrict_infinite, overlap_restrict_infinite]
  simp only [finiteFn, infiniteFn, RingEquiv.apply_symm_apply]
  rw [cechRestrictFinite_of, cechRestrictInfinite_of, cechRestrictInfinite_of, ← map_mul]
  congr 1
  simp only [map_sub, map_mul, map_one, Polynomial.toLaurent_X, Polynomial.toLaurent_C,
    LaurentPolynomial.invert_T, LaurentPolynomial.invert_C]
  linear_combination (T_one_mul_T_neg_one (k := k))

/-- On the overlap, `(x - c)(1 - c'/x) = (1 - c/x)(x - c')`. -/
theorem overlap_identity₂ (c c' : k) :
    (projectiveModel f).presheaf.map
        (homOfLE (inf_le_left : chartOpen f ⊓ chartOpenAtInfinity f ≤ chartOpen f)).op
          (finiteFn f (polyX - C c)) *
      (projectiveModel f).presheaf.map
        (homOfLE (inf_le_right : chartOpen f ⊓ chartOpenAtInfinity f ≤
          chartOpenAtInfinity f)).op (infiniteFn f (1 - C c' * polyX)) =
    (projectiveModel f).presheaf.map
        (homOfLE (inf_le_right : chartOpen f ⊓ chartOpenAtInfinity f ≤
          chartOpenAtInfinity f)).op (infiniteFn f (1 - C c * polyX)) *
      (projectiveModel f).presheaf.map
        (homOfLE (inf_le_left : chartOpen f ⊓ chartOpenAtInfinity f ≤ chartOpen f)).op
          (finiteFn f (polyX - C c')) := by
  apply (sectionsEquivOverlap f).injective
  rw [map_mul, map_mul, overlap_restrict_finite, overlap_restrict_infinite,
    overlap_restrict_infinite, overlap_restrict_finite]
  simp only [finiteFn, infiniteFn, RingEquiv.apply_symm_apply]
  rw [cechRestrictFinite_of, cechRestrictInfinite_of, cechRestrictInfinite_of,
    cechRestrictFinite_of, ← map_mul, ← map_mul]
  congr 1
  simp only [map_sub, map_mul, map_one, Polynomial.toLaurent_X, Polynomial.toLaurent_C,
    LaurentPolynomial.invert_T, LaurentPolynomial.invert_C]
  linear_combination (LaurentPolynomial.C c - LaurentPolynomial.C c') *
    (T_one_mul_T_neg_one (k := k))

/-- **`P_c` is not in `D(1 - c/x)`**: on the overlap `1 - c/x = (x - c)/x` vanishes at `P_c`. -/
theorem branchPoint_not_mem_basicOpen_infinite (hc : f.eval c = 0) :
    branchPoint f c hc ∉ (projectiveModel f).basicOpen (infiniteFn f (1 - C c * polyX)) := by
  intro hP
  have hPinf : branchPoint f c hc ∈ chartOpenAtInfinity f := (projectiveModel f).basicOpen_le _ hP
  have hP₀ := branchPoint_mem_chartOpen hc
  have hPO : branchPoint f c hc ∈ chartOpen f ⊓ chartOpenAtInfinity f := ⟨hP₀, hPinf⟩
  have hu := ((projectiveModel f).mem_basicOpen _ _ hPinf).mp hP
  have e := congrArg ((projectiveModel f).presheaf.germ _ _ hPO) (overlap_identity (f := f) c)
  simp only [map_mul, TopCat.Presheaf.germ_res_apply] at e
  rw [← e] at hu
  have h0 := isUnit_of_mul_isUnit_left hu
  have h3 : branchPoint f c hc ∈ (projectiveModel f).basicOpen (finiteFn f (polyX - C c)) :=
    ((projectiveModel f).mem_basicOpen _ _ hP₀).mpr h0
  rw [branchPoint_mem_basicOpen_iff, finiteFn, RingEquiv.apply_symm_apply,
    evalRootPoint_of] at h3
  exact h3 (by simp)

/-- Every point other than `P_c` has an affine neighbourhood avoiding `P_c`. -/
theorem exists_affineOpen_not_mem (hc : f.eval c = 0) {x : projectiveModel f}
    (hx : x ≠ branchPoint f c hc) :
    ∃ V : (projectiveModel f).affineOpens, x ∈ (V : (projectiveModel f).Opens) ∧
      branchPoint f c hc ∉ (V : (projectiveModel f).Opens) := by
  by_cases hx₀ : x ∈ chartOpen f
  · obtain ⟨q, rfl⟩ := Scheme.Hom.mem_opensRange.mp hx₀
    have hne : ¬ RingHom.ker (evalRootPoint f c hc) ≤ q.asIdeal := by
      intro hle
      apply hx
      have hmax := RingHom.ker_isMaximal_of_surjective (evalRootPoint f c hc)
        (evalRootPoint_surjective hc)
      have heq := hmax.eq_of_le q.isPrime.ne_top hle
      change affineChart f q = affineChart f (rootPrime f c hc)
      congr 1
      exact PrimeSpectrum.ext heq.symm
    obtain ⟨a, ha, haq⟩ := IsConcreteLE.not_le_iff_exists.mp hne
    refine ⟨⟨_, (isAffineOpen_opensRange (affineChart f)).basicOpen
      ((sectionsEquivFinite f).symm a)⟩, ?_, ?_⟩
    · change affineChart f q ∈ (projectiveModel f).basicOpen ((sectionsEquivFinite f).symm a)
      rw [mem_basicOpen_iff_sectionsRingEquiv (affineChart f) rfl]
      change (sectionsEquivFinite f) ((sectionsEquivFinite f).symm a) ∉ _
      rw [RingEquiv.apply_symm_apply]
      exact haq
    · change branchPoint f c hc ∉ (projectiveModel f).basicOpen ((sectionsEquivFinite f).symm a)
      rw [branchPoint_mem_basicOpen_iff, RingEquiv.apply_symm_apply, not_not]
      exact ha
  · have hxinf : x ∈ chartOpenAtInfinity f := by
      have h : x ∈ chartOpen f ⊔ chartOpenAtInfinity f := by
        rw [chartOpen_sup_chartOpenAtInfinity' f]
        trivial
      exact (Opens.mem_sup.mp h).resolve_left hx₀
    exact ⟨⟨_, (isAffineOpen_opensRange (affineChartAtInfinity f)).basicOpen
      (infiniteFn f (1 - C c * polyX))⟩, mem_basicOpen_infiniteFn_of_not_mem c hx₀ hxinf,
      branchPoint_not_mem_basicOpen_infinite hc⟩

/-! ### `2 P_c ~ 2 P_{c'}` -/

/-- Near infinity, the unit `1 - c/x` generates the ideal of `2 P_c`: on an affine open inside
`D(1 - c/x)` the ideal of `2 P_c` is the unit ideal. -/
theorem branchIdeal_mul_self_ideal_eq_span_of_le (hc : f.eval c = 0)
    (W : (projectiveModel f).affineOpens)
    (hW : W.1 ≤ (projectiveModel f).basicOpen (infiniteFn f (1 - C c * polyX))) :
    (branchIdeal f hc * branchIdeal f hc).ideal W =
      Ideal.span {(projectiveModel f).presheaf.map (homOfLE (hW.trans
        ((projectiveModel f).basicOpen_le _))).op (infiniteFn f (1 - C c * polyX))} := by
  have hPA : branchPoint f c hc ∉ (W : (projectiveModel f).Opens) := fun hP =>
    branchPoint_not_mem_basicOpen_infinite hc (hW hP)
  rw [Scheme.IdealSheafData.ideal_mul, Pi.mul_apply, pointIdeal_ideal_eq_top _ W hPA,
    Ideal.top_mul, eq_comm, Ideal.span_singleton_eq_top]
  exact isUnit_res_of_le_basicOpen _ hW

/-- The finite chart and `D(1 - c/x) ∩ D(1 - c'/x)` cover the model. -/
theorem mem_chartOpen_or_mem_basicOpen_mul (c c' : k) (x : projectiveModel f) :
    x ∈ chartOpen f ∨ x ∈ (projectiveModel f).basicOpen
      (infiniteFn f (1 - C c * polyX) * infiniteFn f (1 - C c' * polyX)) := by
  rw [Scheme.basicOpen_mul]
  by_cases hx : x ∈ chartOpen f
  · exact Or.inl hx
  · right
    have hxinf : x ∈ chartOpenAtInfinity f := by
      have h : x ∈ chartOpen f ⊔ chartOpenAtInfinity f := by
        rw [chartOpen_sup_chartOpenAtInfinity' f]
        trivial
      exact (Opens.mem_sup.mp h).resolve_left hx
    exact ⟨mem_basicOpen_infiniteFn_of_not_mem c hx hxinf,
      mem_basicOpen_infiniteFn_of_not_mem c' hx hxinf⟩

/-- The ratios of the local generators agree on the overlap: `(x - c)/(1 - c/x) = x =
(x - c')/(1 - c'/x)`. -/
theorem germ_branch_compat (c c' : k) (x : projectiveModel f) (h₁ : x ∈ chartOpen f)
    {W : (projectiveModel f).Opens} (hW : W ≤ chartOpenAtInfinity f) (h₂ : x ∈ W) :
    (projectiveModel f).presheaf.germ (chartOpen f) x h₁ (finiteFn f (polyX - C c)) *
        (projectiveModel f).presheaf.germ W x h₂ ((projectiveModel f).presheaf.map
          (homOfLE hW).op (infiniteFn f (1 - C c' * polyX))) =
      (projectiveModel f).presheaf.germ W x h₂ ((projectiveModel f).presheaf.map
          (homOfLE hW).op (infiniteFn f (1 - C c * polyX))) *
        (projectiveModel f).presheaf.germ (chartOpen f) x h₁ (finiteFn f (polyX - C c')) := by
  have hO : x ∈ chartOpen f ⊓ chartOpenAtInfinity f := ⟨h₁, hW h₂⟩
  have e := congrArg ((projectiveModel f).presheaf.germ _ _ hO) (overlap_identity₂ (f := f) c c')
  simp only [map_mul, TopCat.Presheaf.germ_res_apply] at e
  simp only [TopCat.Presheaf.germ_res_apply]
  exact e

end Hyperelliptic

