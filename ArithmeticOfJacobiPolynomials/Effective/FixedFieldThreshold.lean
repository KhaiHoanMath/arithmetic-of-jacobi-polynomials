/-!
# The fixed-field assertion of Theorem 1.3, effective in `(a, b, E)`

The addendum to Theorem 1.3 (§1.2) states that for a number field `E` the
splitting field of `P_n^{(a,b)}` is linearly disjoint from `E`, with `P_n^{(a,b)}` irreducible
over `E` with group `S_n`, for all `n` beyond a threshold *effective in `a, b, E`*. The proof
uses the bound `R` for the primes ramified in a Galois closure `E'` of `E`: the prime `p` of
Lemma 5.16 with `v_p(disc) = p` satisfies `3n/4 < p`, so `p > R` once `n > 2R`, and the inertia
groups at `p`, which contain an odd permutation, normally generate `S_n`.

* `isField_tensorProduct_of_isUnramifiedIn`: for a Galois number field `E'` with an embedding
  `E → E'` and any `R` such that **every prime `p > R` is unramified in `E'`**, every finite
  Galois `K/ℚ` whose Galois group is normally generated by its inertia groups at primes `p > R`
  is linearly disjoint from `E` (the argument of `exists_bound_isField_tensorProduct` with an
  arbitrary `R`);
* `isUnramifiedIn_of_natAbs_discr_lt`: `R = |disc E'|` has this property (Dedekind's
  discriminant theorem, `NumberField.not_dvd_discr_iff_isUnramifiedIn`); for instance `E'` is the
  splitting field of the minimal polynomial of a primitive element of `E`, as in
  `exists_bound_isField_tensorProduct`, and `|disc E'|` is an explicit integer attached to `E'`;
* `fixedFieldThreshold a b R = unequalGaloisThreshold a b + 2R + 1`, a computable function of
  `a, b, R`;
* `unequalFixedField_of_fixedFieldThreshold_le`: **the fixed-field assertion of Theorem 1.3,
  effective form**: for `n ≥ fixedFieldThreshold a b R` the conclusions hold.

Conditional on the cited literature of `unequalIntegralParametersFixedField`.
-/

public section

namespace ArithmeticOfJacobiPolynomials

open Polynomial NumberField TensorProduct UnequalParameters

/-! ### Linear disjointness from `E`, for an explicit ramification bound -/

namespace FixedFieldDisjointness

/-- **Linear disjointness from `E` with an explicit bound.** Let `E'` be a Galois number field
with an embedding `ι : E → E'`, and `R` such that every prime `p > R` is unramified in `E'`. If
the Galois group of a finite Galois `K/ℚ` is normally generated by the inertia groups at primes
`p > R`, then `K ⊗[ℚ] E` is a field. -/
theorem isField_tensorProduct_of_isUnramifiedIn (E E' : Type*) [Field E] [NumberField E]
    [Field E'] [NumberField E'] [IsGalois ℚ E'] (ιE : E →ₐ[ℚ] E') (R : ℕ)
    (hR : ∀ p : ℕ, p.Prime → R < p → Algebra.IsUnramifiedIn (𝓞 E') (Ideal.span {(p : ℤ)}))
    (K : Type*) [Field K] [NumberField K] [IsGalois ℚ K]
    (hgen : ∀ N : Subgroup Gal(K/ℚ), N.Normal →
      (∀ p : ℕ, p.Prime → R < p → ∀ (P : Ideal (𝓞 K)) [P.IsPrime],
        P.LiesOver (Ideal.span {(p : ℤ)}) → P.inertia Gal(K/ℚ) ≤ N) → N = ⊤) :
    IsField (K ⊗[ℚ] E) := by
  let fe : E' →ₐ[ℚ] AlgebraicClosure ℚ := IsAlgClosed.lift
  let fb : E →ₐ[ℚ] AlgebraicClosure ℚ := fe.comp ιE
  let fa : K →ₐ[ℚ] AlgebraicClosure ℚ := IsAlgClosed.lift
  have hfaG := IsGalois.of_algEquiv fa.equivFieldRange
  have hfeG := IsGalois.of_algEquiv fe.equivFieldRange
  have hfaF := LinearEquiv.finiteDimensional fa.equivFieldRange.toLinearEquiv
  have hfbF := LinearEquiv.finiteDimensional fb.equivFieldRange.toLinearEquiv
  have hAG := FiniteGaloisIntermediateField.instIsGaloisSubtypeMemIntermediateFieldMin
    fa.fieldRange fe.fieldRange
  have hAle : fa.fieldRange ⊓ fe.fieldRange ≤ fa.fieldRange := inf_le_left
  let F : IntermediateField ℚ K := (fa.fieldRange ⊓ fe.fieldRange).comap fa
  have hmap : F.map fa = fa.fieldRange ⊓ fe.fieldRange := by
    ext z
    rw [IntermediateField.mem_map]
    constructor
    · rintro ⟨x, hx, rfl⟩
      exact hx
    · intro hz
      obtain ⟨x, rfl⟩ := (AlgHom.mem_fieldRange).mp (hAle hz)
      exact ⟨x, hz, rfl⟩
  let eF : F ≃ₐ[ℚ] ↥(fa.fieldRange ⊓ fe.fieldRange) :=
    (IntermediateField.equivMap F fa).trans (IntermediateField.equivOfEq hmap)
  have hFG := IsGalois.of_algEquiv eF.symm
  let _ : Algebra F E' :=
    ((fe.equivFieldRange.symm.toRingHom.comp
      (IntermediateField.inclusion
        (inf_le_right : fa.fieldRange ⊓ fe.fieldRange ≤ fe.fieldRange)).toRingHom).comp
      eF.toRingHom).toAlgebra
  have hunr : ∀ p : ℕ, p.Prime → R < p →
      Algebra.IsUnramifiedIn (𝓞 F) (Ideal.span {(p : ℤ)}) := by
    intro p hp hRp
    have hpZ : Prime (p : ℤ) := Nat.prime_iff_prime_int.mp hp
    have hE' : ¬ (p : ℤ) ∣ discr E' :=
      (not_dvd_discr_iff_isUnramifiedIn E' (𝓞 E') hpZ).mpr (hR p hp hRp)
    have hnd : ¬ (p : ℤ) ∣ discr F := fun h => hE' (h.trans (discr_dvd_discr F E'))
    exact (not_dvd_discr_iff_isUnramifiedIn F (𝓞 F) hpZ).mp hnd
  have hFbot : F = ⊥ :=
    eq_bot_of_inertia_normal_generation (hF := hFG) F {p | p.Prime ∧ R < p}
      (fun p hp => ⟨hp.1, hunr p hp.1 hp.2⟩)
      (fun N hN h => hgen N hN fun p hp hR P _ hP => h p ⟨hp, hR⟩ P hP)
  have hAbot : fa.fieldRange ⊓ fe.fieldRange = ⊥ := by
    rw [← hmap, hFbot, IntermediateField.map_bot]
  have hinf : fa.fieldRange ⊓ fb.fieldRange = ⊥ := by
    rw [eq_bot_iff, ← hAbot]
    refine inf_le_inf_left _ fun x hx => ?_
    obtain ⟨z, rfl⟩ := (AlgHom.mem_fieldRange).mp hx
    exact (AlgHom.mem_fieldRange).mpr ⟨ιE z, rfl⟩
  have hld : fa.fieldRange.LinearDisjoint fb.fieldRange :=
    IntermediateField.LinearDisjoint.of_inf_eq_bot hinf
  exact hld.isField_of_isAlgebraic' (Or.inl inferInstance)

/-- **`R = |disc E'|` bounds the ramified primes of `E'`** (Dedekind): every prime
`p > |disc E'|` is unramified in `E'`. -/
theorem isUnramifiedIn_of_natAbs_discr_lt (E' : Type*) [Field E'] [NumberField E'] {p : ℕ}
    (hp : p.Prime) (hR : (discr E').natAbs < p) :
    Algebra.IsUnramifiedIn (𝓞 E') (Ideal.span {(p : ℤ)}) :=
  (not_dvd_discr_iff_isUnramifiedIn E' (𝓞 E') (Nat.prime_iff_prime_int.mp hp)).mp
    (not_dvd_of_natAbs_lt (discr_ne_zero E') hR)

end FixedFieldDisjointness

open FixedFieldDisjointness

/-! ### The data of the fixed-field assertion at an explicit range -/

open Classical in
/-- The data of the fixed-field assertion of Theorem 1.3 for every `n ≥ unequalGaloisThreshold
a b`: `P_n^{(a,b)}` is irreducible with group `S_n`, `n ≥ 5`, and there is a prime `p` with
`3n/4 < p ≤ 7n/8` and `v_p(disc)` odd. -/
theorem fixedField_data_of_unequalGaloisThreshold_le (hH : HansonLcmBound)
     (hZ : JacobiSimpleRealZeros) (hJordan : JordanPrimeCycleTheorem)
     (hEis : EisensteinPrimeTotallyRamified)
    (hdisc : JacobiDiscriminantFormula) (hDusart : DusartThetaBound) {a b : ℕ} (hab : a ≠ b) :
    ∀ n ≥ unequalGaloisThreshold a b,
      Irreducible (jacobiP a b n) ∧ GaloisGroupIsSymmetric (jacobiP a b n) ∧ 5 ≤ n ∧
      ∃ p : ℕ, p.Prime ∧ 3 * n < 4 * p ∧ 8 * p ≤ 7 * n ∧
        Odd (padicValRat p (jacobiDiscriminant a b n)) := by
  have hodd : ∀ m δ p : ℕ, p.Prime → 2 * (a + b) + 10 ≤ m → 3 * (2 * m + δ) < 4 * p →
      8 * p ≤ 7 * (2 * m + δ) → Odd (padicValRat p (jacobiDiscriminant a b (2 * m + δ))) := by
    intro m δ p hp hm hp1 hp2
    have : Fact p.Prime := ⟨hp⟩
    rw [padicValRat_jacobiDiscriminant (p := p) (a := a) (b := b) (n := 2 * m + δ)
      (by omega) (by omega) (by omega) (by omega)]
    exact (Int.odd_coe_nat p).mpr (hp.odd_of_ne_two (by omega))
  intro n hn
  obtain ⟨hirr, hS⟩ := irreducible_galoisGroupIsSymmetric_jacobiP_of_unequalGaloisThreshold_le
    hH hZ hJordan hEis hdisc hDusart hab n hn
  obtain ⟨m, δ, hδ, rfl⟩ : ∃ m δ, δ ≤ 1 ∧ n = 2 * m + δ :=
    ⟨n / 2, n % 2, by omega, by omega⟩
  rcases lt_or_gt_of_ne hab with h | h
  · rw [unequalGaloisThreshold_comm] at hn
    obtain ⟨hm, p, hp, hp1, hp2, -⟩ :=
      exists_galoisPrime_of_unequalGaloisThreshold_le hDusart h hδ hn
    exact ⟨hirr, hS, by omega, p, hp, hp1, hp2, hodd m δ p hp (by omega) hp1 hp2⟩
  · obtain ⟨hm, p, hp, hp1, hp2, -⟩ :=
      exists_galoisPrime_of_unequalGaloisThreshold_le hDusart h hδ hn
    exact ⟨hirr, hS, by omega, p, hp, hp1, hp2, hodd m δ p hp hm hp1 hp2⟩

/-- The explicit computable threshold of the fixed-field assertion of Theorem 1.3:
`fixedFieldThreshold a b R = unequalGaloisThreshold a b + 2R + 1`, where `R` bounds the primes
ramified in a Galois closure of `E` (e.g. `R = |disc E'|`). -/
def fixedFieldThreshold (a b R : ℕ) : ℕ := unequalGaloisThreshold a b + 2 * R + 1

theorem fixedFieldThreshold_eq (a b R : ℕ) :
    fixedFieldThreshold a b R = unequalGaloisThreshold a b + 2 * R + 1 := (rfl)

open Classical in
/-- **Normal generation by inertia at an explicit range.** For distinct `a, b`, any `R` and
every `n ≥ fixedFieldThreshold a b R`, every normal subgroup of `Gal(P_n^{(a,b)}/ℚ)` containing
all inertia groups at primes `p > R` is the whole group. -/
theorem eq_top_of_inertia_le_of_fixedFieldThreshold_le (hH : HansonLcmBound)
     (hZ : JacobiSimpleRealZeros) (hJordan : JordanPrimeCycleTheorem)
     (hEis : EisensteinPrimeTotallyRamified)
    (hdisc : JacobiDiscriminantFormula) (hDusart : DusartThetaBound) {a b : ℕ} (hab : a ≠ b)
    (R : ℕ) :
    ∀ n ≥ fixedFieldThreshold a b R, ∀ M : Subgroup (jacobiP a b n).Gal, M.Normal →
      (∀ p : ℕ, p.Prime → R < p → ∀ (P : Ideal (𝓞 (jacobiP a b n).SplittingField)) [P.IsPrime],
        P.LiesOver (Ideal.span {(p : ℤ)}) →
          P.inertia Gal((jacobiP a b n).SplittingField/ℚ) ≤ M) →
      M = ⊤ := by
  intro n hn M hM hle
  rw [fixedFieldThreshold_eq] at hn
  obtain ⟨hirr, hS, h5, p, hp, hp1, hp2, hodd⟩ :=
    fixedField_data_of_unequalGaloisThreshold_le hH hZ hJordan hEis hdisc hDusart hab n
      (by omega)
  have : Fact p.Prime := ⟨hp⟩
  have : NumberField (jacobiP a b n).SplittingField := ⟨⟩
  have := Int.ideal_span_isMaximal_of_prime p
  obtain ⟨Q, hQmax, hQp⟩ : ∃ Q : Ideal (𝓞 (jacobiP a b n).SplittingField),
      Q.IsMaximal ∧ Q.LiesOver (Ideal.span {(p : ℤ)}) :=
    Ideal.exists_maximal_ideal_liesOver_of_isIntegral _
  have : Q.IsPrime := hQmax.isPrime
  obtain ⟨τ, hτQ, hτ⟩ := exists_mem_inertia_sign_galPerm_eq_neg_one hdisc a b n
    hirr.separable (natDegree_jacobiP_nat a b n) hodd Q
  refine eq_top_of_normal_of_galPerm_odd hS ?_ hM (hle p hp (by omega) Q hQp hτQ) hτ
  rw [card_rootSet_of_irreducible hirr, natDegree_jacobiP_nat]
  exact h5

/-- **The fixed-field assertion of Theorem 1.3, effective form** (§1.2). Let
`a ≠ b` be nonnegative integers, `E` a number field, `E'` a Galois number field with an
embedding `E → E'` (a Galois closure of `E`), and `R` such that every prime `p > R` is
unramified in `E'` (e.g. `R = |disc E'|`, `isUnramifiedIn_of_natAbs_discr_lt`). For every
`n ≥ fixedFieldThreshold a b R = unequalGaloisThreshold a b + 2R + 1`, the splitting field of
`P_n^{(a,b)}` is linearly disjoint from `E` over `ℚ`, and `P_n^{(a,b)}` is irreducible over `E`
with Galois group `S_n`. Conditional on [Hanson, Theorem 1] (`hH`), [DLMF, §18.2(vi)] (`hZ`),
[Jones, Theorem 1.1] (`hJordan`), [Milne, ANT v3.08, Proposition 3.53] (`hEis`), the Jacobi
discriminant formula
(`hdisc`) and [Dusart10, Theorem 5.2] (`hDusart`). -/
theorem unequalFixedField_of_fixedFieldThreshold_le (hH : HansonLcmBound)
     (hZ : JacobiSimpleRealZeros) (hJordan : JordanPrimeCycleTheorem)
     (hEis : EisensteinPrimeTotallyRamified)
    (hdisc : JacobiDiscriminantFormula) (hDusart : DusartThetaBound) {a b : ℕ} (hab : a ≠ b)
    (E E' : Type*) [Field E] [NumberField E] [Field E'] [NumberField E'] [IsGalois ℚ E']
    (ι : E →ₐ[ℚ] E') (R : ℕ)
    (hR : ∀ p : ℕ, p.Prime → R < p → Algebra.IsUnramifiedIn (𝓞 E') (Ideal.span {(p : ℤ)})) :
    ∀ n ≥ fixedFieldThreshold a b R,
      IsField ((jacobiP a b n).SplittingField ⊗[ℚ] E) ∧
      Irreducible ((jacobiP a b n).map (algebraMap ℚ E)) ∧
      GaloisGroupIsSymmetric ((jacobiP a b n).map (algebraMap ℚ E)) := by
  intro n hn
  have : NumberField (jacobiP a b n).SplittingField := ⟨⟩
  have : IsGalois ℚ (jacobiP a b n).SplittingField := IsGalois.mk
  have hF := isField_tensorProduct_of_isUnramifiedIn E E' ι R hR (jacobiP a b n).SplittingField
    (eq_top_of_inertia_le_of_fixedFieldThreshold_le hH hZ hJordan hEis hdisc hDusart hab R n hn)
  have hn' : unequalGaloisThreshold a b ≤ n := by rw [fixedFieldThreshold_eq] at hn; omega
  obtain ⟨hirr, hS⟩ := irreducible_galoisGroupIsSymmetric_jacobiP_of_unequalGaloisThreshold_le
    hH hZ hJordan hEis hdisc hDusart hab n hn'
  exact ⟨hF, irreducible_map_of_isField_tensorProduct hirr hF,
    galoisGroupIsSymmetric_map_of_isField_tensorProduct hS hF⟩

/-- The effective fixed-field assertion with the discriminant bound `R = |disc E'|`. -/
theorem unequalFixedField_of_discr (hH : HansonLcmBound)
     (hZ : JacobiSimpleRealZeros) (hJordan : JordanPrimeCycleTheorem)
     (hEis : EisensteinPrimeTotallyRamified)
    (hdisc : JacobiDiscriminantFormula) (hDusart : DusartThetaBound) {a b : ℕ} (hab : a ≠ b)
    (E E' : Type*) [Field E] [NumberField E] [Field E'] [NumberField E'] [IsGalois ℚ E']
    (ι : E →ₐ[ℚ] E') :
    ∀ n ≥ fixedFieldThreshold a b (discr E').natAbs,
      IsField ((jacobiP a b n).SplittingField ⊗[ℚ] E) ∧
      Irreducible ((jacobiP a b n).map (algebraMap ℚ E)) ∧
      GaloisGroupIsSymmetric ((jacobiP a b n).map (algebraMap ℚ E)) :=
  unequalFixedField_of_fixedFieldThreshold_le hH hZ hJordan hEis hdisc hDusart hab E E' ι _
    fun _ hp hR => isUnramifiedIn_of_natAbs_discr_lt E' hp hR

end ArithmeticOfJacobiPolynomials
