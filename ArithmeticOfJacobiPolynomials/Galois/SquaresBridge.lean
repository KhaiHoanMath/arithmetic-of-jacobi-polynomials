/-!
# Galois groups of even polynomials and their quotients by `T = -X²`

Let `J, L ∈ F[X]` (`F` of characteristic zero) with `J(-X²) = k L`, `k ≠ 0`, `J` separable and
`J(0) ≠ 0`. Then `L` is separable, its roots are nonzero and closed under negation, and the
Galois group of `L` acts on its roots through permutations commuting with negation. The roots
of `J` are the numbers `-x²` for the roots `x` of `L`, and restriction to the splitting field of
`J` identifies the action of `Gal(L/F)` on the opposite root pairs with the action of
`Gal(J/F)` on the roots of `J`. In particular, if `Gal(J/F)` is the full symmetric group, the
Galois group of `L` projects onto all permutations of the pairs (proof of Theorem 5.9,
"restriction to the field generated by the squares").
-/

public section

namespace ArithmeticOfJacobiPolynomials

open Polynomial

variable {F : Type*} [Field F]

/-- Every element of the Galois group permutes the roots compatibly with negation. -/
theorem range_galPerm_le_negCommPerm (L : F[X]) :
    (galPerm L).range ≤ negCommPerm (L.rootSet L.SplittingField) := by
  rintro _ ⟨σ, rfl⟩
  rw [mem_negCommPerm_iff]
  intro x y
  rw [galPerm_apply, galPerm_apply]
  change (y : L.SplittingField) = -x ↔ σ y = -σ x
  rw [← map_neg]
  exact ⟨fun h => by rw [h], fun h => σ.injective h⟩

section Quotient

variable {J L : F[X]} {k : F}

theorem separable_comp_neg_X_sq [CharZero F] (hJ : J.Separable) (hJ0 : J.coeff 0 ≠ 0) :
    (J.comp (-X ^ 2)).Separable := by
  rw [separable_def] at hJ ⊢
  have hd : derivative (-X ^ 2 : F[X]) = C (-2) * X := by
    rw [derivative_neg, derivative_X_pow]; simp
  rw [derivative_comp, hd]
  have h1 : IsCoprime (J.comp (-X ^ 2)) ((derivative J).comp (-X ^ 2)) := by
    simpa using hJ.map (compRingHom (-X ^ 2 : F[X]))
  have h2 : IsCoprime (J.comp (-X ^ 2)) X := by
    refine IsCoprime.symm ((irreducible_X).coprime_iff_not_dvd.mpr ?_)
    rw [X_dvd_iff, coeff_zero_eq_eval_zero, eval_comp]
    simpa [coeff_zero_eq_eval_zero] using hJ0
  have h3 : IsCoprime (J.comp (-X ^ 2)) (C (-2 : F)) :=
    ⟨0, C (-1 / 2), by rw [zero_mul, zero_add, ← C_mul]; norm_num⟩
  exact (h3.mul_right h2).mul_right h1

variable (hk : k ≠ 0) (hJL : J.comp (-X ^ 2) = C k * L)
include hk hJL

set_option linter.unusedSectionVars false in -- `hk` is part of the uniform signature
theorem separable_of_comp_neg_X_sq [CharZero F] (hJ : J.Separable) (hJ0 : J.coeff 0 ≠ 0) :
    L.Separable :=
  (separable_comp_neg_X_sq hJ hJ0).of_dvd (hJL ▸ dvd_mul_left L (C k))

set_option linter.unusedSectionVars false in -- `hk` is part of the uniform signature
theorem aeval_eq_of_comp_neg_X_sq {A : Type*} [CommRing A] [Algebra F A] (x : A) :
    algebraMap F A k * aeval x L = aeval (-x ^ 2) J := by
  have := congrArg (aeval x) hJL
  rw [aeval_comp, map_mul, aeval_C] at this
  simpa using this.symm

theorem natDegree_of_comp_neg_X_sq : L.natDegree = 2 * J.natDegree := by
  have := congrArg natDegree hJL
  rw [natDegree_C_mul hk, natDegree_comp, natDegree_neg, natDegree_X_pow] at this
  omega

theorem neg_mem_rootSet_of_comp_neg_X_sq {x : L.SplittingField}
    (hx : x ∈ L.rootSet L.SplittingField) : -x ∈ L.rootSet L.SplittingField := by
  rw [mem_rootSet] at hx ⊢
  refine ⟨hx.1, ?_⟩
  have h1 := aeval_eq_of_comp_neg_X_sq hk hJL x
  have h2 := aeval_eq_of_comp_neg_X_sq hk hJL (-x)
  rw [hx.2, mul_zero] at h1
  rw [neg_sq, ← h1] at h2
  exact (mul_eq_zero.mp h2).resolve_left ((_root_.map_ne_zero _).mpr hk)

theorem zero_not_mem_rootSet_of_comp_neg_X_sq (hJ0 : J.coeff 0 ≠ 0) :
    (0 : L.SplittingField) ∉ L.rootSet L.SplittingField := by
  intro h
  rw [mem_rootSet] at h
  have h1 := aeval_eq_of_comp_neg_X_sq hk hJL (0 : L.SplittingField)
  rw [h.2, mul_zero, zero_pow two_ne_zero, neg_zero, ← coeff_zero_eq_aeval_zero'] at h1
  exact hJ0 ((map_eq_zero _).mp h1.symm)

end Quotient

section Restrict

variable [CharZero F] {J L : F[X]} {k : F} (hk : k ≠ 0) (hJL : J.comp (-X ^ 2) = C k * L)
  (hJ : J.Separable) (hJ0 : J.coeff 0 ≠ 0)
include hk hJL hJ0

/-- `x² ↦ -x²` sends the squares of the roots of `L` to roots of `J`. -/
noncomputable def squareToRoot (q : squares (L.rootSet L.SplittingField)) :
    J.rootSet L.SplittingField :=
  ⟨-(q : L.SplittingField), by
    obtain ⟨x, hx, hq⟩ := q.2
    have hJne : J ≠ 0 := fun h => hJ0 (by rw [h, coeff_zero])
    rw [mem_rootSet]
    refine ⟨hJne, ?_⟩
    have h1 := aeval_eq_of_comp_neg_X_sq hk hJL x
    rw [(mem_rootSet.mp hx).2, mul_zero] at h1
    rw [← hq]
    exact h1.symm⟩

set_option linter.unusedSectionVars false in -- uniform signature with `squareToRoot`
omit hJ0 in
theorem coe_squareToRoot (hJ0 : J.coeff 0 ≠ 0) (q : squares (L.rootSet L.SplittingField)) :
    (squareToRoot hk hJL hJ0 q : L.SplittingField) = -(q : L.SplittingField) := (rfl)

theorem squareToRoot_injective : Function.Injective (squareToRoot hk hJL hJ0) := by
  intro q q' h
  have := congrArg Subtype.val h
  rw [coe_squareToRoot, coe_squareToRoot, neg_inj] at this
  exact Subtype.ext this

include hJ

theorem nat_card_squares_of_comp_neg_X_sq :
    Nat.card (squares (L.rootSet L.SplittingField)) = J.natDegree := by
  have hL := separable_of_comp_neg_X_sq hk hJL hJ hJ0
  have h2 := nat_card_eq_two_mul_nat_card_squares (s := L.rootSet L.SplittingField)
    two_ne_zero (zero_not_mem_rootSet_of_comp_neg_X_sq hk hJL hJ0)
    (fun x hx => neg_mem_rootSet_of_comp_neg_X_sq hk hJL hx)
  rw [Nat.card_eq_fintype_card, card_rootSet_eq_natDegree hL (SplittingField.splits L),
    natDegree_of_comp_neg_X_sq hk hJL] at h2
  omega

set_option linter.unusedSectionVars false in -- uniform signature of the section
theorem nat_card_rootSet_le (E : Type*) [Field E] [Algebra F E] :
    Nat.card (J.rootSet E) ≤ J.natDegree := by
  classical
  rw [rootSet_def, Nat.card_coe_set_eq, Set.ncard_coe_finset]
  calc (J.aroots E).toFinset.card ≤ Multiset.card (J.aroots E) := Multiset.toFinset_card_le _
    _ ≤ (J.map (algebraMap F E)).natDegree := card_roots' _
    _ = J.natDegree := natDegree_map _

/-- `J` splits in the splitting field of `L`. -/
theorem splits_of_comp_neg_X_sq : (J.map (algebraMap F L.SplittingField)).Splits := by
  classical
  rw [splits_iff_card_roots, natDegree_map]
  refine le_antisymm ((card_roots' _).trans (natDegree_map _).le) ?_
  have h1 := Nat.card_le_card_of_injective _ (squareToRoot_injective hk hJL hJ0)
  rw [nat_card_squares_of_comp_neg_X_sq hk hJL hJ hJ0, rootSet_def, Nat.card_coe_set_eq,
    Set.ncard_coe_finset] at h1
  exact h1.trans (Multiset.toFinset_card_le _)

/-- The squares of the roots of `L` correspond bijectively to the roots of `J`. -/
noncomputable def squareRootEquiv :
    squares (L.rootSet L.SplittingField) ≃ J.rootSet L.SplittingField :=
  Equiv.ofBijective _ ((squareToRoot_injective hk hJL hJ0).bijective_of_nat_card_le (by
    rw [nat_card_squares_of_comp_neg_X_sq hk hJL hJ hJ0]
    exact nat_card_rootSet_le hk hJL hJ hJ0 _))

theorem coe_squareRootEquiv (q : squares (L.rootSet L.SplittingField)) :
    (squareRootEquiv hk hJL hJ hJ0 q : L.SplittingField) = -(q : L.SplittingField) := (rfl)

/-- **The squares bridge.** If `J(-X²) = k L` with `J` separable, `J(0) ≠ 0` and
`Gal(J/F) = S_n`, then the Galois group of `L` acts on the opposite root pairs as the full
symmetric group. -/
theorem map_pairPerm_range_galPerm_eq_top (hsym : GaloisGroupIsSymmetric J) :
    ((galPerm L).range.subgroupOf (negCommPerm (L.rootSet L.SplittingField))).map pairPerm =
      ⊤ := by
  set E := L.SplittingField
  have hfact : Fact ((J.map (algebraMap F E)).Splits) :=
    ⟨splits_of_comp_neg_X_sq hk hJL hJ hJ0⟩
  set ψ := Gal.rootsEquivRootsAux J E with hψ
  set Φ := (squareRootEquiv hk hJL hJ hJ0).trans ψ.symm with hΦ
  have key : ∀ (σ : L.Gal) (hσ : galPerm L σ ∈ negCommPerm (L.rootSet E)),
      galPerm J (Gal.restrict J E σ) = Φ.permCongr (pairPerm ⟨galPerm L σ, hσ⟩) := by
    intro σ hσ
    ext1 y
    rw [Equiv.permCongr_apply]
    apply ψ.injective
    have h1 : ψ (galPerm J (Gal.restrict J E σ) y) = Gal.restrict J E σ • ψ y := by
      rw [hψ, Gal.smul_def, Equiv.symm_apply_apply, galPerm_apply]
    rw [h1, hΦ, Equiv.trans_apply, Equiv.apply_symm_apply]
    apply Subtype.ext
    have h3 := Gal.restrict_smul (p := J) (E := E) σ (ψ y)
    rw [h3]
    obtain ⟨x, hx⟩ := toSquare_surjective ((squareRootEquiv hk hJL hJ hJ0).symm (ψ y))
    have hψy : ψ y = squareRootEquiv hk hJL hJ hJ0 (toSquare x) := by
      rw [hx, Equiv.apply_symm_apply]
    rw [Equiv.symm_trans_apply, Equiv.symm_symm, ← hx, pairPerm_apply_toSquare, hψy,
      coe_squareRootEquiv, coe_squareRootEquiv]
    change σ (-((x : E) ^ 2)) = -(((galPerm L σ x : L.rootSet E) : E) ^ 2)
    rw [galPerm_apply, map_neg, map_pow]
    rfl
  rw [eq_top_iff]
  intro π _
  rw [galoisGroupIsSymmetric_iff] at hsym
  obtain ⟨τ, hτ⟩ := hsym.2 (Φ.permCongr π)
  obtain ⟨σ, rfl⟩ := Gal.restrict_surjective J E τ
  have hσ : galPerm L σ ∈ negCommPerm (L.rootSet E) :=
    range_galPerm_le_negCommPerm L (MonoidHom.mem_range.mpr ⟨σ, rfl⟩)
  refine Subgroup.mem_map.mpr ⟨⟨galPerm L σ, hσ⟩,
    Subgroup.mem_subgroupOf.mpr (MonoidHom.mem_range.mpr ⟨σ, rfl⟩), ?_⟩
  exact Φ.permCongr.injective ((key σ hσ).symm.trans hτ)

end Restrict

end ArithmeticOfJacobiPolynomials
