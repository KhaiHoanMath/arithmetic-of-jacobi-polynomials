/-! ### An odd discriminant valuation gives an odd element in every inertia group -/

section Even

variable {L : Type*} [Field L] {v : Valuation L (WithZero (Multiplicative ℤ))} {p : ℕ}
  [Fact p.Prime]

/-- For a valuation `v` restricting to the `p`-adic one on `ℤ`, `v(N) = v(p)^{v_p(N)}`. -/
theorem valuation_intCast_eq_pow (hv : IsAdicAt v p) {N : ℤ} (hN : N ≠ 0) :
    v (N : L) = v (p : L) ^ padicValInt p N := by
  obtain ⟨c, hc⟩ := padicValInt_dvd (p := p) N
  have hpc : ¬ (p : ℤ) ∣ c := by
    rintro ⟨d, rfl⟩
    rcases (padicValInt_dvd_iff (p := p) (padicValInt p N + 1) N).mp
      ⟨d, by linear_combination hc⟩ with h | h
    · exact hN h
    · omega
  have e : v (N : L) = v ((((p : ℤ) ^ padicValInt p N * c : ℤ)) : L) := by rw [← hc]
  rw [e, Int.cast_mul, Int.cast_pow, Int.cast_natCast, v.map_mul, v.map_pow, hv.eq_one hpc,
    mul_one]

/-- If `v` restricts to the `p`-adic valuation on `ℤ` with `v(p) = exp(-1)` (no ramification),
and a nonzero rational `r` is a square `z²` in `L`, then `v_p(r)` is even. -/
theorem even_padicValRat_of_sq_eq [Algebra ℚ L] (hv : IsAdicAt v p)
    (hvp : v (p : L) = WithZero.exp (-1)) {z : L} {r : ℚ} (hr : r ≠ 0)
    (hz : z ^ 2 = algebraMap ℚ L r) : Even (padicValRat p r) := by
  have hnum : r.num ≠ 0 := Rat.num_ne_zero.mpr hr
  have hden : (r.den : ℤ) ≠ 0 := by exact_mod_cast r.den_ne_zero
  have h1 : z ^ 2 * ((r.den : ℤ) : L) = ((r.num : ℤ) : L) := by
    rw [hz, Int.cast_natCast, ← map_natCast (algebraMap ℚ L) r.den,
      ← map_intCast (algebraMap ℚ L) r.num, ← map_mul, Rat.mul_den_eq_num]
  have hz0 : z ≠ 0 := by
    rintro rfl
    rw [zero_pow two_ne_zero, eq_comm, map_eq_zero] at hz
    exact hr hz
  have hvz : v z ≠ 0 := by rwa [Ne, Valuation.zero_iff]
  have key := congrArg v h1
  rw [v.map_mul, v.map_pow, valuation_intCast_eq_pow hv hden, valuation_intCast_eq_pow hv hnum,
    hvp, ← WithZero.exp_log hvz] at key
  simp only [← WithZero.exp_nsmul, ← WithZero.exp_add] at key
  have key' := WithZero.exp_injective key
  rw [padicValRat_def, ← padicValInt.of_nat]
  refine ⟨-WithZero.log (v z), ?_⟩
  simp only [nsmul_eq_mul] at key'
  push_cast at key'
  linarith

end Even

section OddInertia

variable {K : Type*} [Field K] [NumberField K] [IsGalois ℚ K]

/-- The inertia field `K^{I_P}` of a prime `P` of `𝓞 K`. -/
noncomputable abbrev inertiaField (P : Ideal (𝓞 K)) : IntermediateField ℚ K :=
  IntermediateField.fixedField (P.inertia Gal(K/ℚ))

/-- **The inertia field is unramified.** If `P` lies over `p`, its contraction to the inertia
field `K^{I_P}` has ramification index `1` over `p`. -/
theorem ramificationIdx_under_inertiaField {p : ℕ} [Fact p.Prime] (P : Ideal (𝓞 K))
    [P.IsPrime] [P.LiesOver (Ideal.span {(p : ℤ)})] :
    (P.under (𝓞 (inertiaField P))).ramificationIdx ℤ = 1 := by
  have hspan := InertiaCycle.span_prime_isPrime p
  have hPQ : P.LiesOver (P.under (𝓞 (inertiaField P))) := ⟨rfl⟩
  have hQp : (P.under (𝓞 (inertiaField P))).LiesOver (Ideal.span {(p : ℤ)}) :=
    ⟨by rw [Ideal.under_under]; exact Ideal.over_def P _⟩
  have h1 : Nat.card (P.inertia Gal(K/ℚ)) = P.ramificationIdx ℤ := by
    rw [Ideal.card_inertia_eq_ramificationIdxIn (Ideal.span {(p : ℤ)}) P]
    exact Ideal.ramificationIdxIn_eq_ramificationIdx _ P Gal(K/ℚ)
  have hfix : (inertiaField P).fixingSubgroup = P.inertia Gal(K/ℚ) :=
    IntermediateField.fixingSubgroup_fixedField (H := P.inertia Gal(K/ℚ))
  have htop : P.inertia Gal(K/inertiaField P) = ⊤ := by
    ext σ
    simp only [Subgroup.mem_top, iff_true]
    have hσ : (((IntermediateField.fixingSubgroupEquiv (inertiaField P)).symm σ :
        (inertiaField P).fixingSubgroup) : Gal(K/ℚ)) ∈ P.inertia Gal(K/ℚ) := by
      rw [← hfix]
      exact ((IntermediateField.fixingSubgroupEquiv (inertiaField P)).symm σ).2
    rw [Ideal.mem_inertia]
    exact Ideal.mem_inertia.mp hσ
  have hcard : Nat.card Gal(K/inertiaField P) = Nat.card (P.inertia Gal(K/ℚ)) := by
    rw [← hfix]
    exact (Nat.card_congr (IntermediateField.fixingSubgroupEquiv (inertiaField P)).toEquiv).symm
  have h2 : Nat.card (P.inertia Gal(K/ℚ)) = P.ramificationIdx (𝓞 (inertiaField P)) := by
    rw [← Ideal.ramificationIdxIn_eq_ramificationIdx (P.under (𝓞 (inertiaField P))) P
        Gal(K/inertiaField P),
      ← Ideal.card_inertia_eq_ramificationIdxIn (G := Gal(K/inertiaField P))
        (P.under (𝓞 (inertiaField P))) P, htop, Subgroup.card_top, hcard]
  have h3 := Ideal.ramificationIdx_tower (R := ℤ) (q := P.under (𝓞 (inertiaField P))) (r := P)
  have hpos : 0 < Nat.card (P.inertia Gal(K/ℚ)) := Nat.card_pos
  rw [← h1, ← h2] at h3
  exact Nat.eq_of_mul_eq_mul_right hpos (h3.symm.trans (one_mul _).symm)

/-- **Odd valuation forces a nontrivial inertia action.** Let `K/ℚ` be Galois, `P` a prime of
`𝓞 K` over `p`, and `y ∈ K` with `y² = r ∈ ℚ^×` and `v_p(r)` odd. Then some element of the
inertia group `I_P` moves `y`. -/
theorem exists_mem_inertia_apply_ne_of_odd {p : ℕ} [Fact p.Prime] (P : Ideal (𝓞 K))
    [P.IsPrime] [P.LiesOver (Ideal.span {(p : ℤ)})] {y : K} {r : ℚ} (hr : r ≠ 0)
    (hy : y ^ 2 = algebraMap ℚ K r) (hodd : Odd (padicValRat p r)) :
    ∃ σ ∈ P.inertia Gal(K/ℚ), σ y ≠ y := by
  by_contra hcon
  push Not at hcon
  have hyT : y ∈ inertiaField P :=
    (IntermediateField.mem_fixedField_iff (H := P.inertia Gal(K/ℚ)) (x := y)).mpr
      fun σ hσ => hcon σ hσ
  have hz : (⟨y, hyT⟩ : inertiaField P) ^ 2 = algebraMap ℚ (inertiaField P) r := by
    apply (algebraMap (inertiaField P) K).injective
    rw [map_pow, ← IsScalarTower.algebraMap_apply]
    exact hy
  have hspan := Int.ideal_span_isMaximal_of_prime p
  have hQp : (P.under (𝓞 (inertiaField P))).LiesOver (Ideal.span {(p : ℤ)}) :=
    ⟨by rw [Ideal.under_under]; exact Ideal.over_def P _⟩
  have hQmax : (P.under (𝓞 (inertiaField P))).IsMaximal :=
    Ideal.IsMaximal.of_liesOver_isMaximal _ (Ideal.span {(p : ℤ)})
  have hQ0 : P.under (𝓞 (inertiaField P)) ≠ ⊥ := Ideal.IsMaximal.ne_bot_of_isIntegral_int _
  let w : HeightOneSpectrum (𝓞 (inertiaField P)) :=
    ⟨P.under (𝓞 (inertiaField P)), hQmax.isPrime, hQ0⟩
  have : w.asIdeal.LiesOver (Ideal.span {(p : ℤ)}) := hQp
  have hvp : w.valuation (inertiaField P) (p : inertiaField P) = WithZero.exp (-1) := by
    rw [InertiaCycle.valuation_prime_eq (p := p) w,
      show w.asIdeal.ramificationIdx ℤ = 1 from ramificationIdx_under_inertiaField (p := p) P,
      Nat.cast_one]
  exact (Int.not_even_iff_odd.mpr hodd)
    (even_padicValRat_of_sq_eq (InertiaCycle.isAdicAt (p := p) w) hvp hr hz)

end OddInertia

end UnequalParameters

open UnequalParameters

open Classical in
/-- **An odd element in every inertia group** (fixed-field assertion of Theorem 1.3).
Conditional on the Jacobi discriminant formula (5.31) (`hdisc`): if `P_n^{(a,b)}` is separable
of degree `n` and `v_p` of its discriminant is odd, then every inertia group at a prime above
`p` in `Gal(P_n^{(a,b)}/ℚ)` contains an odd permutation of the roots. -/
theorem exists_mem_inertia_sign_galPerm_eq_neg_one (hdisc : JacobiDiscriminantFormula)
    (a b n : ℕ) (hsep : (jacobiP a b n).Separable) (hdeg : (jacobiP a b n).natDegree = n)
    {p : ℕ} [Fact p.Prime] (hodd : Odd (padicValRat p (jacobiDiscriminant a b n)))
    (P : Ideal (𝓞 (jacobiP a b n).SplittingField)) [P.IsPrime]
    [P.LiesOver (Ideal.span {(p : ℤ)})] :
    ∃ σ : (jacobiP a b n).Gal, σ ∈ P.inertia Gal((jacobiP a b n).SplittingField/ℚ) ∧
      Equiv.Perm.sign (galPerm (jacobiP a b n) σ) = -1 := by
  have : NumberField (jacobiP a b n).SplittingField := ⟨⟩
  have : IsGalois ℚ (jacobiP a b n).SplittingField := IsGalois.mk
  have hcard : Fintype.card ((jacobiP a b n).rootSet (jacobiP a b n).SplittingField) = n := by
    rw [card_rootSet_eq_natDegree hsep (SplittingField.splits _), hdeg]
  obtain ⟨e⟩ : Nonempty (Fin n ≃ (jacobiP a b n).rootSet (jacobiP a b n).SplittingField) :=
    ⟨(Fintype.equivFinOfCardEq hcard).symm⟩
  -- even elements fix the Vandermonde product
  have hfix : ∀ σ : (jacobiP a b n).Gal, Equiv.Perm.sign (galPerm (jacobiP a b n) σ) = 1 →
      σ (∏ i, ∏ j ∈ Finset.Ioi i, ((e j : (jacobiP a b n).SplittingField) - e i)) =
        ∏ i, ∏ j ∈ Finset.Ioi i, ((e j : (jacobiP a b n).SplittingField) - e i) := by
    intro σ hσ1
    have hπ : ∀ i, ((e ((e.symm.permCongr (galPerm (jacobiP a b n) σ)) i) :
        (jacobiP a b n).SplittingField)) = σ (e i : (jacobiP a b n).SplittingField) := by
      intro i
      rw [Equiv.permCongr_apply, Equiv.symm_symm, Equiv.apply_symm_apply]
      rfl
    have hsign : Equiv.Perm.sign (e.symm.permCongr (galPerm (jacobiP a b n) σ)) = 1 := by
      rw [Equiv.Perm.sign_permCongr]; exact hσ1
    have h1 : σ (∏ i, ∏ j ∈ Finset.Ioi i, ((e j : (jacobiP a b n).SplittingField) - e i)) =
        ∏ i, ∏ j ∈ Finset.Ioi i,
          (((e ((e.symm.permCongr (galPerm (jacobiP a b n) σ)) j)) :
            (jacobiP a b n).SplittingField) -
          e ((e.symm.permCongr (galPerm (jacobiP a b n) σ)) i)) := by
      simp only [map_prod, map_sub, hπ]
    have h3 : Matrix.vandermonde (fun i =>
          ((e ((e.symm.permCongr (galPerm (jacobiP a b n) σ)) i)) :
            (jacobiP a b n).SplittingField)) =
        (Matrix.vandermonde (fun i => (e i : (jacobiP a b n).SplittingField))).submatrix
          (e.symm.permCongr (galPerm (jacobiP a b n) σ)) id := by
      ext i j
      simp [Matrix.vandermonde_apply]
    rw [h1, ← Matrix.det_vandermonde, h3, Matrix.det_permute, hsign, Matrix.det_vandermonde]
    simp
  -- the factorization over the splitting field
  have hroots : ((jacobiP a b n).map (algebraMap ℚ (jacobiP a b n).SplittingField)).roots =
      Finset.univ.val.map (fun i => (e i : (jacobiP a b n).SplittingField)) := by
    have hnd : (Finset.univ.val.map (fun i => (e i : (jacobiP a b n).SplittingField))).Nodup :=
      Finset.univ.nodup.map (fun i j h => e.injective (Subtype.val_injective h))
    rw [Multiset.Nodup.ext (nodup_roots hsep.map) hnd]
    intro y
    rw [Multiset.mem_map]
    constructor
    · intro hy
      have hy' : y ∈ (jacobiP a b n).rootSet (jacobiP a b n).SplittingField := by
        rw [rootSet_def, Finset.mem_coe, Multiset.mem_toFinset, aroots_def]; exact hy
      exact ⟨e.symm ⟨y, hy'⟩, Finset.mem_univ_val _, by simp⟩
    · rintro ⟨i, -, rfl⟩
      have key : ∀ z : (jacobiP a b n).SplittingField,
          z ∈ (jacobiP a b n).rootSet (jacobiP a b n).SplittingField →
            z ∈ ((jacobiP a b n).map (algebraMap ℚ (jacobiP a b n).SplittingField)).roots := by
        intro z hz
        rw [rootSet_def, Finset.mem_coe, Multiset.mem_toFinset, aroots_def] at hz
        exact hz
      exact key _ (e i).2
  have hfac : (jacobiP a b n).map (algebraMap ℚ (jacobiP a b n).SplittingField) =
      C (algebraMap ℚ (jacobiP a b n).SplittingField (jacobiP a b n).leadingCoeff) *
        ∏ i, (polyX - C (e i : (jacobiP a b n).SplittingField)) := by
    have hspl := SplittingField.splits (jacobiP a b n)
    conv_lhs => rw [hspl.eq_prod_roots, hroots, leadingCoeff_map]
    rw [Multiset.map_map, Finset.prod_eq_multiset_prod]
    all_goals rfl
  have hd : algebraMap ℚ (jacobiP a b n).SplittingField
        ((jacobiP a b n).leadingCoeff ^ (2 * n - 2)) *
        ∏ i, ∏ j ∈ Finset.Ioi i, ((e i : (jacobiP a b n).SplittingField) - e j) ^ 2 =
      algebraMap ℚ (jacobiP a b n).SplittingField (jacobiDiscriminant a b n) :=
    hdisc.rat a b n _ (fun i => (e i : (jacobiP a b n).SplittingField)) hfac
  have hsq : ∏ i, ∏ j ∈ Finset.Ioi i,
        ((e i : (jacobiP a b n).SplittingField) - e j) ^ 2 =
      (∏ i, ∏ j ∈ Finset.Ioi i, ((e j : (jacobiP a b n).SplittingField) - e i)) ^ 2 := by
    rw [← Finset.prod_pow]
    refine Finset.prod_congr rfl fun i _ => ?_
    rw [← Finset.prod_pow]
    refine Finset.prod_congr rfl fun j _ => ?_
    ring
  -- `δ² = disc / lc^{2n-2}` has odd valuation
  have hlc : (jacobiP a b n).leadingCoeff ≠ 0 := leadingCoeff_ne_zero.mpr hsep.ne_zero
  have hD0 : jacobiDiscriminant a b n ≠ 0 := by
    intro h
    rw [h, padicValRat.zero] at hodd
    exact (Int.not_odd_iff_even.mpr Even.zero) hodd
  have hl0 : algebraMap ℚ (jacobiP a b n).SplittingField
      ((jacobiP a b n).leadingCoeff ^ (2 * n - 2)) ≠ 0 :=
    (_root_.map_ne_zero _).mpr (pow_ne_zero _ hlc)
  have hy : (∏ i, ∏ j ∈ Finset.Ioi i, ((e j : (jacobiP a b n).SplittingField) - e i)) ^ 2 =
      algebraMap ℚ (jacobiP a b n).SplittingField
        (jacobiDiscriminant a b n / (jacobiP a b n).leadingCoeff ^ (2 * n - 2)) := by
    rw [map_div₀, eq_div_iff hl0, ← hd, hsq]
    ring
  have hr : jacobiDiscriminant a b n / (jacobiP a b n).leadingCoeff ^ (2 * n - 2) ≠ 0 :=
    div_ne_zero hD0 (pow_ne_zero _ hlc)
  have hoddr : Odd (padicValRat p
      (jacobiDiscriminant a b n / (jacobiP a b n).leadingCoeff ^ (2 * n - 2))) := by
    rw [padicValRat.div hD0 (pow_ne_zero _ hlc), padicValRat.pow]
    have h2 : ((2 * n - 2 : ℕ) : ℤ) = 2 * ((n - 1 : ℕ) : ℤ) := by omega
    rw [h2]
    obtain ⟨k, hk⟩ := hodd
    exact ⟨k - ((n - 1 : ℕ) : ℤ) * padicValRat p (jacobiP a b n).leadingCoeff,
      by rw [hk]; ring⟩
  obtain ⟨σ, hσI, hσ⟩ := exists_mem_inertia_apply_ne_of_odd P hr hy hoddr
  refine ⟨σ, hσI, ?_⟩
  rcases Int.units_eq_one_or (Equiv.Perm.sign (galPerm (jacobiP a b n) σ)) with h | h
  · exact absurd (hfix σ h) hσ
  · exact h

/-! ### Normal generation -/

open Equiv Equiv.Perm in
/-- **Every proper normal subgroup of `S_n` lies in `A_n` for `n ≥ 5`** (the last step of the
proof of the fixed-field assertion): a normal subgroup of the symmetric group on at least five
points that contains an odd permutation is the whole group. -/
theorem eq_top_of_normal_of_sign_eq_neg_one {α : Type*} [Fintype α] [DecidableEq α]
    (h5 : 5 ≤ Fintype.card α) {H : Subgroup (Perm α)} (hH : H.Normal) {τ : Perm α}
    (hτH : τ ∈ H) (hτ : sign τ = -1) : H = ⊤ := by
  have hnt : Nontrivial H := ⟨⟨⟨τ, hτH⟩, 1, fun h => by
    have : τ = 1 := congrArg Subtype.val h
    rw [this, map_one] at hτ
    exact absurd hτ (by decide)⟩⟩
  have halt : alternatingGroup α ≤ H := by
    have := hH
    exact alternatingGroup_le_of_normal (by rwa [Nat.card_eq_fintype_card]) hnt
  rw [eq_top_iff]
  intro π _
  rcases Int.units_eq_one_or (sign π) with h | h
  · exact halt (mem_alternatingGroup.2 h)
  · have hπτ : π * τ⁻¹ ∈ H :=
      halt (mem_alternatingGroup.2 (by rw [map_mul, map_inv, h, hτ]; rfl))
    simpa using H.mul_mem hπτ hτH

open Classical in
/-- If `Gal(f/ℚ) = S_n` with `n ≥ 5`, a normal subgroup containing an element acting by an odd
permutation of the roots is the whole group. -/
theorem eq_top_of_normal_of_galPerm_odd {f : ℚ[X]} (hS : GaloisGroupIsSymmetric f)
    (h5 : 5 ≤ Fintype.card (f.rootSet f.SplittingField))
    {M : Subgroup f.Gal} (hM : M.Normal) {τ : f.Gal} (hτM : τ ∈ M)
    (hτ : Equiv.Perm.sign (galPerm f τ) = -1) : M = ⊤ := by
  have hbij := (galoisGroupIsSymmetric_iff f).mp hS
  have hMap : (M.map (galPerm f)).Normal := hM.map _ hbij.2
  have htop := eq_top_of_normal_of_sign_eq_neg_one h5 hMap (Subgroup.mem_map_of_mem _ hτM) hτ
  rw [eq_top_iff]
  intro g _
  have hg : galPerm f g ∈ M.map (galPerm f) := by rw [htop]; exact Subgroup.mem_top _
  obtain ⟨x, hx, hxg⟩ := Subgroup.mem_map.mp hg
  rwa [← hbij.1 hxg]

/-! ### The wild cycle inside an inertia group -/

open Classical in
/-- **The wild `p`-cycle of Lemma 5.16 in an inertia group.** Under the hypotheses of Lemma
5.16 on `a > b`, `m` and the prime `p` (irreducibility is not needed), every inertia group at a
prime above `p` in `Gal(P_n^{(a,b)}/ℚ)` contains an element acting on the roots as a single
`p`-cycle. This theorem and its `a < b` companion use the valuation argument of
`UnequalParametersWild`. The fixed-field assertion uses an odd inertia element. -/
theorem exists_isCycle_galPerm_mem_inertia_jacobiP_of_prime {a b m δ : ℕ} (hab : b < a)
    (hδ : δ ≤ 1) (hm : 2 * (a + b) + 10 ≤ m) {p : ℕ} (hp : p.Prime)
    (hp1 : 3 * (2 * m + δ) < 4 * p) (hp2 : 8 * p ≤ 7 * (2 * m + δ))
    (hW : ¬ (p : ℤ) ∣ (galoisNumerator a b δ).eval (m : ℤ))
    (P : Ideal (𝓞 (jacobiP a b (2 * m + δ)).SplittingField)) [P.IsPrime]
    [P.LiesOver (Ideal.span {(p : ℤ)})] :
    ∃ σ : (jacobiP a b (2 * m + δ)).Gal,
      σ ∈ P.inertia Gal((jacobiP a b (2 * m + δ)).SplittingField/ℚ) ∧
      (galPerm (jacobiP a b (2 * m + δ)) σ).IsCycle ∧
      (galPerm (jacobiP a b (2 * m + δ)) σ).support.card = p := by
  have hpF : Fact p.Prime := ⟨hp⟩
  -- arithmetic
  have hpM : m + (a + b) + 2 < p := by omega
  have hp2' : p ≠ 2 := by omega
  have hp2m : p ≤ 2 * m := by omega
  obtain ⟨t, ht⟩ := hp.odd_of_ne_two hp2'
  -- `j = n - p = 2k + (1 - δ)`
  obtain ⟨k, hk⟩ : ∃ k, k = m + δ - (t + 1) := ⟨_, rfl⟩
  have hj : 2 * m + δ - p = 2 * k + (1 - δ) := by omega
  have hk2 : 2 * k < p := by omega
  -- `p ∤ T`
  have hT : ¬ p ∣ ∏ i ∈ Finset.Icc 1 (a + b), (2 * m + δ + i) := by
    intro h
    obtain ⟨i, hi, hdvd⟩ := (Prime.dvd_finsetProd_iff hp.prime _).mp h
    rw [Finset.mem_Icc] at hi
    exact Nat.not_dvd_of_lt_of_lt_mul_succ (k := 1) (by omega) (by omega) hdvd
  -- the reduction `f̄ = x^p \bar{P_j}` (Lemma 3.3)
  have hred := (jacobiP_reduction (p := p) hab hδ hm hp2' hpM hT
    (fun k => jacobiP_ode (a : ℚ) b k) (ε := 1) (j := 2 * m + δ - p) le_rfl (by omega)
    (by omega)).2.1
  rw [ratReduction_jacobiP hp2', ratReduction_jacobiP hp2', one_mul, hj] at hred
  have hun : (((1 / 2 : ℚ) ^ (2 * m + δ) : ℚ) : ZMod p) ≠ 0 :=
    left_ne_zero_of_mul_eq_one (ratCast_one_div_two_pow_mul hp2' _)
  have huj : (((1 / 2 : ℚ) ^ (2 * k + (1 - δ)) : ℚ) : ZMod p) ≠ 0 :=
    left_ne_zero_of_mul_eq_one (ratCast_one_div_two_pow_mul hp2' _)
  have hcoeff : ∀ i, (((1 / 2 : ℚ) ^ (2 * m + δ) : ℚ) : ZMod p) *
      ((jacobiNum a b (2 * m + δ)).coeff i : ZMod p) =
      if p ≤ i then (((1 / 2 : ℚ) ^ (2 * k + (1 - δ)) : ℚ) : ZMod p) *
        ((jacobiNum a b (2 * k + (1 - δ))).coeff (i - p) : ZMod p) else 0 := by
    intro i
    have := congrArg (fun q : (ZMod p)[X] => q.coeff i) hred
    simp only [coeff_C_mul, coeff_map, eq_intCast, coeff_X_pow_mul'] at this
    exact this
  -- the coefficients below `x^p`
  have hlow : ∀ i < p, (p : ℤ) ∣ (jacobiNum a b (2 * m + δ)).coeff i := by
    intro i hi
    have h := hcoeff i
    rw [ite_eq_right (show ¬ p ≤ i by omega), mul_eq_zero] at h
    exact (ZMod.intCast_zmod_eq_zero_iff_dvd _ _).mp (h.resolve_left hun)
  -- the numerators modulo `p`
  have hWZ : (((galoisNumerator a b δ).eval (m : ℤ) : ℤ) : ZMod p) ≠ 0 := by
    rw [Ne, ZMod.intCast_zmod_eq_zero_iff_dvd]; exact hW
  rw [galoisNumerator_eq, eval_mul, Int.cast_mul] at hWZ
  have hAm : (((centralA a b δ).eval (m : ℤ) : ℤ) : ZMod p) ≠ 0 := left_ne_zero_of_mul hWZ
  have hCm := right_ne_zero_of_mul hWZ
  have hzw : (2 : ZMod p) * k = 2 * m + (2 * δ - 1) := by
    have h := congrArg (Nat.cast : ℕ → ZMod p) (show 2 * k + p + 1 = 2 * m + 2 * δ by omega)
    simp only [Nat.cast_add, Nat.cast_mul, Nat.cast_ofNat, Nat.cast_one, ZMod.natCast_self] at h
    linear_combination h
  rw [intCast_oppositeNumerator_eval a b δ m k hzw] at hCm
  have hAk : (((centralA a b (1 - δ)).eval (k : ℤ) : ℤ) : ZMod p) ≠ 0 :=
    right_ne_zero_of_mul hCm
  have h2ne : ∀ e : ℕ, (2 : ZMod p) ^ e ≠ 0 := fun e => by
    have := natCast_two_pow_ne_zero (p := p) hp2' e
    push_cast at this
    exact this
  have hsgn : ∀ e : ℕ, ((-1 : ZMod p)) ^ e ≠ 0 := fun e =>
    pow_ne_zero _ (neg_ne_zero.mpr one_ne_zero)
  -- the residual factor is a unit at zero
  have hg0 : ¬ (p : ℤ) ∣ (jacobiNum a b (2 * k + (1 - δ))).coeff 0 := by
    intro h
    have hZ := congrArg (Int.cast : ℤ → ZMod p)
      (coeff_zero_jacobiNum_mul a b k (1 - δ) hab (by omega))
    simp only [Int.cast_mul, Int.cast_pow, Int.cast_neg, Int.cast_one, Int.cast_ofNat,
      Int.cast_natCast] at hZ
    rw [(ZMod.intCast_zmod_eq_zero_iff_dvd _ _).mpr h, zero_mul] at hZ
    exact mul_ne_zero (mul_ne_zero (mul_ne_zero (hsgn k) (h2ne _))
      (natCast_choose_ne_zero (N := 2 * k) (k := k) hk2 (by omega))) hAk hZ.symm
  have hpp : ¬ (p : ℤ) ∣ (jacobiNum a b (2 * m + δ)).coeff p := by
    intro h
    have hc := hcoeff p
    rw [ite_eq_left le_rfl, Nat.sub_self, (ZMod.intCast_zmod_eq_zero_iff_dvd _ _).mpr h,
      mul_zero] at hc
    exact hg0 ((ZMod.intCast_zmod_eq_zero_iff_dvd _ _).mp
      ((mul_eq_zero.mp hc.symm).resolve_left huj))
  -- `p ∥ f(0)`
  have h0 : ¬ (p : ℤ) ^ 2 ∣ (jacobiNum a b (2 * m + δ)).coeff 0 := by
    intro h
    obtain ⟨u, hu, hpu⟩ := exists_choose_eq_mul (p := p) (m := m) (by omega) hp2m
    have hid := coeff_zero_jacobiNum_mul a b m δ hab hδ
    rw [hu] at hid
    have hdvd : (p : ℤ) * p ∣ (p : ℤ) * ((-1) ^ m * 2 ^ δ * (u : ℤ) *
        (centralA a b δ).eval (m : ℤ)) := by
      have := dvd_mul_of_dvd_left h ((centralD a b δ).eval (m : ℤ))
      rw [hid, sq] at this
      convert this using 1
      push_cast; ring
    rw [mul_dvd_mul_iff_left (Nat.cast_ne_zero.mpr hp.ne_zero : (p : ℤ) ≠ 0)] at hdvd
    have hZ := (ZMod.intCast_zmod_eq_zero_iff_dvd _ _).mpr hdvd
    simp only [Int.cast_mul, Int.cast_pow, Int.cast_neg, Int.cast_one, Int.cast_ofNat,
      Int.cast_natCast] at hZ
    have hu0 : (u : ZMod p) ≠ 0 := by rw [Ne, ZMod.natCast_eq_zero_iff]; exact hpu
    exact mul_ne_zero (mul_ne_zero (mul_ne_zero (hsgn m) (h2ne δ)) hu0) hAm hZ
  -- the leading coefficient is a unit
  have hlc : ¬ (p : ℤ) ∣ (jacobiNum a b (2 * m + δ)).leadingCoeff := by
    rw [leadingCoeff, natDegree_jacobiNum, coeff_jacobiNum_self]
    intro h
    have h' : p ∣ (2 * (2 * m + δ) + a + b).choose (2 * m + δ) := by exact_mod_cast h
    have hv := padicValNat_choose_eq_div (p := p) (N := 2 * (2 * m + δ) + a + b)
      (k := 2 * m + δ) (by omega) (by nlinarith)
    rw [Nat.div_eq_of_lt_le (k := 2) (n := p) (m := 2 * (2 * m + δ) + a + b) (by omega)
        (by omega),
      Nat.div_eq_of_lt_le (k := 1) (n := p) (m := 2 * m + δ) (by omega) (by omega),
      show 2 * (2 * m + δ) + a + b - (2 * m + δ) = 2 * m + δ + (a + b) by omega,
      Nat.div_eq_of_lt_le (k := 1) (n := p) (m := 2 * m + δ + (a + b)) (by omega)
        (by omega)] at hv
    exact ((dvd_iff_padicValNat_ne_zero (Nat.choose_pos (by omega)).ne').mp h') (by omega)
  -- the wild `p`-cycle
  have hc : ((1 / 2 : ℚ) ^ (2 * m + δ)) ≠ 0 := by positivity
  have hdegZ : (jacobiNum a b (2 * m + δ)).natDegree < 2 * p := by
    rw [natDegree_jacobiNum]; omega
  exact exists_isCycle_galPerm_mem_inertia_of_wild hp hc
    (jacobiP_eq_C_mul_map_jacobiNum a b (2 * m + δ)) hdegZ hlc hlow h0 hpp P

open Classical in
/-- Transport of an inertia cycle along `g = a f(bX + c)`: some prime of the splitting field of
`g` above `p` has an inertia element acting on the roots of `g` as a single `d`-cycle. -/
theorem exists_mem_inertia_isCycle_of_affine {f g : ℚ[X]} {a b c : ℚ} (ha : a ≠ 0)
    (hb : b ≠ 0) (hg : g = C a * f.comp (C b * polyX + C c)) {p d : ℕ} (σ : f.Gal)
    (hσ : (galPerm f σ).IsCycle) (hd : (galPerm f σ).support.card = d)
    (P : Ideal (𝓞 f.SplittingField)) [P.IsPrime] [P.LiesOver (Ideal.span {(p : ℤ)})]
    (hσI : σ ∈ P.inertia Gal(f.SplittingField/ℚ)) :
    ∃ Q : Ideal (𝓞 g.SplittingField), Q.IsPrime ∧ Q.LiesOver (Ideal.span {(p : ℤ)}) ∧
      ∃ τ : g.Gal, τ ∈ Q.inertia Gal(g.SplittingField/ℚ) ∧
        (galPerm g τ).IsCycle ∧ (galPerm g τ).support.card = d := by
  subst hg
  have : Fact (((C a * f.comp (C b * polyX + C c)).map (algebraMap ℚ f.SplittingField)).Splits) :=
    fact_splits_affine f c
  obtain ⟨e, he, -⟩ := exists_galPerm_restrict_eq_permCongr f c ha hb σ
  refine ⟨P.comap (RingOfIntegers.mapRingHom
      (algebraMap (C a * f.comp (C b * polyX + C c)).SplittingField f.SplittingField)),
    Ideal.IsPrime.comap _, liesOver_comap_int _ P _,
    Gal.restrict (C a * f.comp (C b * polyX + C c)) f.SplittingField σ,
    restrict_mem_inertia_comap hσI, ?_, ?_⟩
  · rw [he]; exact isCycle_permCongr e hσ
  · rw [he, card_support_permCongr, hd]

open Classical in
/-- The `p`-cycle for `P_n^{(a,b)}` with `a < b`, through the reflection
`P_n^{(a,b)}(x) = (-1)^n P_n^{(b,a)}(-x)`: the primes are those of Lemma 5.16 for `(b, a)`. -/
theorem exists_mem_inertia_isCycle_jacobiP_of_prime_of_lt {a b m δ : ℕ} (hab : a < b)
    (hδ : δ ≤ 1) (hm : 2 * (b + a) + 10 ≤ m) {p : ℕ} (hp : p.Prime)
    (hp1 : 3 * (2 * m + δ) < 4 * p) (hp2 : 8 * p ≤ 7 * (2 * m + δ))
    (hW : ¬ (p : ℤ) ∣ (galoisNumerator b a δ).eval (m : ℤ)) :
    ∃ Q : Ideal (𝓞 (jacobiP a b (2 * m + δ)).SplittingField), Q.IsPrime ∧
      Q.LiesOver (Ideal.span {(p : ℤ)}) ∧
      ∃ τ : (jacobiP a b (2 * m + δ)).Gal,
        τ ∈ Q.inertia Gal((jacobiP a b (2 * m + δ)).SplittingField/ℚ) ∧
        (galPerm (jacobiP a b (2 * m + δ)) τ).IsCycle ∧
        (galPerm (jacobiP a b (2 * m + δ)) τ).support.card = p := by
  have : Fact p.Prime := ⟨hp⟩
  have : NumberField (jacobiP b a (2 * m + δ)).SplittingField := ⟨⟩
  have := Int.ideal_span_isMaximal_of_prime p
  obtain ⟨P, hPmax, hPover⟩ : ∃ P : Ideal (𝓞 (jacobiP b a (2 * m + δ)).SplittingField),
      P.IsMaximal ∧ P.LiesOver (Ideal.span {(p : ℤ)}) :=
    Ideal.exists_maximal_ideal_liesOver_of_isIntegral _
  obtain ⟨σ, hσI, hσc, hσd⟩ :=
    exists_isCycle_galPerm_mem_inertia_jacobiP_of_prime hab hδ hm hp hp1 hp2 hW P
  exact exists_mem_inertia_isCycle_of_affine (pow_ne_zero _ (by norm_num)) (by norm_num)
    (jacobiP_eq_C_mul_comp_neg (a : ℚ) b (2 * m + δ)) σ hσc hσd P hσI

/-! ### Normal generation by inertia, and the fixed-field assertion -/

open Classical in
/-- The data of the fixed-field assertion of Theorem 1.3 for all large `n` (the beginning of its
proof): `P_n^{(a,b)}` is irreducible with group `S_n`, and there is a prime `p` with
`3n/4 < p ≤ 7n/8` and `v_p(disc)` odd. -/
theorem exists_forall_fixedField_data (hH : HansonLcmBound)
    (hZ : JacobiSimpleRealZeros) (hJordan : JordanPrimeCycleTheorem)
     (hEis : EisensteinPrimeTotallyRamified)
    (hdisc : JacobiDiscriminantFormula) (hDusart : DusartThetaBound) {a b : ℕ} (hab : a ≠ b) :
    ∃ N : ℕ, ∀ n ≥ N,
      Irreducible (jacobiP a b n) ∧ GaloisGroupIsSymmetric (jacobiP a b n) ∧ 5 ≤ n ∧
      ∃ p : ℕ, p.Prime ∧ 3 * n < 4 * p ∧ 8 * p ≤ 7 * n ∧
        Odd (padicValRat p (jacobiDiscriminant a b n)) := by
  obtain ⟨Nt, hNt⟩ :=
    exists_forall_irreducible_galoisGroupIsSymmetric_jacobiP hH hZ hJordan hEis hdisc hDusart hab
  have hodd : ∀ m δ p : ℕ, p.Prime → 2 * (a + b) + 10 ≤ m → 3 * (2 * m + δ) < 4 * p →
      8 * p ≤ 7 * (2 * m + δ) → Odd (padicValRat p (jacobiDiscriminant a b (2 * m + δ))) := by
    intro m δ p hp hm hp1 hp2
    have : Fact p.Prime := ⟨hp⟩
    rw [padicValRat_jacobiDiscriminant (p := p) (a := a) (b := b) (n := 2 * m + δ)
      (by omega) (by omega) (by omega) (by omega)]
    exact (Int.odd_coe_nat p).mpr (hp.odd_of_ne_two (by omega))
  rcases lt_or_gt_of_ne hab with h | h
  · obtain ⟨N, hN⟩ := exists_forall_galoisPrime hH hZ hDusart h
    refine ⟨N + Nt, fun n hn => ?_⟩
    obtain ⟨m, δ, hδ, rfl⟩ : ∃ m δ, δ ≤ 1 ∧ n = 2 * m + δ :=
      ⟨n / 2, n % 2, by omega, by omega⟩
    obtain ⟨hm, -, p, hp, hp1, hp2, -⟩ := hN m δ hδ (by omega)
    obtain ⟨hirr, hS⟩ := hNt (2 * m + δ) (by omega)
    exact ⟨hirr, hS, by omega, p, hp, hp1, hp2, hodd m δ p hp (by omega) hp1 hp2⟩
  · obtain ⟨N, hN⟩ := exists_forall_galoisPrime hH hZ hDusart h
    refine ⟨N + Nt, fun n hn => ?_⟩
    obtain ⟨m, δ, hδ, rfl⟩ : ∃ m δ, δ ≤ 1 ∧ n = 2 * m + δ :=
      ⟨n / 2, n % 2, by omega, by omega⟩
    obtain ⟨hm, -, p, hp, hp1, hp2, -⟩ := hN m δ hδ (by omega)
    obtain ⟨hirr, hS⟩ := hNt (2 * m + δ) (by omega)
    exact ⟨hirr, hS, by omega, p, hp, hp1, hp2, hodd m δ p hp hm hp1 hp2⟩

open Classical in
/-- **Normal generation by inertia** (fixed-field assertion of Theorem 1.3). For distinct
nonnegative integers `a, b` and any bound `R`, for all large `n` every normal subgroup of
`Gal(P_n^{(a,b)}/ℚ)` containing all inertia groups at primes `p > R` is the whole group. -/
theorem exists_forall_eq_top_of_inertia_le (hH : HansonLcmBound)
     (hZ : JacobiSimpleRealZeros) (hJordan : JordanPrimeCycleTheorem)
     (hEis : EisensteinPrimeTotallyRamified)
    (hdisc : JacobiDiscriminantFormula) (hDusart : DusartThetaBound) {a b : ℕ} (hab : a ≠ b)
    (R : ℕ) :
    ∃ N : ℕ, ∀ n ≥ N, ∀ M : Subgroup (jacobiP a b n).Gal, M.Normal →
      (∀ p : ℕ, p.Prime → R < p → ∀ (P : Ideal (𝓞 (jacobiP a b n).SplittingField)) [P.IsPrime],
        P.LiesOver (Ideal.span {(p : ℤ)}) →
          P.inertia Gal((jacobiP a b n).SplittingField/ℚ) ≤ M) →
      M = ⊤ := by
  obtain ⟨N0, hN0⟩ := exists_forall_fixedField_data hH hZ hJordan hEis hdisc hDusart hab
  refine ⟨N0 + 2 * R + 1, fun n hn M hM hle => ?_⟩
  obtain ⟨hirr, hS, h5, p, hp, hp1, hp2, hodd⟩ := hN0 n (by omega)
  have : Fact p.Prime := ⟨hp⟩
  have : NumberField (jacobiP a b n).SplittingField := ⟨⟩
  have := Int.ideal_span_isMaximal_of_prime p
  obtain ⟨Q, hQmax, hQp⟩ : ∃ Q : Ideal (𝓞 (jacobiP a b n).SplittingField),
      Q.IsMaximal ∧ Q.LiesOver (Ideal.span {(p : ℤ)}) :=
    Ideal.exists_maximal_ideal_liesOver_of_isIntegral _
  have : Q.IsPrime := hQmax.isPrime
  obtain ⟨τ, hτQ, hτ⟩ := exists_mem_inertia_sign_galPerm_eq_neg_one hdisc a b n
    hirr.separable (natDegree_jacobiP_nat a b n) hodd Q
  refine eq_top_of_normal_of_galPerm_odd hS ?_ hM (hle p hp (by omega) Q hQp hτQ) hτ
  rw [card_rootSet_of_irreducible hirr, natDegree_jacobiP_nat]
  exact h5

/-- **Addendum to Theorem 1.3** (`UnequalIntegralParametersFixedFieldStatement`).
For distinct nonnegative integers `a, b` and a number field `E`, for all sufficiently large `n`
the splitting field of `P_n^{(a,b)}` is linearly disjoint from `E` over `ℚ` (its tensor product
with `E` is a field), and `P_n^{(a,b)}` remains irreducible over `E` with Galois group `S_n`.
Conditional on [Hanson, Theorem 1] (`hH`), [DLMF, §18.2(vi)] (`hZ`),
[Jones, Theorem 1.1] (`hJordan`), [Milne, ANT v3.08, Proposition 3.53] (`hEis`), the Jacobi
discriminant formula [DLMF, (18.16.19)]
(`hdisc`) and [Dusart10, Theorem 5.2] (`hDusart`). -/
theorem unequalIntegralParametersFixedField (hH : HansonLcmBound)
     (hZ : JacobiSimpleRealZeros) (hJordan : JordanPrimeCycleTheorem)
     (hEis : EisensteinPrimeTotallyRamified)
    (hdisc : JacobiDiscriminantFormula) (hDusart : DusartThetaBound) :
    UnequalIntegralParametersFixedFieldStatement := by
  intro a b hab E _ _
  obtain ⟨R, hR⟩ := FixedFieldDisjointness.exists_bound_fixedField E
  obtain ⟨N, hN⟩ := exists_forall_eq_top_of_inertia_le hH hZ hJordan hEis hdisc hDusart hab R
  obtain ⟨N', hN'⟩ :=
    exists_forall_irreducible_galoisGroupIsSymmetric_jacobiP hH hZ hJordan hEis hdisc hDusart hab
  refine ⟨N + N', fun n hn => ?_⟩
  obtain ⟨h1, h2, h3, -⟩ := hR (jacobiP a b n) (hN n (by omega))
  exact ⟨h1, h2 (hN' n (by omega)).1, h3 (hN' n (by omega)).2⟩

end ArithmeticOfJacobiPolynomials
