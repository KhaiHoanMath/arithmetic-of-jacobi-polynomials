/-!
# The degree-two map of the derivative families (§6.5)

The manuscript, after Corollary 6.6, says: for the derivative families `f = Q_{m,r,δ}` with `m`
large, *"the substitution `t = x²` also gives the map
`{y² = F_{m,r,δ}(x)} → {y² = Q_{m,r,δ}(t)}`, `(x, y) ↦ (x², y)`. This map extends to a degree-two
morphism of the smooth projective models. It is the curve on the right whose defining polynomial
has group `S_m` and hence satisfies the preceding corollary. The polynomial `F_{m,r,δ}` has group
`W_m`; that group does not satisfy the symmetric-group hypothesis."*

Every assertion of this paragraph is proved here.

* The coordinate computation `F_{m,r,δ}(x) = Q_{m,r,δ}(x²)` is `expand_reducedGegenbauerSquare`
  (from `reducedGegenbauer_eq_expand`, `ArithmeticOfJacobiPolynomials.Remarks.DerivativeOrders`),
  and
  `aeval_reducedGegenbauer` / `sq_eq_aeval_reducedGegenbauer_iff` give pointwise preservation
  of the equations over every `ℚ`-algebra.
* The **extension to the smooth projective models** is the morphism of schemes
  `derivativeSquareMorphism m r δ hm : projectiveModel F ⟶ projectiveModel Q`
  (`ArithmeticOfJacobiPolynomials.Geometry.HyperellipticSquareMap`), constructed by gluing weighted
  `Proj`
  charts. `DerivativeDoubleCover` records that it is a morphism over `Spec ℚ`, is
  `Spec` of `t ↦ x²`, `y ↦ y` on the affine charts, and is surjective, proper and finite.
* **Degree two**: `DerivativeCoverDegreeTwo`, the rank of the extension of function fields induced
  by the morphism, from `finrank_functionField_reducedGegenbauerSquare` (the extension is
  generated by `x`, free of rank two over the coordinate ring of the target chart). Its premises
  (separability of `Q_{m,r,δ}` and `F_{m,r,δ}`) come from the irreducibility of both in
  Corollary 1.7 (`fixedDerivativesGaloisStatement`).
* **The target curve satisfies Corollary 6.6**: `ZarhinHypotheses Q_{m,r,δ}` (separable of degree
  `m ≥ 9`, group `S_m`) from Corollary 1.7, so
  `exists_arithmeticConclusions_reducedGegenbauerSquare`
  applies `JacobianSetting.arithmeticConclusions_of_zarhinHypotheses`.
* **The source curve does not**: `GaloisGroupIsWreath F_{m,r,δ}` (Corollary 1.7) and
  `not_galoisGroupIsSymmetric_of_isWreath`: for a separable even polynomial of degree `≥ 4`,
  the group `W_m` of permutations of the roots commuting with negation is a proper subgroup of the
  full symmetric group on the roots (`negCommPerm_ne_top`).

The models are the `Proj` models over `ℚ`; both are smooth and proper
(`Hyperelliptic.smooth_toSpecField`, `Hyperelliptic.isProper_toSpecField`), i.e. smooth
projective curves over `ℚ`. The degree is stated for the extension of function fields attached to
the model `projectiveModel (expand ℚ 2 Q)`, the same equation `y² = F` since
`expand ℚ 2 Q = F`; `derivativeSquareMorphism` is `squareMorphism` composed with the identification
`eqToHom` of the models of the equal polynomials.
-/

@[expose] public section

open Polynomial AlgebraicGeometry CategoryTheory

namespace ArithmeticOfJacobiPolynomials

universe u

attribute [local instance 2000] CommRingCat.commRing functionFieldCommSemiring
  functionFieldSemiring

/-! ### `W_m` is not the symmetric group -/

section NotSymmetric

variable {L : Type*} [Field L] [CharZero L]

/-- For a finite set `s` of at least four elements of a field of characteristic zero, closed under
negation, the permutations commuting with negation do not form the full symmetric group. -/
theorem negCommPerm_ne_top {s : Set L} [Finite s] (hneg : ∀ x ∈ s, -x ∈ s)
    (hcard : 4 ≤ Nat.card s) : negCommPerm s ≠ ⊤ := by
  classical
  intro htop
  have : Fintype s := Fintype.ofFinite s
  have hcard' : 4 ≤ Fintype.card s := by rwa [← Nat.card_eq_fintype_card]
  have : Nontrivial s := Fintype.one_lt_card_iff_nontrivial.mp (by omega)
  obtain ⟨a, b, hab⟩ := exists_pair_ne s
  obtain ⟨x, hx⟩ : ∃ x : s, (x : L) ≠ 0 := by
    by_cases ha : (a : L) = 0
    · exact ⟨b, fun hb => hab (Subtype.ext (ha.trans hb.symm))⟩
    · exact ⟨a, ha⟩
  let y : s := ⟨-(x : L), hneg x x.2⟩
  have hxy : x ≠ y := by
    intro h
    have h' : (x : L) = -(x : L) := congrArg Subtype.val h
    have h2 : (2 : L) * x = 0 := by linear_combination h'
    rcases mul_eq_zero.mp h2 with h3 | h3
    · exact two_ne_zero h3
    · exact hx h3
  obtain ⟨z, hzx, hzy⟩ : ∃ z : s, z ≠ x ∧ z ≠ y := by
    by_contra hcon
    push Not at hcon
    have hsub : (Finset.univ : Finset s) ⊆ {x, y} := by
      intro z _
      by_cases hzx : z = x
      · simp [hzx]
      · simp [hcon z hzx]
    have h1 := Finset.card_le_card hsub
    have h2 := Finset.card_le_two (a := x) (b := y)
    rw [Finset.card_univ] at h1
    omega
  have hσ : Equiv.swap y z ∈ negCommPerm s := by
    rw [htop]
    exact Subgroup.mem_top _
  have key := (mem_negCommPerm_iff _).mp hσ x y
  rw [Equiv.swap_apply_left, Equiv.swap_apply_of_ne_of_ne hxy hzx.symm] at key
  exact hzy (Subtype.ext (key.mp rfl))

end NotSymmetric

/-- **`W_m` is not `S_{2m}`.** If a separable polynomial `F` over `ℚ` of degree at least four is
even (`F(-x) = F(x)`) and its Galois group is the group of permutations of the roots commuting with
negation (`GaloisGroupIsWreath`), then its Galois group is not the full symmetric group on the
roots: `F` does not satisfy the symmetric-group hypothesis of Corollary 6.6. -/
theorem not_galoisGroupIsSymmetric_of_isWreath {F : ℚ[X]} (hsep : F.Separable)
    (hdeg : 4 ≤ F.natDegree) (heven : ∀ x : F.SplittingField, aeval (-x) F = aeval x F)
    (hW : GaloisGroupIsWreath F) : ¬ GaloisGroupIsSymmetric F := by
  intro hS
  have : CharZero F.SplittingField :=
    charZero_of_injective_algebraMap (algebraMap ℚ F.SplittingField).injective
  have hcard : Nat.card (F.rootSet F.SplittingField) = F.natDegree := by
    rw [Nat.card_eq_fintype_card, card_rootSet_eq_natDegree hsep (SplittingField.splits F)]
  have : Finite (F.rootSet F.SplittingField) := Nat.finite_of_card_ne_zero (by omega)
  have hW' : (galPerm F).range = negCommPerm (F.rootSet F.SplittingField) :=
    (galoisGroupIsWreath_iff F).mp hW
  have hneg : ∀ x ∈ F.rootSet F.SplittingField, -x ∈ F.rootSet F.SplittingField := by
    intro x hx
    rw [mem_rootSet] at hx ⊢
    exact ⟨hx.1, by rw [heven, hx.2]⟩
  have h4 : 4 ≤ Nat.card (F.rootSet F.SplittingField) := by omega
  refine negCommPerm_ne_top hneg h4 ?_
  rw [← hW']
  exact MonoidHom.range_eq_top.mpr ((galoisGroupIsSymmetric_iff F).mp hS).2

/-! ### The morphism of smooth projective models -/

open Hyperelliptic

/-- **The morphism `{y² = F_{m,r,δ}(x)} → {y² = Q_{m,r,δ}(t)}`, `(x, y) ↦ (x², y)`, of the
projective models** (`m ≥ 1`): a morphism over `Spec ℚ` which is `Spec` of `t ↦ x²`, `y ↦ y` on the
affine charts `y² = F(x)`, `y² = Q(t)` and is surjective, proper and finite. -/
structure DerivativeDoubleCover (m r δ : ℕ) (hm : 0 < m) : Prop where
  /-- It is a morphism of `ℚ`-schemes. -/
  over_base : derivativeSquareMorphism m r δ hm ≫ toSpecField (reducedGegenbauerSquare m r δ) =
    toSpecField (reducedGegenbauer m r δ)
  /-- On the affine charts it is `t ↦ x²`, `y ↦ y`. -/
  affine : affineChart (expand ℚ 2 (reducedGegenbauerSquare m r δ)) ≫
      squareMorphism _ (natDegree_reducedGegenbauerSquare_pos hm r δ) =
    Spec.map (CommRingCat.ofHom (squareMap (reducedGegenbauerSquare m r δ))) ≫
      affineChart (reducedGegenbauerSquare m r δ)
  surjective : Function.Surjective (derivativeSquareMorphism m r δ hm)
  proper : IsProper (derivativeSquareMorphism m r δ hm)
  finite : IsFinite (derivativeSquareMorphism m r δ hm)

/-- The degree-two morphism exists for every `m ≥ 1` (no separability needed). -/
theorem derivativeDoubleCover (m r δ : ℕ) (hm : 0 < m) : DerivativeDoubleCover m r δ hm where
  over_base := derivativeSquareMorphism_toSpecField m r δ hm
  affine := affineChart_comp_derivativeSquareMorphism m r δ hm
  surjective := (surjective_derivativeSquareMorphism m r δ hm).surj
  proper := isProper_derivativeSquareMorphism m r δ hm
  finite := isFinite_derivativeSquareMorphism m r δ hm

/-- **The degree of the morphism is two**: the extension of function fields
`K(y² = Q_{m,r,δ}(t)) → K(y² = F_{m,r,δ}(x))` induced by `(x, y) ↦ (x², y)` has rank two. The
statement needs the two models to be integral (separability of `Q` and of `F = Q(x²)`). -/
def DerivativeCoverDegreeTwo (m r δ : ℕ) (hm : 0 < m)
    (hQ : (reducedGegenbauerSquare m r δ).Separable)
    (hF : (reducedGegenbauer m r δ).Separable) : Prop :=
  haveI := irreducibleSpace_projectiveModel hQ (natDegree_reducedGegenbauerSquare_pos hm r δ)
  haveI := irreducibleSpace_projectiveModel (separable_expand_reducedGegenbauerSquare hF)
    (natDegree_expand_two_pos (natDegree_reducedGegenbauerSquare_pos hm r δ))
  letI := (squareFunctionFieldMap _ (natDegree_reducedGegenbauerSquare_pos hm r δ)).hom.toAlgebra
  Module.finrank (projectiveModel (reducedGegenbauerSquare m r δ)).functionField
    (projectiveModel (expand ℚ 2 (reducedGegenbauerSquare m r δ))).functionField = 2

theorem derivativeCoverDegreeTwo {m r δ : ℕ} (hm : 0 < m)
    (hQ : (reducedGegenbauerSquare m r δ).Separable)
    (hF : (reducedGegenbauer m r δ).Separable) : DerivativeCoverDegreeTwo m r δ hm hQ hF :=
  finrank_functionField_reducedGegenbauerSquare hm hQ hF

/-- **The paragraph after Corollary 6.6 (§6.5).** Fix `r`. For all large `m` and both
`δ ∈ {0, 1}`:

* the polynomials `Q_{m,r,δ}` and `F_{m,r,δ} = Q_{m,r,δ}(x²)` are separable and the projective
  models of `y² = Q(t)` and `y² = F(x)` are smooth and proper over `ℚ`;
* the map `(x, y) ↦ (x², y)` extends to a morphism of these models, which is surjective, finite and
  of degree two (`DerivativeDoubleCover`, `DerivativeCoverDegreeTwo`);
* `Q_{m,r,δ}` satisfies the hypotheses of Corollary 6.6: separable, degree `m ≥ 9`, group `S_m`;
* `F_{m,r,δ}` has group `W_m` and does not have the full symmetric group as Galois group.

Conditional on the literature results behind Corollary 1.7 only. -/
theorem exists_derivativeSquareCover (hQ : GegenbauerQuadraticTransformation)
    (hH : HansonLcmBound) (hZ : JacobiSimpleRealZeros)
    (hBMOR : BMORPrimeCountingBound) (h619 : BMORLargeModulusPrimeCounting)
    (hBT : BrunTitchmarshInequality) (hJones : JonesCycleTheorem) (r : ℕ) :
    ∃ N : ℕ, ∀ m ≥ max 9 N, ∀ δ : ℕ, δ ≤ 1 →
      ∃ (hm : 0 < m) (hQs : (reducedGegenbauerSquare m r δ).Separable)
        (hFs : (reducedGegenbauer m r δ).Separable),
        DerivativeDoubleCover m r δ hm ∧
        (Smooth (toSpecField (reducedGegenbauerSquare m r δ)) ∧
          IsProper (toSpecField (reducedGegenbauerSquare m r δ))) ∧
        (Smooth (toSpecField (reducedGegenbauer m r δ)) ∧
          IsProper (toSpecField (reducedGegenbauer m r δ))) ∧
        DerivativeCoverDegreeTwo m r δ hm hQs hFs ∧
        ZarhinHypotheses (reducedGegenbauerSquare m r δ) ∧
        GaloisGroupIsWreath (reducedGegenbauer m r δ) ∧
        ¬ GaloisGroupIsSymmetric (reducedGegenbauer m r δ) := by
  obtain ⟨N, hN⟩ := fixedDerivativesGaloisStatement hQ hH hZ hBMOR h619 hBT hJones r ℚ
  refine ⟨N, fun m hm δ hδ => ?_⟩
  have hmN : N ≤ m := le_trans (le_max_right _ _) hm
  have hm9 : 9 ≤ m := le_trans (le_max_left _ _) hm
  have hm0 : 0 < m := by omega
  obtain ⟨hFirr, hFW, hQirr, hQS, -, -⟩ := hN m hmN δ hδ
  have e : ∀ p : ℚ[X], p.map (algebraMap ℚ ℚ) = p := fun p => by
    rw [Algebra.algebraMap_self, Polynomial.map_id]
  rw [e] at hFirr hFW hQirr hQS
  have hdegQ := natDegree_reducedGegenbauerSquare m r δ
  have hdegF := natDegree_reducedGegenbauer_eq_two_mul m r δ
  refine ⟨hm0, hQirr.separable, hFirr.separable, derivativeDoubleCover m r δ hm0,
    ⟨smooth_toSpecField (by norm_num) hQirr.separable (by omega), isProper_toSpecField _⟩,
    ⟨smooth_toSpecField (by norm_num) hFirr.separable (by omega), isProper_toSpecField _⟩,
    derivativeCoverDegreeTwo hm0 hQirr.separable hFirr.separable,
    zarhinHypotheses_of_irreducible hQirr (by omega) hQS, hFW, ?_⟩
  refine not_galoisGroupIsSymmetric_of_isWreath hFirr.separable (by omega) (fun x => ?_) hFW
  rw [aeval_reducedGegenbauer, aeval_reducedGegenbauer, neg_sq]

/-- **The target curve satisfies Corollary 6.6** (§6.5). Fix `r`. For all large `m`,
`δ ∈ {0, 1}`, every Jacobian setting of `y² = Q_{m,r,δ}(t)` has the full conclusion of
Corollary 6.6, from the cited inputs of
`JacobianSetting.arithmeticConclusions_of_zarhinHypotheses`. -/
theorem exists_arithmeticConclusions_reducedGegenbauerSquare
    (hQ : GegenbauerQuadraticTransformation)
    (hH : HansonLcmBound) (hZ : JacobiSimpleRealZeros)
    (hBMOR : BMORPrimeCountingBound) (h619 : BMORLargeModulusPrimeCounting)
    (hBT : BrunTitchmarshInequality) (hJones : JonesCycleTheorem) (r : ℕ)
    (hZarhinTate : Zarhin.TateClassesDivisorProducts)
    (hEnd : Zarhin.GeometricEndomorphisms.{0})
    (hCanon : Jacobian.CanonicalPrincipalPolarizationExists.{0})
    (hUnif : AbelianBettiHodge.ComplexUniformization)
    (hRiem : AbelianBettiHodge.PolarizationRiemannForm)
    (hHM : Zarhin.HodgeAndMumfordTateGroups)
    (hExist : AbelianVariety.WeilPairingsExist.{0})
    (hAlt : AbelianVariety.PolarizedWeilAlternating.{0}) (hTate : Zarhin.TateLieAlgebra.{0})
    (hHC : JacobianArithmeticInputs.HodgeClassDivisorProducts)
    (hMT : JacobianArithmeticInputs.MumfordTateLieEquality) :
    ∃ N : ℕ, ∀ m ≥ max 9 N, ∀ δ : ℕ, δ ≤ 1 →
      ∀ S : JacobianSetting (reducedGegenbauerSquare m r δ),
        S.ArithmeticConclusions EtaleCycleClassInterface.CanonicalCycleClass := by
  obtain ⟨N, hN⟩ := exists_zarhinHypotheses_reducedGegenbauerSquare hQ hH hZ hBMOR h619 hBT
    hJones r
  exact ⟨N, fun m hm δ hδ S =>
    S.arithmeticConclusions_of_zarhinHypotheses hZarhinTate hEnd hCanon hUnif hRiem hHM hExist hAlt
      hTate hHC hMT (hN m hm δ hδ)⟩

end ArithmeticOfJacobiPolynomials
